+++ b/apps/api/houston/brain/api/views.py
@@ -0,0 +1,225 @@
+from drf_spectacular.utils import extend_schema
+from rest_framework.exceptions import NotFound, ValidationError
+from rest_framework.parsers import FormParser, MultiPartParser
+from rest_framework.permissions import IsAuthenticated
+from rest_framework.response import Response
+from rest_framework.views import APIView
+
+from houston.accounts.authentication import BearerAccessTokenAuthentication
+from houston.brain import action_services, goal_services, permissions, selectors, services
+from houston.brain.models import BrainSettings, BrainVersion, Mechanism
+
+from .serializers import (
+    ActionOptionsResponseSerializer,
+    AdminCommandSerializer,
+    BrainAdminResponseSerializer,
+    BrainResponseSerializer,
+    ContextResponseSerializer,
+    ContextSerializer,
+    ConversationResponseSerializer,
+    ConvertSuggestionSerializer,
+    CreateSerializer,
+    DecideObjectiveSerializer,
+    HistoryQuerySerializer,
+    QuestionSerializer,
+    ReportTextResponseSerializer,
+    SuggestionResponseSerializer,
+    WorkspaceResponseSerializer,
+)
+
+
+class Base(APIView):
+    authentication_classes = [BearerAccessTokenAuthentication]
+    permission_classes = [IsAuthenticated]
+
+
+class Context(Base):
+    @extend_schema(
+        responses=ContextResponseSerializer, tags=["brain"], operation_id="brain_context"
+    )
+    def get(self, request, establishment_id):
+        return Response({"data": selectors.establishment_context(request.user, establishment_id)})
+
+    @extend_schema(
+        request=ContextSerializer,
+        responses=ContextResponseSerializer,
+        tags=["brain"],
+        operation_id="brain_context_save",
+    )
+    def post(self, request, establishment_id):
+        permissions.member(request.user, establishment_id)
+        data = ContextSerializer(data=request.data)
+        data.is_valid(raise_exception=True)
+        return Response(
+            {
+                "data": services.set_establishment_context(
+                    request.user, establishment_id, data.validated_data["text"]
+                )
+            }
+        )
+
+
+class Conversations(Base):
+    parser_classes = [MultiPartParser, FormParser]
+
+    @extend_schema(
+        parameters=[HistoryQuerySerializer],
+        responses=WorkspaceResponseSerializer,
+        tags=["brain"],
+        operation_id="brain_list",
+    )
+    def get(self, request, establishment_id):
+        query = HistoryQuerySerializer(data=request.query_params)
+        query.is_valid(raise_exception=True)
+        return Response(
+            {
+                "data": selectors.conversations(
+                    request.user, establishment_id, query.validated_data.get("cursor")
+                )
+            }
+        )
+
+    @extend_schema(
+        request=CreateSerializer,
+        responses=ConversationResponseSerializer,
+        tags=["brain"],
+        operation_id="brain_upload",
+    )
+    def post(self, request, establishment_id):
+        b = CreateSerializer(data=request.data)
+        b.is_valid(raise_exception=True)
+        c = services.create(request.user, establishment_id, **b.validated_data)
+        return Response({"data": selectors.public(c)}, status=201)
+
+
+class Detail(Base):
+    @extend_schema(
+        responses=ConversationResponseSerializer, tags=["brain"], operation_id="brain_detail"
+    )
+    def get(self, request, establishment_id, conversation_id):
+        return Response(
+            {
+                "data": selectors.public(
+                    services.expire_stale(
+                        selectors.conversation(request.user, establishment_id, conversation_id)
+                    )
+                )
+            }
+        )
+
+    @extend_schema(
+        request=QuestionSerializer,
+        responses=ConversationResponseSerializer,
+        tags=["brain"],
+        operation_id="brain_question",
+    )
+    def post(self, request, establishment_id, conversation_id):
+        b = QuestionSerializer(data=request.data)
