+// @vitest-environment jsdom
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { brainApi } from './api'
+import { BrainContextSettings } from './context-settings'
+
+vi.mock('./api', () => ({
+  brainApi: { context: vi.fn(), saveContext: vi.fn() },
+}))
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+})
+function mount(site = 'site-a') {
+  return render(
+    <QueryClientProvider
+      client={
+        new QueryClient({ defaultOptions: { queries: { retry: false } } })
+      }
+    >
+      <BrainContextSettings key={site} establishmentId={site} />
+    </QueryClientProvider>,
+  )
+}
+
+describe('Contexte établissement de Brain', () => {
+  it('charge le contexte du site et ne confirme qu’après sauvegarde', async () => {
+    vi.mocked(brainApi.context).mockResolvedValue({
+      text: 'Profit',
+      updated_at: null,
+    })
+    vi.mocked(brainApi.saveContext).mockResolvedValue({
+      text: 'Flux',
+      updated_at: null,
+    })
+    mount()
+    const input = await screen.findByLabelText('Votre contexte')
+    expect((input as HTMLTextAreaElement).value).toBe('Profit')
+    fireEvent.change(input, { target: { value: 'Flux' } })
+    fireEvent.click(
+      screen.getByRole('button', { name: 'Enregistrer le contexte' }),
+    )
+    await screen.findByText(/Contexte enregistré/)
+    expect(brainApi.context).toHaveBeenCalledWith('site-a')
+    expect(brainApi.saveContext).toHaveBeenCalledWith('site-a', 'Flux')
+  })
+  it('conserve le brouillon en cas d’échec et permet de vider le contexte', async () => {
+    vi.mocked(brainApi.context).mockResolvedValue({
+      text: 'Profit',
+      updated_at: null,
+    })
+    vi.mocked(brainApi.saveContext).mockRejectedValue(
+      new Error('Sauvegarde impossible'),
+    )
+    mount()
+    fireEvent.change(await screen.findByLabelText('Votre contexte'), {
+      target: { value: '' },
+    })
+    fireEvent.click(
+      screen.getByRole('button', { name: 'Enregistrer le contexte' }),
+    )
+    await screen.findByRole('alert')
+    expect(brainApi.saveContext).toHaveBeenCalledWith('site-a', '')
+    expect(
+      (screen.getByLabelText('Votre contexte') as HTMLTextAreaElement).value,
+    ).toBe('')
+    expect(screen.queryByText(/Contexte enregistré/)).toBeNull()
+  })
+  it('ne propose pas de formulaire quand l’accès est refusé', async () => {
+    vi.mocked(brainApi.context).mockRejectedValue(
+      new Error('Accès réservé aux directeurs'),
+    )
+    mount()
+    await waitFor(() =>
+      expect(screen.getByRole('alert').textContent).toContain('Accès réservé'),
+    )
+    expect(
+      screen.queryByRole('button', { name: 'Enregistrer le contexte' }),
+    ).toBeNull()
+  })
+})
diff --git a/apps/web/src/features/brain/context-settings.tsx b/apps/web/src/features/brain/context-settings.tsx
new file mode 100644
index 0000000..238b2d2
--- /dev/null
+++ b/apps/web/src/features/brain/context-settings.tsx
@@ -0,0 +1,107 @@
+import { useState } from 'react'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { brainApi } from './api'
+import './brain.css'
+
+export function BrainContextSettings({
+  establishmentId,
+}: {
+  establishmentId: string
+}) {
+  const cache = useQueryClient()
+  const queryKey = ['brain-context', establishmentId]
+  const context = useQuery({
+    queryKey,
+    queryFn: () => brainApi.context(establishmentId),
+    retry: false,
+  })
+  const [draft, setDraft] = useState<string | undefined>()
+  const text = draft ?? context.data?.text ?? ''
+  const save = useMutation({
+    mutationFn: (value: string) => brainApi.saveContext(establishmentId, value),
+    onSuccess: (data) => {
+      cache.setQueryData(queryKey, data)
+      setDraft(undefined)
+    },
+  })
+
+  return (
+    <main className="brain brain-admin">
+      <span className="brain-eyebrow">PARAMÈTRES · SPORE BRAIN</span>
+      <h1>Vos priorités donnent le cap.</h1>
+      <p>
+        Décrivez ce que vous cherchez à améliorer et les contraintes de cet
+        établissement. Brain en tiendra compte pour analyser vos chiffres et
+        proposer des actions adaptées.
+      </p>
+      {context.isPending && <p role="status">Chargement du contexte…</p>}
+      {context.isError && <p role="alert">{context.error.message}</p>}
+      {context.data && !context.isError && (
+        <form
+          className="brain-upload"
+          onSubmit={(event) => {
+            event.preventDefault()
+            save.mutate(text)
+          }}
+        >
+          <h2>Contexte et priorités de l’établissement</h2>
+          <p>
+            Objectifs, clientèle, saisonnalité, contraintes budgétaires ou
+            humaines : précisez les éléments qui doivent guider les
+            recommandations.
+          </p>
+          <label htmlFor="brain-site-context">
+            Votre contexte
+            <textarea
+              id="brain-site-context"
+              rows={10}
+              maxLength={6000}
+              disabled={save.isPending}
+              value={text}
+              onChange={(event) => {
+                setDraft(event.target.value)
+                save.reset()
+              }}
+              placeholder="Exemple : notre priorité ce trimestre est d’augmenter la fréquentation en semaine. Nous souhaitons préserver la marge, sans recruter pour le moment. La qualité de service doit rester notre point fort."
+              aria-describedby="brain-context-help"
+            />
+          </label>
+          <small>
+            {text.length.toLocaleString('fr-FR')} / 6 000 caractères
+          </small>
+          <p id="brain-context-help">
+            Ce réglage est l’unique contexte de cet établissement. Il est partagé entre ses
+            directeurs et propriétaires. Il complète les données terrain, vos
+            reportings et le référentiel métier de Brain.
+          </p>
+          <p>
+            Toute modification s’applique à la prochaine analyse ou question, y
+            compris dans une conversation existante. Les réponses déjà produites
+            restent inchangées. Laissez ce champ vide pour ne pas définir de
+            priorité particulière.
+          </p>
+          {context.data.updated_at && (
+            <small>
+              Dernière modification :{' '}
+              {new Date(context.data.updated_at).toLocaleString('fr-FR')}
+            </small>
+          )}
+          <button
+            type="submit"
+            className="brain-primary"
+            disabled={save.isPending || text === context.data.text}
+          >
+            {save.isPending ? 'Enregistrement…' : 'Enregistrer le contexte'}
+          </button>
+          {save.isSuccess && (
+            <p role="status">
+              Contexte enregistré. Brain le prendra en compte dès votre
+              prochaine demande.
+            </p>
+          )}
+          {save.isError && <p role="alert">{save.error.message}</p>}
+        </form>
+      )}
+    </main>
+  )
+}
