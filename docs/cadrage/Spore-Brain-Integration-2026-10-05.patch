+from rest_framework.exceptions import PermissionDenied
+
+from houston.establishments.models import EstablishmentMembership
+from houston.establishments.permissions import is_valid_membership
+
+
+def member(user, site):
+    m = (
+        EstablishmentMembership.objects.select_related("user", "establishment__organization")
+        .filter(user=user, establishment_id=site)
+        .first()
+    )
+    if not is_valid_membership(m) or m.role not in ("owner", "director"):
+        raise PermissionDenied(
+            "Spore Brain est réservé aux propriétaires et directeurs actifs de cet établissement."
+        )
+    return m
+
+
+def administrator(user):
+    if not user.is_active or user.status != "active" or not user.has_perm("brain.manage_brain"):
+        raise PermissionDenied("Administration Brain réservée à l’administrateur de la plateforme.")
