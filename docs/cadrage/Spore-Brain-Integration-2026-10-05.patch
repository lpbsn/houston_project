+import json
+from copy import deepcopy
+from unittest.mock import patch
+
+import pytest
+from pydantic import ValidationError
+
+from houston.brain import errors, provider, selectors, services
+from houston.brain.models import ActionSuggestion
+from houston.brain.tests.test_audit import pending
+from houston.brain.tests.test_response_format import client_for, response, valid_payload
+
+
+def shared_payload():
+    data = valid_payload()
+    data["insights"].append({**deepcopy(data["insights"][0]), "kpi": "Satisfaction"})
+    return data
+
+
+def test_reported_invalid_link_then_shared_plan_recovers_without_losing_topics():
+    first = shared_payload()
+    first["insights"][1]["action_indexes"] = [4]
+    corrected = shared_payload()
+    client = client_for(response(first), response(corrected))
+    result = provider.validated_completion(client, [])
+    assert len(result.insights) == 2
+    assert len(result.actions) == 1
+    assert [insight.action_indexes for insight in result.insights] == [[0], [0]]
+    assert client.chat.completions.create.call_count == 2
+    messages = client.chat.completions.create.call_args.kwargs["messages"]
+    assert messages[-2]["role"] == "assistant"
+    assert json.loads(messages[-2]["content"]) == first
+    correction = messages[-1]["content"]
+    assert '"path": ["insights", 1, "action_indexes", 0]' in correction
+    assert "unknown_action_index" in correction
+    assert '"action_count": 1' in correction
+    assert "plusieurs KPI" in correction
+    assert first["insights"][0]["terrain"] not in correction
+
+
+def test_shared_plan_is_accepted_on_first_attempt():
+    client = client_for(response(shared_payload()))
+    provider.validated_completion(client, [])
+    assert client.chat.completions.create.call_count == 1
+    properties = client.chat.completions.create.call_args.kwargs["response_format"]["json_schema"][
+        "schema"
+    ]["properties"]
+    assert list(properties).index("actions") < list(properties).index("insights")
+
+
+@pytest.mark.parametrize("action_count", [0, 1, 3])
+def test_actual_number_of_actions_controls_allowed_indexes(action_count):
+    data = valid_payload()
+    data["actions"] = [deepcopy(data["actions"][0]) for _ in range(action_count)]
+    data["insights"][0]["action_indexes"] = [action_count]
+    with pytest.raises(ValidationError) as exc:
+        provider.Analysis.model_validate(data)
+    details = provider.validation_issues(exc.value, provider.Analysis.model_json_schema())
+    assert details[0] == {
+        "path": ["insights", 0, "action_indexes", 0],
+        "type": "unknown_action_index",
+        "limits": {"index": action_count, "action_count": action_count},
+    }
+    assert sum(item["type"] == "unlinked_action" for item in details) == action_count
+
+
+def test_duplicate_within_one_kpi_still_rejected_but_all_link_errors_are_located():
+    data = shared_payload()
+    data["insights"][0]["action_indexes"] = [0, 0]
+    data["insights"][1]["action_indexes"] = [3]
+    with pytest.raises(ValidationError) as exc:
+        provider.Analysis.model_validate(data)
+    details = provider.validation_issues(exc.value, provider.Analysis.model_json_schema())
+    assert [(item["type"], item["path"]) for item in details] == [
+        ("duplicate_action_index", ["insights", 0, "action_indexes", 1]),
+        ("unknown_action_index", ["insights", 1, "action_indexes", 0]),
+    ]
+
+
+def test_failed_repair_logs_precise_rules_without_customer_text(caplog):
+    data = valid_payload()
+    data["insights"][0]["action_indexes"] = [4]
+    data["answer"] = "PRIVATE-CUSTOMER-CONTENT"
+    client = client_for(response(data), response(data))
+    with pytest.raises(provider.BrainResponseError) as exc:
+        provider.validated_completion(client, [])
+    errors.failure_message(exc.value, message_id="test", stage="analysis")
+    assert "unknown_action_index" in caplog.text
+    assert "unlinked_action" in caplog.text
+    assert "PRIVATE-CUSTOMER-CONTENT" not in caplog.text
+    assert data["insights"][0]["terrain"] not in caplog.text
+
+
+def test_validation_details_include_lengths_but_never_arbitrary_fields_or_values():
+    data = valid_payload()
+    data["answer"] = "X" * 1401
+    data["PRIVATE-CUSTOMER-FIELD"] = "SECRET"
+    with pytest.raises(ValidationError) as exc:
+        provider.Analysis.model_validate(data)
+    details = provider.validation_issues(exc.value, provider.Analysis.model_json_schema())
+    assert details[0]["limits"] == {"max_length": 1400}
+    assert details[1]["path"] == ["unknown_field"]
+    text = json.dumps(details)
+    assert "PRIVATE" not in text and "SECRET" not in text and "XXX" not in text
+
+
+@pytest.mark.django_db
+def test_shared_kpis_persist_one_suggestion_and_preserve_both_links():
+    _, conversation, question = pending()
+    result = provider.Analysis.model_validate(shared_payload())
+    with (
+        patch("houston.brain.provider.analyze", return_value=result),
+        patch.object(services, "consent"),
+    ):
+        services.run(question.id)
+    conversation.refresh_from_db()
+    assert conversation.status == "ready"
+    assert ActionSuggestion.objects.filter(message__conversation=conversation).count() == 1
+    answer = selectors.public(conversation)["messages"][-1]
+    assert len(answer["action_suggestions"]) == 1
+    assert [item["action_indexes"] for item in answer["insights"]] == [[0], [0]]
