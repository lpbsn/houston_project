+    <section aria-label="Recherche des mécanismes">
+      <h2>Recherche des mécanismes</h2>
+      <p>
+        Après chaque nouvelle réponse, retrouvez ce qui a été examiné et les
+        propositions retenues pour votre validation.
+      </p>
+      {!reviews.length && (
+        <p>
+          Aucun compte rendu disponible. Les analyses antérieures à cette mise à
+          jour n’en conservaient pas.
+        </p>
+      )}
+      {reviews.map((review) => (
+        <details className="brain-upload" key={review.id}>
+          <summary>
+            {review.establishment} · {review.title} · {review.result.created}{' '}
+            proposition{review.result.created > 1 ? 's' : ''} retenue
+            {review.result.created > 1 ? 's' : ''}
+          </summary>
+          <p>{new Date(review.created_at).toLocaleString('fr-FR')}</p>
+          <p>{review.result.reason}</p>
+          <p>
+            {review.result.generated} candidate
+            {review.result.generated > 1 ? 's' : ''} examinée
+            {review.result.generated > 1 ? 's' : ''} ·{' '}
+            {review.result.discarded.length} écartée
+            {review.result.discarded.length > 1 ? 's' : ''}.
+          </p>
+          {review.result.discarded.map((item, index) => (
+            <p key={index}>
+              <strong>{item.mechanism}</strong> — {item.reason}
+            </p>
+          ))}
+        </details>
+      ))}
+    </section>
+  )
+}
