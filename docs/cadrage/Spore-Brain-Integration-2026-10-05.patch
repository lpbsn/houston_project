@@ -0,0 +1,25 @@
+from django.db import migrations
+from django.db.models import OuterRef, Subquery
+
+
+def backfill(apps, schema_editor):
+    Conversation = apps.get_model("brain", "Conversation")
+    Message = apps.get_model("brain", "Message")
+    alias = schema_editor.connection.alias
+    creator = Conversation.objects.using(alias).filter(pk=OuterRef("conversation_id"))
+    Message.objects.using(alias).filter(role="user", author__isnull=True).update(
+        author_id=Subquery(creator.values("membership_id")[:1])
+    )
+    latest = (
+        Message.objects.using(alias)
+        .filter(conversation_id=OuterRef("pk"), role="assistant", status="done")
+        .order_by("-created_at", "-id")
+    )
+    Conversation.objects.using(alias).filter(last_analyzed_at__isnull=True).update(
+        last_analyzed_at=Subquery(latest.values("created_at")[:1])
+    )
+
+
+class Migration(migrations.Migration):
+    dependencies = [("brain", "0004_actionsuggestion_conversation_last_analyzed_at_and_more")]
+    operations = [migrations.RunPython(backfill, migrations.RunPython.noop)]
