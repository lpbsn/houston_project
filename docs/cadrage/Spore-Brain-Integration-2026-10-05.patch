+from unittest.mock import MagicMock, patch
+
+import pytest
+from django.test import override_settings
+
+from houston.brain.conversation_context import MAX_HISTORY_CHARS, capture
+from houston.brain.errors import BrainResponseError
+from houston.brain.provider import analyze
+
+
+def conversation(rows):
+    c = MagicMock()
+    c.messages.filter.return_value.order_by.return_value.values.return_value = rows
+    c.snapshot = {}
+    c.version.prompt = "Analyze"
+    c.version.knowledge = {}
+    c.reports.all.return_value = []
+    return c
+
+
+def test_recent_question_is_preserved_and_coverage_disclosed():
+    c = conversation(
+        [
+            {"role": "user", "text": "Pourquoi ce résultat ?"},
+            {"role": "assistant", "text": "a" * (MAX_HISTORY_CHARS + 10)},
+            {"role": "user", "text": "Ancienne question"},
+        ]
+    )
+    rows, coverage = capture(c)
+    assert rows[-1]["text"] == "Pourquoi ce résultat ?"
+    assert sum(len(row["text"]) for row in rows) == MAX_HISTORY_CHARS
+    assert coverage["partial"] is True
+    c.messages.filter.return_value.order_by.return_value.values.assert_called_once_with(
+        "role", "text"
+    )
+
+
+@override_settings(OPENAI_API_KEY="test-placeholder", HOUSTON_BRAIN_INPUT_CHAR_BUDGET=100)
+def test_excessive_input_is_rejected_before_provider_call_without_truncating_reporting():
+    c = conversation([])
+    with patch("openai.OpenAI") as client:
+        with pytest.raises(BrainResponseError) as error:
+            analyze(c)
+    assert error.value.code == "input_too_large"
+    client.assert_not_called()
+
+
+@pytest.mark.django_db
+def test_current_running_question_is_included_but_failed_attempt_is_not():
+    from houston.brain.models import Message
+    from houston.brain.tests.test_shared import action_case
+
+    _, c, _, _ = action_case()
+    Message.objects.create(conversation=c, role="user", status="failed", text="Échec précédent")
+    Message.objects.create(conversation=c, role="user", status="running", text="Question actuelle")
+    rows, _ = capture(c)
+    assert rows[-1]["text"] == "Question actuelle"
+    assert all(row["text"] != "Échec précédent" for row in rows)
