+import { useState } from 'react'
+import type { BrainMessage } from './api'
+
+type Verification = NonNullable<
+  BrainMessage['insights'][number]['verification']
+>
+
+export function VerificationMessage({ value }: { value: Verification }) {
+  const [copied, setCopied] = useState(false)
+  const [failed, setFailed] = useState(false)
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(value.message)
+      setCopied(true)
+      setFailed(false)
+    } catch {
+      setFailed(true)
+    }
+  }
+  return (
+    <div className="brain-verification">
+      <b>Proposition d’action · vérifier auprès de {value.responsible_name}</b>
+      <p>{value.business_unit_name}</p>
+      <p className="brain-source-detail">{value.message}</p>
+      <button onClick={() => void copy()}>Copier le message</button>
+      {copied && (
+        <small role="status">
+          Message copié. Il reste à l’envoyer au destinataire.
+        </small>
+      )}
+      {failed && (
+        <small role="alert">Copiez directement le texte ci-dessus.</small>
+      )}
+    </div>
+  )
+}
