+from concurrent.futures import ThreadPoolExecutor
+from datetime import date
+from threading import Barrier
+from unittest.mock import patch
+
+import pytest
+from django.db import close_old_connections, connections
+from rest_framework.exceptions import ValidationError
+
+from houston.brain import permissions, selectors, services, tasks
+from houston.brain.api.serializers import AdminCommandSerializer
+from houston.brain.models import BrainSettings, Mechanism, Message
+from houston.brain.tests.test_presentation import analysis
+from houston.brain.tests.test_services import setup_case
+
+pytestmark = pytest.mark.django_db
+
+
+def pending():
+    owner, _, conversation = setup_case()
+    conversation.status = "queued"
+    conversation.save()
+    question = Message.objects.create(
+        conversation=conversation,
+        author=owner,
+        role="user",
+        status="queued",
+        text="Analyse",
+    )
+    return owner, conversation, question
+
+
+def test_removed_access_before_start_fails_without_calling_ai():
+    owner, conversation, question = pending()
+    owner.status = "invited"
+    owner.save()
+    with patch("houston.brain.provider.analyze") as provider:
+        tasks.analyze_message.run(str(question.id))
