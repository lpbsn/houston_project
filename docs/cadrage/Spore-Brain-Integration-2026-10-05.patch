@@ -0,0 +1,98 @@
+import copy
+import json
+import unittest
+
+from houston.brain.knowledge import SCHEMA, select, validate
+
+
+def reference():
+    return {
+        "schema_version": SCHEMA,
+        "mechanisms": [
+            {
+                "id": "M1",
+                "title": "Attente et ticket",
+                "principle": "Vérifier les horaires",
+                "status": "candidate",
+                "retrieval": {
+                    "kpis": ["ticket attente"],
+                    "situations": ["horaires personnel"],
+                    "sectors": ["restaurant"],
+                },
+                "reference_cases": [{"secret": "DONNEES_PRIVEES_INTERDITES"}],
+            }
+        ],
+        "reference_cases": [{"secret": "CORRIGE_INTERDIT"}],
+    }
+
+
+def issue(kpi="ticket moyen", terms=None):
+    return {
+        "activity": "Restaurant",
+        "kpi": kpi,
+        "change": "En baisse",
+        "search_terms": terms or ["horaires"],
+    }
+
+
+class RetrievalTests(unittest.TestCase):
+    def test_relevant_mechanism_selected_without_cases(self):
+        result, trace = select(reference(), [issue()])
+        self.assertEqual([m["id"] for m in result["mechanisms"]], ["M1"])
+        self.assertNotIn("INTERDIT", json.dumps(result))
+        self.assertEqual(trace["case_examples_sent"], 0)
+
+    def test_single_kpi_word_without_context_is_not_enough(self):
+        result, _ = select(reference(), [issue(terms=["promotion"])])
+        self.assertEqual(result["mechanisms"], [])
+
+    def test_unrelated_issue_is_preserved_in_coverage(self):
+        _, trace = select(reference(), [issue(), issue("électricité", ["compteur"])])
+        self.assertEqual(trace["uncovered_issue_indexes"], [1])
+
+    def test_retired_reference_is_excluded(self):
+        r = reference()
+        r["mechanisms"][0]["status"] = "retired"
+        self.assertEqual(select(r, [issue()])[0]["mechanisms"], [])
+
+    def test_candidate_keeps_its_status(self):
+        self.assertEqual(select(reference(), [issue()])[0]["mechanisms"][0]["status"], "candidate")
+
+    def test_legacy_is_not_sent_wholesale(self):
+        result, trace = select({"rules": ["CORRIGE_SECRET"]}, [issue()])
+        self.assertEqual(trace["status"], "legacy_not_selected")
+        self.assertNotIn("CORRIGE_SECRET", json.dumps(result))
+
+    def test_duplicate_ids_rejected(self):
+        r = reference()
+        r["mechanisms"].append(copy.deepcopy(r["mechanisms"][0]))
+        with self.assertRaises(ValueError):
+            validate(r)
+
+    def test_no_more_than_six_mechanisms(self):
+        r = reference()
+        r["mechanisms"] = [dict(r["mechanisms"][0], id=f"M{i}") for i in range(9)]
+        result, trace = select(r, [issue()])
+        self.assertEqual(len(result["mechanisms"]), 6)
+        self.assertEqual(trace["omitted_count"], 3)
+
+    def test_human_reviewed_learning_still_usable_without_evidence_leak(self):
+        r = reference()
+        r["mechanisms"] = []
+        r["learned_mechanisms"] = [
+            {
+                "mechanism": "ticket attente",
+                "conditions": "horaires personnel",
+                "limits": "à confirmer",
+                "evidence": ["secret-client"],
+            }
+        ]
+        result, _ = select(r, [issue()])
+        self.assertEqual(len(result["mechanisms"]), 1)
+        self.assertNotIn("secret-client", json.dumps(result))
+
+    def test_input_is_not_mutated_and_result_is_repeatable(self):
+        r = reference()
+        original = copy.deepcopy(r)
+        self.assertEqual(select(r, [issue()]), select(r, [issue()]))
+        self.assertEqual(r, original)
