+from datetime import timedelta
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from django.utils import timezone
+from rest_framework.exceptions import NotFound, PermissionDenied, ValidationError
+
+from houston.action_plans.models import ActionPlanExecution
+from houston.action_plans.services import (
+    mark_action_plan_execution_done,
+    validate_action_plan_execution,
+)
+from houston.brain import action_services, memory, selectors, services
+from houston.brain.models import ActionSuggestion, Conversation, Message, Report
+from houston.brain.provider import ActionDraft, Analysis, Insight, KpiObjective
+from houston.brain.tests.test_services import setup_case
+from houston.testing.factories import create_establishment, create_membership
+from houston.testing.taxonomy import create_business_unit
+
+pytestmark = pytest.mark.django_db
+
+
+def action_case():
+    owner, _, c = setup_case()
+    unit = create_business_unit(establishment=owner.establishment, key="restaurant")
+    answer = Message.objects.create(conversation=c, role="assistant", text="Proposition")
+    suggestion = ActionSuggestion.objects.create(
+        message=answer,
+        title="Conversion au bar",
+        description="Améliorer la conversion",
+        tasks=["Mesurer", "Tester"],
+        pilot_business_unit=unit,
+    )
+    payload = dict(
+        title=suggestion.title,
+        description=suggestion.description,
+        tasks=suggestion.tasks,
+        pilot_business_unit_id=unit.id,
+        responsible_membership_id=owner.id,
+        deadline=timezone.localdate() + timedelta(days=7),
+    )
+    return owner, c, suggestion, payload
+
+
+def test_shared_history_reports_authors_and_followups():
+    owner, _, c = setup_case()
+    director = create_membership(establishment=owner.establishment, role="director")
+    report = Report.objects.create(conversation=c, name="CA.csv", digest="x", text="CA: 1000")
+    assert str(c.id) in [
+        x["id"]
+        for x in selectors.conversations(director.user, owner.establishment_id)["conversations"]
+    ]
+    assert (
+        selectors.report(director.user, owner.establishment_id, c.id, report.id)["text"]
+        == "CA: 1000"
+    )
+    with patch.object(services, "consent"):
+        services.ask(director.user, owner.establishment_id, c.id, "Quelle suite ?", uuid4())
+    msg = c.messages.get(role="user")
+    assert msg.author_id == director.id
+    # The creator no longer being active must not break another director's pending request.
+    owner.status = "invited"
+    owner.save()
+    with patch(
+        "houston.brain.provider.analyze", return_value=Analysis(answer="Suite", proposals=[])
+    ):
+        with patch.object(services, "consent"):
+            services.run(msg.id)
+    c.refresh_from_db()
+    assert c.status == "ready"
+    public = selectors.public(selectors.conversation(director.user, owner.establishment_id, c.id))
+    assert public["messages"][0]["author_name"] == director.user.email
+    assert public["reports"][0]["id"] == report.id
+    assert "prompt" not in public and "knowledge" not in public
+
+
+def test_shared_access_is_denied_for_staff_managers_and_other_sites():
+    owner, _, c = setup_case()
+    foreign = create_establishment(name="Autre établissement")
+    outsider = create_membership(establishment=foreign, role="owner")
+    for role in ["staff", "manager"]:
+        person = create_membership(establishment=owner.establishment, role=role)
+        with pytest.raises(PermissionDenied):
+            selectors.conversations(person.user, owner.establishment_id)
+        with pytest.raises(PermissionDenied):
+            selectors.conversation(person.user, owner.establishment_id, c.id)
+    with pytest.raises(PermissionDenied):
+        memory.capture(outsider.user, owner.establishment_id)
+    with pytest.raises(NotFound):
+        selectors.conversation(outsider.user, foreign.id, c.id)
+
+
+def test_shared_questions_are_serialized_and_retry_is_idempotent():
+    owner, _, c = setup_case()
+    director = create_membership(establishment=owner.establishment, role="director")
+    request = uuid4()
+    with patch.object(services, "consent"):
+        services.ask(owner.user, owner.establishment_id, c.id, "Question", request)
+        services.ask(owner.user, owner.establishment_id, c.id, "Question", request)
+        with pytest.raises(ValidationError):
+            services.ask(director.user, owner.establishment_id, c.id, "Autre question", uuid4())
+    assert c.messages.count() == 1
+
+
+def test_convert_creates_canonical_execution_and_reuses_it_for_other_director():
+    owner, c, suggestion, payload = action_case()
+    director = create_membership(establishment=owner.establishment, role="director")
+    result = action_services.convert(owner.user, owner.establishment_id, suggestion.id, **payload)
+    execution = result.execution
+    assert execution.title == payload["title"]
+    assert execution.task_executions.count() == 2
+    assert execution.assignees.count() == 1
+    assert execution.requires_validation is True
+    again = action_services.convert(director.user, owner.establishment_id, suggestion.id, **payload)
+    assert again.execution_id == execution.id
+    assert ActionPlanExecution.objects.filter(establishment=owner.establishment).count() == 1
+    public = selectors.public(c)["messages"][0]["action_suggestions"][0]
+    assert public["execution"]["id"] == str(execution.id)
+    # A current state change is reflected by a fresh read, not cached in Brain's suggestion.
+    mark_action_plan_execution_done(execution_id=execution.id, actor_membership=owner)
+    validate_action_plan_execution(execution_id=execution.id, actor_membership=director, stars=4)
+    current = selectors.public(c)["messages"][0]["action_suggestions"][0]
+    assert current["execution"]["status"] == "done"
+    recalled = memory.capture(owner.user, owner.establishment_id)
+    assert recalled["actions"][0]["status"] == "done"
+    assert recalled["actions"][0]["task_counts"]["pending"] == 2
+
+
+def test_convert_rejects_foreign_poles_assignees_suggestions_and_rolls_back():
+    owner, _, suggestion, payload = action_case()
+    other_site = create_establishment(name="Autre")
+    other = create_membership(establishment=other_site, role="director")
+    foreign_unit = create_business_unit(establishment=other_site, key="restaurant")
+    with pytest.raises(ValidationError):
+        action_services.convert(
+            owner.user,
+            owner.establishment_id,
+            suggestion.id,
+            **{**payload, "pilot_business_unit_id": foreign_unit.id},
+        )
+    with pytest.raises(ValidationError):
+        action_services.convert(
+            owner.user,
+            owner.establishment_id,
+            suggestion.id,
+            **{**payload, "responsible_membership_id": other.id},
+        )
+    with pytest.raises(NotFound):
+        action_services.convert(other.user, other_site.id, suggestion.id, **payload)
+    with pytest.raises(ValidationError):
+        action_services.convert(
+            owner.user,
+            owner.establishment_id,
+            suggestion.id,
+            **{**payload, "deadline": timezone.localdate() - timedelta(days=1)},
+        )
+    assert not ActionPlanExecution.objects.filter(establishment=owner.establishment).exists()
+    suggestion.refresh_from_db()
+    assert suggestion.execution_id is None
+
+
+def test_options_include_implicit_owner_scope_and_exclude_foreign_people():
+    owner, _, suggestion, _ = action_case()
+    other = create_membership(establishment=create_establishment(name="Autre"), role="owner")
+    options = selectors.action_options(owner.user, owner.establishment_id)
+    assert str(owner.id) in [m["id"] for m in options["members"]]
+    assert str(other.id) not in [m["id"] for m in options["members"]]
+    row = next(m for m in options["members"] if m["id"] == str(owner.id))
+    assert str(suggestion.pilot_business_unit_id) in row["business_unit_ids"]
+
+
+def test_memory_is_bounded_shared_and_site_scoped_and_history_is_pageable():
+    owner, version, c = setup_case()
+    director = create_membership(establishment=owner.establishment, role="director")
+    for i in range(52):
+        Conversation.objects.create(
+            establishment=owner.establishment,
+            membership=owner,
+            version=version,
+            title=f"Analyse {i}",
+            start=c.start,
+            end=c.end,
+            summary=f"Hypothèse {i}",
+            last_analyzed_at=timezone.now(),
+        )
+    foreign_owner, _, foreign = setup_case()
+    foreign.last_analyzed_at = timezone.now()
+    foreign.summary = "Secret autre site"
+    foreign.save()
+    result = memory.capture(director.user, owner.establishment_id, exclude_conversation=c.id)
+    assert len(result["analyses"]) == 50
+    assert result["coverage"]["older_analyses_omitted"] is True
+    assert all(a["summary"] != "Secret autre site" for a in result["analyses"])
+    first = selectors.conversations(owner.user, owner.establishment_id)
+    second = selectors.conversations(director.user, owner.establishment_id, first["next_cursor"])
+    assert len(first["conversations"]) == 40
+    assert len(second["conversations"]) == 13
+    assert not {c["id"] for c in first["conversations"]} & {
+        c["id"] for c in second["conversations"]
+    }
+    assert second["next_cursor"] is None
+    with pytest.raises(ValidationError):
+        selectors.conversations(foreign_owner.user, foreign.establishment_id, first["next_cursor"])
+
+
+def test_run_saves_clickable_suggestions_summary_and_exact_memory():
+    owner, _, c = setup_case()
+    unit = create_business_unit(establishment=owner.establishment, key="restaurant")
+    with patch.object(services, "consent"):
+        services.ask(owner.user, owner.establishment_id, c.id, "Analyse", uuid4())
+    msg = c.messages.get()
+    result = Analysis(
+        answer="Voici une piste",
+        proposals=[],
+        memory_summary="Une piste à tester",
+        insights=[
+            Insight(
+                kpi="Conversion",
+                finding="À mesurer",
+                terrain="À vérifier",
+                confidence="à vérifier",
+                action_indexes=[0],
+            )
+        ],
+        actions=[
+            ActionDraft(
+                title="Proposition",
+                description="Objectif",
+                kpi_objective=KpiObjective(
+                    name="Conversion",
+                    baseline="À mesurer",
+                    target="Améliorer la conversion après mesure",
+                    horizon="Deux semaines",
+                    measurement="Achats / passages",
+                    review_date=timezone.localdate() + timedelta(days=14),
+                ),
+                tasks=["Tester"],
+                pilot_business_unit_id=unit.id,
+                suggested_due_days=7,
+            )
+        ],
+    )
+    with patch("houston.brain.provider.analyze", return_value=result) as analyze:
+        with patch.object(services, "consent"):
+            services.run(msg.id)
+    assert analyze.call_args.kwargs["memory"] == msg.memory_snapshot
+    c.refresh_from_db()
+    assert c.summary == "Une piste à tester" and c.last_analyzed_at
+    answer = c.messages.get(role="assistant")
+    assert answer.memory_snapshot == msg.memory_snapshot
+    assert answer.action_suggestions.get().pilot_business_unit_id == unit.id
+    assert not ActionPlanExecution.objects.filter(establishment=owner.establishment).exists()
+
+
+@pytest.mark.django_db(transaction=True)
+def test_simultaneous_conversion_creates_exactly_one_execution(monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+
+    from django.db import close_old_connections, connections
+
+    for target in [
+        "houston.action_plans.services._award_gam04_for_created_in_progress_execution",
+        "houston.action_plans.realtime.schedule_action_plan_execution_invalidation",
+        "houston.action_plans.realtime.schedule_action_plan_invalidation",
+        "houston.notifications.scheduling.schedule_action_plan_execution_created_notification",
+    ]:
+        monkeypatch.setattr(target, lambda **kwargs: None)
+    owner, _, suggestion, payload = action_case()
+    director = create_membership(establishment=owner.establishment, role="director")
+    barrier = Barrier(2)
+
+    def convert_as(user):
+        close_old_connections()
+        try:
+            barrier.wait(timeout=10)
+            return action_services.convert(
+                user, owner.establishment_id, suggestion.id, **payload
+            ).execution_id
+        finally:
+            connections.close_all()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        futures = [pool.submit(convert_as, user) for user in [owner.user, director.user]]
+        ids = [f.result(timeout=30) for f in futures]
+    assert ids[0] == ids[1]
+    assert ActionPlanExecution.objects.filter(establishment=owner.establishment).count() == 1
diff --git a/apps/api/houston/brain/tests/test_source_index.py b/apps/api/houston/brain/tests/test_source_index.py
new file mode 100644
index 0000000..7aec306
--- /dev/null
+++ b/apps/api/houston/brain/tests/test_source_index.py
@@ -0,0 +1,69 @@
+"""Evidence routing and payload regression; executable without Django."""
+
+import copy
+import json
+import unittest
+
+from houston.brain.references import catalog, provider_catalog
+
+
+class SourceIndexTests(unittest.TestCase):
+    def test_all_evidence_routes_survive_without_mutating_originals(self):
+        snapshot = {
+            "observations": [{"id": "o", "raw_text": "Texte intégral", "person_name": "Cédric"}],
+            "signals": [{"id": "s", "title": "Attente", "structured_summary": "Détail"}],
+            "actions": [{"id": "a", "title": "Réorganiser", "description": "Organisation"}],
+            "comments": [{"id": "c", "signal_id": "s", "body": "Commentaire"}],
+            "tasks": [{"id": "t", "action_plan_execution_id": "a", "task": "Mesurer"}],
+            "reviews": [{"id": "r", "action_plan_execution_id": "a", "comment": "À revoir"}],
+            "events": [{"id": "e", "signal_id": "s"}],
+        }
+        memory = {
+            "actions": [{"id": "a", "title": "Réorganiser", "status": "done"}],
+            "analyses": [{"id": "h", "title": "Bilan", "summary": "Hypothèse"}],
+            "report_history": [{"id": "report:p", "name": "Rapport", "text": "CA=100"}],
+        }
+        original = copy.deepcopy((snapshot, memory))
+        full = catalog(snapshot, memory)
+        index = provider_catalog(snapshot, memory)
+        self.assertEqual(set(full), set(index))
+        for key, row in full.items():
+            self.assertEqual(index[key], {k: row[k] for k in ("id", "kind", "target_id")})
+        self.assertEqual(index["c"]["target_id"], "s")
+        self.assertEqual(index["t"]["target_id"], "a")
+        self.assertEqual(index["report:p"]["target_id"], "p")
+        self.assertEqual(full["o"]["detail"], "Texte intégral")
+        self.assertEqual(full["a"]["detail"], "Organisation")
+        self.assertEqual(catalog(snapshot, memory), full)
+        self.assertEqual((snapshot, memory), original)
+
+    def test_repeated_parent_details_do_not_exhaust_input_budget(self):
+        snapshot = {
+            "signals": [{"id": "s", "title": "Sujet", "structured_summary": "x" * 2000}],
+            "events": [{"id": str(i), "signal_id": "s"} for i in range(160)],
+        }
+        originals = {"terrain": snapshot, "shared_memory": {}, "reports": [{"text": "CA=100"}]}
+        old = json.dumps(dict(originals, source_catalog=catalog(snapshot, {})))
+        new = json.dumps(
+            dict(originals, source_catalog=provider_catalog(snapshot, {})), separators=(",", ":")
+        )
+        self.assertGreater(len(old), 300000)
+        self.assertLess(len(new), 30000)
+        decoded = json.loads(new)
+        for key, value in originals.items():
+            self.assertEqual(decoded[key], value)
+
+    def test_empty_evidence(self):
+        self.assertEqual(provider_catalog({}, {}), {})
+
+
+class ReportingSourceTests(unittest.TestCase):
+    def test_current_reporting_can_be_cited_without_becoming_an_app_observation(self):
