+import { Fragment, useState, type ReactNode } from 'react'
+import { Tooltip } from 'radix-ui'
+import { ArrowUpRight, Target } from 'lucide-react'
+import type { BrainMessage, BrainSource } from './api'
+import { ActionSuggestionCard } from './action-suggestion'
+import { BrainDialog } from './brain-dialog'
+import { VerificationMessage } from './verification-message'
+
+const uuid = /([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/gi
+
+function SourceLink({
+  source,
+  onNavigate,
+  onOpen,
+}: {
+  source: BrainSource
+  onNavigate: (path: string) => void
+  onOpen: (id: string) => void
+}) {
+  const [preview, setPreview] = useState(false)
+  function activate() {
+    if (source.path) onNavigate(source.path)
+    else if (source.conversation_id) onOpen(source.conversation_id)
+    else setPreview(true)
+  }
+  return (
+    <>
+      <Tooltip.Root delayDuration={180}>
+        <Tooltip.Trigger asChild>
+          <button className="brain-source" onClick={activate}>
+            {source.title}
+            <ArrowUpRight size={13} />
+          </button>
+        </Tooltip.Trigger>
+        <Tooltip.Portal>
+          <Tooltip.Content
+            className="brain-source-preview"
+            sideOffset={7}
+            collisionPadding={12}
+          >
+            <b>{source.title}</b>
+            <p>{source.detail || 'Aucun détail supplémentaire.'}</p>
+            <small>
+              {source.available
+                ? 'Cliquer pour consulter'
+                : 'Source supprimée · extrait conservé à l’analyse'}
+            </small>
+            <Tooltip.Arrow />
+          </Tooltip.Content>
+        </Tooltip.Portal>
+      </Tooltip.Root>
+      <BrainDialog
+        open={preview}
+        onOpenChange={setPreview}
+        title={source.title}
+      >
+        <p className="brain-source-detail">
+          {source.detail || 'Aucun détail supplémentaire.'}
+        </p>
+        <small>
+          {source.available
+            ? 'Observation conservée pour cette analyse. Aucun sujet associé à ouvrir.'
+            : 'La source a été supprimée. Cet extrait est celui de l’analyse.'}
+        </small>
+      </BrainDialog>
+    </>
+  )
+}
+
+// Deliberately small text formatter: React escapes HTML; no arbitrary URLs or HTML from the model.
+export function ReadableText({
+  text,
+  sources,
+  onNavigate,
+  onOpen,
+}: {
+  text: string
+  sources: BrainSource[]
+  onNavigate: (path: string) => void
+  onOpen: (id: string) => void
+}) {
+  function inline(value: string): ReactNode {
+    return value.split(/(\*\*[^*]+\*\*)/g).map((part, index) => {
+      if (part.startsWith('**') && part.endsWith('**'))
+        return <strong key={index}>{inline(part.slice(2, -2))}</strong>
+      return (
+        <Fragment key={index}>
+          {part.split(uuid).map((piece, i) => {
+            if (i % 2 === 0) return piece
+            const source = sources.find(
+              (s) => s.id.toLowerCase() === piece.toLowerCase(),
+            )
+            return source ? (
+              <SourceLink
+                key={i}
+                source={source}
+                onNavigate={onNavigate}
+                onOpen={onOpen}
+              />
+            ) : (
+              <span key={i}>Source non disponible</span>
+            )
+          })}
+        </Fragment>
+      )
+    })
+  }
+  const blocks: ReactNode[] = []
+  let bullets: string[] = []
+  function flush() {
+    if (bullets.length) {
+      blocks.push(
+        <ul key={blocks.length}>
+          {bullets.map((line, i) => (
+            <li key={i}>{inline(line)}</li>
+          ))}
+        </ul>,
+      )
+      bullets = []
+    }
+  }
+  for (const line of text.split('\n').filter((s) => s.trim())) {
+    if (/^\s*(?:[-*•]|\d+[.)])\s+/.test(line))
+      bullets.push(line.replace(/^\s*(?:[-*•]|\d+[.)])\s+/, ''))
+    else {
+      flush()
+      blocks.push(
+        <p key={blocks.length}>{inline(line.replace(/^#{1,6}\s+/, ''))}</p>,
+      )
+    }
+  }
+  flush()
+  return <div className="brain-readable">{blocks}</div>
+}
+
+export function AnalysisAnswer({
+  message,
+  site,
+  onNavigate,
+  onOpen,
+}: {
+  message: BrainMessage
+  site: string
+  onNavigate: (path: string) => void
+  onOpen: (id: string) => void
+}) {
+  const sources = message.sources ?? []
+  const used = new Set(
+    (message.insights ?? []).flatMap((item) => item.action_indexes),
+  )
+  return (
+    <Tooltip.Provider>
+      <ReadableText
+        text={message.text}
+        sources={sources}
+        onNavigate={onNavigate}
+        onOpen={onOpen}
+      />
+      {(message.insights ?? []).map((item, index) => (
+        <section
+          className="brain-insight"
+          key={index}
+          aria-label={`KPI : ${item.kpi}`}
+        >
+          <header>
+            <h3>
+              <Target size={18} />
+              {item.kpi}
+            </h3>
+            <span className="brain-confidence">
+              {item.confidence === 'observé'
+                ? 'Lien observé'
+                : item.confidence === 'hypothèse'
+                  ? 'Lien à confirmer'
+                  : 'À vérifier'}
+            </span>
+          </header>
+          <ul className="brain-insight-facts">
+            <li>
+              <b>Constat</b>
+              <ReadableText
+                text={item.finding}
+                sources={sources}
+                onNavigate={onNavigate}
+                onOpen={onOpen}
+              />
+            </li>
+            <li>
+              <b>Éclairage terrain</b>
+              <ReadableText
+                text={item.terrain}
+                sources={sources}
+                onNavigate={onNavigate}
+                onOpen={onOpen}
+              />
+            </li>
+          </ul>
+          <div className="brain-sources">
+            {item.sources
+              .map((id) => sources.find((s) => s.id === id))
+              .filter((s): s is BrainSource => !!s)
+              .map((s) => (
+                <SourceLink
+                  key={s.id}
+                  source={s}
+                  onNavigate={onNavigate}
+                  onOpen={onOpen}
+                />
+              ))}
+          </div>
+          {item.missing_sources && (
+            <small>
+              Une source citée n’a pas pu être retrouvée ; ce lien reste à
+              vérifier.
+            </small>
+          )}
+          {item.verification && (
+            <VerificationMessage value={item.verification} />
+          )}
+          {item.action_indexes.map((i) => {
+            const suggestion = message.action_suggestions[i]
+            return suggestion ? (
+              <ActionSuggestionCard
+                key={suggestion.id}
+                suggestion={suggestion}
+                site={site}
+                onNavigate={onNavigate}
+              />
+            ) : null
+          })}
+        </section>
+      ))}
+      {message.action_suggestions.map(
+        (s, i) =>
+          !used.has(i) && (
+            <ActionSuggestionCard
+              key={s.id}
+              suggestion={s}
+              site={site}
+              onNavigate={onNavigate}
+            />
+          ),
+      )}
+      {(message.goal_reviews ?? []).map((review) => (
+        <section
+          className="brain-insight"
+          key={review.id}
+          aria-label={`Bilan : ${review.objective.name}`}
+        >
+          <header>
+            <h3>Bilan de l’objectif · {review.objective.name}</h3>
+            <strong>
+              {
+                {
+                  achieved: 'Atteint selon Brain',
+                  not_achieved: 'Non atteint selon Brain',
+                  unmeasurable: 'Non mesurable',
+                }[review.outcome]
+              }
+            </strong>
+          </header>
+          <p>
+            Objectif validé : {review.objective.target} · bilan au{' '}
+            {review.objective.review_date
+              ? new Date(
+                  review.objective.review_date + 'T12:00:00',
+                ).toLocaleDateString('fr-FR')
+              : 'jour prévu'}
+          </p>
+          {review.measurement && (
+            <p>
+              <b>Mesure relevée :</b> {review.measurement}
+            </p>
+          )}
+          <ReadableText
+            text={review.explanation}
+            sources={sources}
+            onNavigate={onNavigate}
+            onOpen={onOpen}
+          />
+          <div className="brain-sources">
+            {review.sources
+              .map((id) => sources.find((source) => source.id === id))
+              .filter((source): source is BrainSource => !!source)
+              .map((source) => (
+                <SourceLink
+                  key={source.id}
+                  source={source}
+                  onNavigate={onNavigate}
+                  onOpen={onOpen}
+                />
+              ))}
+          </div>
+        </section>
+      ))}
+    </Tooltip.Provider>
+  )
+}
