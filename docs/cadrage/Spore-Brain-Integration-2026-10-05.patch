@@ -0,0 +1,292 @@
+from datetime import timedelta
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from django.db import transaction
+from django.utils import timezone
+from rest_framework.exceptions import NotFound, PermissionDenied, ValidationError
+from rest_framework.test import APIClient
+
+from houston.brain import (
+    action_services,
+    evidence_services,
+    goal_selectors,
+    goal_services,
+    report_history,
+    selectors,
+    services,
+)
+from houston.brain.models import Conversation, GoalReview, Message, Report
+from houston.brain.provider import GoalReviewDraft, VerificationDraft
+from houston.brain.tests.test_presentation import analysis, objective
+from houston.brain.tests.test_shared import action_case
+from houston.testing.factories import create_membership
+
+pytestmark = pytest.mark.django_db
+
+
+def goal_case():
+    owner, c, suggestion, payload = action_case()
+    suggestion.kpi_objective = objective().model_dump(mode="json")
+    suggestion.save()
+    return owner, c, suggestion, payload
+
+
+def validate(owner, goal, **kwargs):
+    return goal_services.decide(
+        owner.user,
+        owner.establishment_id,
+        goal.id,
+        decision="validate",
+        expected_revision=goal.objective_revision,
+        **kwargs,
+    )
+
+
+def due(owner, goal):
+    today = timezone.localdate()
+    goal.kpi_objective = {**goal.kpi_objective, "review_date": today.isoformat()}
+    goal.objective_status = "validated"
+    goal.save()
+    return goal_selectors.due_goals(
+        owner.user, owner.establishment_id, today - timedelta(days=7), today, today
+    )
+
+
+def test_goal_decisions_are_independent_shared_and_revision_checked():
+    owner, c, goal, _ = goal_case()
+    validated = validate(owner, goal)
+    assert validated.objective_status == "validated"
+    assert validated.execution_id is None
+    assert validated.objective_revision == 2
+    assert validate(owner, goal).objective_revision == 2  # Safe double click.
+    director = create_membership(establishment=owner.establishment, role="director")
+    with pytest.raises(ValidationError):
+        goal_services.decide(
+            director.user,
+            owner.establishment_id,
+            goal.id,
+            decision="reject",
+            expected_revision=1,
+        )
+    changed = {**goal.kpi_objective, "target": "Moins de 18 minutes"}
+    result = validate(owner, validated, objective=changed)
+    assert result.objective_revision == 3
+    assert result.kpi_objective["target"] == changed["target"]
+    result = goal_services.decide(
+        director.user,
+        owner.establishment_id,
+        goal.id,
+        decision="reject",
+        expected_revision=3,
+    )
+    assert result.objective_status == "rejected"
+    assert result.objective_decided_by == director
+    public = selectors.public(c)["messages"][0]["action_suggestions"][0]
+    assert public["objective_decision"]["status"] == "rejected"
+
+
+def test_objective_endpoint_and_access_boundaries():
+    owner, _, goal, _ = goal_case()
+    url = f"/api/v1/establishments/{owner.establishment_id}/brain/suggestions/{goal.id}/objective/"
+    client = APIClient()
+    client.force_authenticate(owner.user)
+    response = client.post(url, {"decision": "validate", "expected_revision": 1}, format="json")
+    assert response.status_code == 200, response.data
+    assert response.data["data"]["objective_decision"]["status"] == "validated"
+    for role in ("staff", "manager"):
+        actor = create_membership(establishment=owner.establishment, role=role)
+        with pytest.raises(PermissionDenied):
+            goal_services.decide(
+                actor.user,
+                owner.establishment_id,
+                goal.id,
+                decision="reject",
+                expected_revision=2,
+            )
+    foreign, _, _, _ = goal_case()
+    with pytest.raises(NotFound):
+        goal_services.decide(
+            foreign.user,
+            foreign.establishment_id,
+            goal.id,
+            decision="reject",
+            expected_revision=2,
+        )
+
+
+def test_only_validated_goals_in_report_period_and_not_future_are_due():
+    owner, _, goal, _ = goal_case()
+    today = timezone.localdate()
+    goal.kpi_objective["review_date"] = today.isoformat()
+    goal.save()
+    args = (owner.user, owner.establishment_id, today, today, today)
+    assert goal_selectors.due_goals(*args) == []
+    goal = validate(owner, goal)
+    assert len(goal_selectors.due_goals(*args)) == 1
+    assert (
+        goal_selectors.due_goals(
+            owner.user,
+            owner.establishment_id,
+            today - timedelta(days=5),
+            today - timedelta(days=1),
+            today,
+        )
+        == []
+    )
+    assert goal_selectors.due_goals(*args[:-1], today - timedelta(days=1)) == []
+    goal_services.decide(
+        owner.user, owner.establishment_id, goal.id, decision="reject", expected_revision=2
+    )
+    assert goal_selectors.due_goals(*args) == []
+
+
+def test_rejected_goal_does_not_get_reactivated_when_creating_plan():
+    owner, _, goal, payload = goal_case()
+    goal_services.decide(
+        owner.user, owner.establishment_id, goal.id, decision="reject", expected_revision=1
+    )
+    converted = action_services.convert(owner.user, owner.establishment_id, goal.id, **payload)
+    assert converted.execution_id
+    assert converted.objective_status == "rejected"
+    assert "Objectif d’impact KPI" not in converted.execution.description
+
+
+def review_case():
+    owner, c, goal, _ = goal_case()
+    expected = due(owner, goal)
+    report = Report.objects.create(
+        conversation=c, name="bilan.csv", digest="bilan", text="Attente moyenne : 12 minutes"
+    )
+    draft = GoalReviewDraft(
+        goal_id=goal.id,
+        outcome="achieved",
+        measurement="12 minutes",
+        explanation="La baisse est mesurée.",
+        report_id=report.id,
+        report_excerpt="Attente moyenne : 12 minutes",
+        sources=[],
+    )
+    answer = Message.objects.create(conversation=c, role="assistant", text="Bilan")
+    return owner, c, goal, expected, report, draft, answer
+
+
+def test_review_requires_original_report_proof_and_is_not_repeated_when_conclusive():
+    owner, c, goal, expected, report, draft, answer = review_case()
+    with transaction.atomic():
+        goal_services.save_reviews(answer, expected, [draft], {})
+    review = GoalReview.objects.get(message=answer)
+    assert review.outcome == "achieved" and review.report == report
+    assert review.objective_snapshot == goal.kpi_objective
+    assert "ne permettent pas d’expliquer" in review.explanation
+    assert due(owner, goal) == []
+    public = selectors.public(c)["messages"][-1]["goal_reviews"][0]
+    assert public["measurement"] == "12 minutes"
+    assert "report_excerpt" not in public
+
+
+@pytest.mark.parametrize("failure", ["missing", "invented_quote", "foreign_report", "revision"])
+def test_unproven_or_changed_goals_are_not_marked_achieved(failure):
+    owner, _, goal, expected, _, draft, answer = review_case()
+    drafts = [draft]
+    if failure == "missing":
+        drafts = []
+    elif failure == "invented_quote":
+        draft.report_excerpt = "Attente moyenne : 8 minutes"
+        draft.measurement = "8 minutes"
+    elif failure == "foreign_report":
+        _, foreign_c, _, _ = goal_case()
+        foreign = Report.objects.create(
+            conversation=foreign_c, name="secret.csv", digest="secret", text=draft.report_excerpt
+        )
+        draft.report_id = foreign.id
+    else:
+        goal.objective_revision += 1
+        goal.save()
+    with transaction.atomic():
+        goal_services.save_reviews(answer, expected, drafts, {})
+    review = GoalReview.objects.get(message=answer)
+    assert review.outcome == "unmeasurable"
+    assert review.report_id is None
+    assert len(due(owner, goal)) == 1
+
+
+def test_run_saves_server_selected_goal_review_and_ignores_invented_goal():
+    owner, c, goal, expected, _, draft, _ = review_case()
+    with patch.object(services, "consent"):
+        services.ask(owner.user, owner.establishment_id, c.id, "Bilan", uuid4())
+    question = c.messages.get(role="user")
+    question.memory_snapshot["due_kpi_reviews"] = expected
+    question.save()
+    result = analysis("unknown")
+    result.goal_reviews = [draft, draft.model_copy(update={"goal_id": uuid4()})]
+    with (
+        patch("houston.brain.provider.analyze", return_value=result),
+        patch.object(services, "consent"),
+    ):
+        services.run(question.id)
+    c.refresh_from_db()
+    assert c.status == "ready"
+    assert GoalReview.objects.filter(suggestion=goal).count() == 1
+
+
+def test_historical_numbers_are_original_scoped_and_bounded():
+    owner, current, _, _ = goal_case()
+    original = []
+    for days in range(1, 7):
+        c = Conversation.objects.create(
+            establishment=owner.establishment,
+            membership=owner,
+            version=current.version,
+            title="Ancien bilan",
+            start=current.start - timedelta(days=days),
+            end=current.start - timedelta(days=days),
+            summary="Synthèse IA : 9999",
+        )
+        original.append(
+            Report.objects.create(
+                conversation=c, name="bilan.csv", digest=str(days), text=f"CA réel : {100 + days}"
+            )
+        )
+    _, foreign_c, _, _ = goal_case()
+    foreign_c.start = current.start - timedelta(days=1)
+    foreign_c.end = foreign_c.start
+    foreign_c.save()
+    Report.objects.create(conversation=foreign_c, name="secret.csv", digest="x", text="secret")
+    rows, partial = report_history.capture(
+        owner.user, owner.establishment_id, current.start, current.end, current.id
+    )
+    assert len(rows) == 4 and partial
+    assert rows[0]["text"] == original[0].text
+    assert all("9999" not in row["text"] and "secret" not in row["text"] for row in rows)
+
+
+@pytest.mark.parametrize("kind", ["action", "signal", "observation"])
+def test_all_terrain_evidence_kinds_can_explain_a_kpi(kind):
+    insight = analysis("proof").insights[0]
+    result = evidence_services.prepare_insight(insight, {"proof": {"kind": kind}}, {})
+    assert result["terrain"] == insight.terrain
+    assert result["verification"] is None
+
+
+def test_verification_recipient_is_real_pole_manager_or_explicitly_unknown():
+    unit, manager, stranger = str(uuid4()), str(uuid4()), str(uuid4())
+    insight = analysis("unknown").insights[0]
+    insight.verification = VerificationDraft(
+        business_unit_id=unit,
+        responsible_membership_id=stranger,
+        message="Quelle cause au déjeuner ?",
+    )
+    snapshot = {
+        "business_units": [{"id": unit, "specific_name": "Restaurant"}],
+        "team": [{"id": manager, "name": "Cédric", "role": "manager", "business_unit_ids": [unit]}],
+    }
+    result = evidence_services.prepare_insight(insight, {}, snapshot)
+    assert result["verification"]["responsible_membership_id"] == manager
+    assert result["verification"]["responsible_name"] == "Cédric"
+    snapshot["team"][0]["role"] = "staff"
+    result = evidence_services.prepare_insight(insight, {}, snapshot)
+    assert result["verification"]["responsible_membership_id"] is None
+    assert result["verification"]["responsible_name"] == "Responsable à désigner"
+    assert insight.finding in result["verification"]["message"]
