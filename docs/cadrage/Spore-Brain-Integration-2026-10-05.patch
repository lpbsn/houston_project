+import json
+from datetime import timedelta
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from django.test import override_settings
+from django.utils import timezone
+from pydantic import ValidationError
+
+from houston.brain import provider, services
+from houston.brain.batch_analysis import BatchNotes
+from houston.brain.models import Message
+from houston.brain.report_review import ReportReview
+from houston.brain.runtime_limits import (
+    LARGE_ANALYSIS_SECONDS,
+    TASK_HARD_SECONDS,
+    TASK_SOFT_SECONDS,
+)
+from houston.brain.tests.test_batch_analysis import reader
+from houston.brain.tests.test_context_budget import conversation
+from houston.brain.tests.test_services import setup_case
+
+
+def payload(topic_ids):
+    return {
+        "answer": "Analyse",
+        "proposals": [],
+        "insights": [
+            {
+                "kpi": "Restaurant CA",
+                "finding": "80 vs 100",
+                "terrain": "À vérifier",
+                "confidence": "à vérifier",
+            }
+        ],
+        "reporting_coverage": [{"topic_id": key, "insight_indexes": [0]} for key in topic_ids],
+    }
+
+
+def test_final_schema_refuses_missing_topics_and_unknown_insights():
+    data = payload(["report_topic_0"])
+    provider.BatchAnalysis.model_validate(data, context={"required_topics": ["report_topic_0"]})
+    with pytest.raises(ValidationError):
+        provider.BatchAnalysis.model_validate(
+            data, context={"required_topics": ["report_topic_0", "report_topic_1"]}
+        )
+    data["reporting_coverage"][0]["insight_indexes"] = [8]
+    with pytest.raises(ValidationError):
+        provider.BatchAnalysis.model_validate(data, context={"required_topics": ["report_topic_0"]})
+
+
+@override_settings(OPENAI_API_KEY="test-placeholder")
+def test_large_analysis_reads_batches_before_review_and_synthesis():
+    c = conversation([])
+    c.reports.all.return_value = [
+        SimpleNamespace(id="1", name="Reporting", text="Restaurant CA 80 budget 100")
+    ]
+    c.snapshot = {
+        "observations": [
+            {"id": str(i), "raw_text": "Attente au déjeuner " * 200} for i in range(180)
+        ]
+    }
+    calls = []
+    progress = MagicMock()
+
+    def complete(client, messages, *, response_model, **kwargs):
+        calls.append(response_model)
+        assert sum(len(m["content"]) for m in messages) < 300000
+        if response_model is BatchNotes:
+            return reader(messages, response_model)
+        if response_model is ReportReview:
+            return ReportReview(issues=[], coverage_complete=True)
+        data = json.loads(messages[-1]["content"])
+        assert data["batch_coverage"]["all_parts_read"]
+        return provider.BatchAnalysis.model_validate(
+            payload(data["reporting_topic_ids"]), context=kwargs["validation_context"]
+        )
+
+    with (
+        patch("openai.OpenAI"),
+        patch.object(provider, "validated_completion", side_effect=complete),
+    ):
+        result = provider.analyze(c, progress=progress)
+    assert calls[-2:] == [ReportReview, provider.BatchAnalysis]
+    assert calls.count(BatchNotes) > 2
+    assert progress.call_count == len(calls)
+    assert result._retrieval_trace["volume"]["all_parts_read"]
+    assert result._retrieval_trace["volume"]["records_read"] == 181
+
+
+@pytest.mark.django_db
+def test_batch_progress_renews_stale_lease_and_result_is_saved_normally():
+    owner, _, c = setup_case()
+    question = Message.objects.create(
+        conversation=c, author=owner, role="user", status="queued", text="Analyse"
+    )
+
+    def analyze(*args, **kwargs):
+        Message.objects.filter(pk=question.pk).update(
+            updated_at=timezone.now() - timedelta(minutes=6)
+        )
+        kwargs["progress"]()
+        assert services.expire_stale(c).status == "running"
+        return provider.Analysis(answer="Analyse complète", proposals=[])
+
+    with patch.object(provider, "analyze", side_effect=analyze), patch.object(services, "consent"):
+        services.run(question.id)
+    c.refresh_from_db()
+    assert c.status == "ready"
+    assert c.messages.filter(role="assistant").count() == 1
+
+
+@pytest.mark.django_db
+def test_cancelled_batch_cannot_continue_or_save_an_answer():
+    owner, _, c = setup_case()
+    question = Message.objects.create(
+        conversation=c, author=owner, role="user", status="queued", text="Analyse"
+    )
+
+    def analyze(*args, **kwargs):
+        Message.objects.filter(pk=question.pk).update(status="failed")
+        kwargs["progress"]()
+        raise AssertionError("Cancelled job continued")
+
+    with patch.object(provider, "analyze", side_effect=analyze), patch.object(services, "consent"):
+        services.run(question.id)
+    assert not c.messages.filter(role="assistant").exists()
+
+
+def test_worker_deadline_leaves_time_for_failure_handling():
+    assert LARGE_ANALYSIS_SECONDS < TASK_SOFT_SECONDS < TASK_HARD_SECONDS
+
+
+@pytest.mark.django_db
+def test_waiting_job_does_not_expire_while_long_analysis_occupies_worker():
+    from houston.brain.runtime_limits import QUEUE_WAIT_SECONDS
+
+    owner, _, c = setup_case()
+    c.status = "queued"
+    c.save()
+    question = Message.objects.create(
+        conversation=c, author=owner, role="user", status="queued", text="Analyse"
+    )
+    Message.objects.filter(pk=question.pk).update(updated_at=timezone.now() - timedelta(minutes=10))
+    assert services.expire_stale(c).status == "queued"
+    Message.objects.filter(pk=question.pk).update(
+        updated_at=timezone.now() - timedelta(seconds=QUEUE_WAIT_SECONDS + 10)
+    )
+    assert services.expire_stale(c).status == "failed"
