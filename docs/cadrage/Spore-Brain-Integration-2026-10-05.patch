+import { useRef, useState } from 'react'
+import {
+  useInfiniteQuery,
+  useMutation,
+  useQuery,
+  useQueryClient,
+} from '@tanstack/react-query'
+import {
+  Brain,
+  Plus,
+  Send,
+  FileUp,
+  Settings2,
+  ArrowLeft,
+  Users,
+  History,
+} from 'lucide-react'
+import { brainApi, type BrainMessage, type Proposal } from './api'
+import { AnalysisAnswer } from './analysis-answer'
+import { LearningReviews } from './learning-reviews'
+import './brain.css'
+
+function errorText(error: unknown) {
+  return error instanceof Error ? error.message : 'Une erreur est survenue.'
+}
+const stateLabels: Record<string, string> = {
+  queued: 'Analyse en attente',
+  running: 'Brain analyse vos données…',
+  ready: 'Analyse disponible',
+  failed: 'Analyse à relancer',
+}
+const formatDate = (date: string) => new Date(date).toLocaleDateString('fr-FR')
+
+function MemoryTrace({
+  message,
+  onOpen,
+}: {
+  message: BrainMessage
+  onOpen: (id: string) => void
+}) {
+  const memory = message.memory
+  if (!memory.captured_at && !message.context) return null
+  const partial = Object.entries(memory.coverage).some(
+    ([key, value]) =>
+      (key.includes('omitted') || key.startsWith('more_')) && value === true,
+  )
+  return (
+    <details className="brain-trace">
+      <summary>
+        <History size={15} /> Contexte appliqué à cette réponse
+      </summary>
+      {message.context && (
+        <div>
+          <b>Priorités de l’établissement</b>
+          <p>{message.context}</p>
+        </div>
+      )}
+      {memory.captured_at && (
+        <p>
+          Données de suivi relues le{' '}
+          {new Date(memory.captured_at).toLocaleString('fr-FR')} ·{' '}
+          {String(memory.coverage.actions_included ?? 0)} plans d’action pris en
+          compte.
+        </p>
+      )}
+      <b>
+        {memory.analyses.length} analyse{memory.analyses.length > 1 ? 's' : ''}{' '}
+        précédente{memory.analyses.length > 1 ? 's' : ''} prise
+        {memory.analyses.length > 1 ? 's' : ''} en compte
+      </b>
+      <ul>
+        {memory.analyses.map((a) => (
+          <li key={a.id}>
+            <button onClick={() => onOpen(a.id)}>
+              {a.title} · {formatDate(a.start)} → {formatDate(a.end)}
+            </button>
+          </li>
+        ))}
+      </ul>
+      {partial && (
+        <p>
+          Cette réponse utilise une partie de l’historique : les 50 analyses les
+          plus récentes, jusqu’à 200 actions ouvertes, 50 actions terminées ou
+          annulées et 100 propositions récentes.
+        </p>
+      )}
+    </details>
+  )
+}
+
+function SharedReport({
+  site,
+  conversation,
+  report,
+}: {
+  site: string
+  conversation: string
+  report: { id: string; name: string }
+}) {
+  const [open, setOpen] = useState(false)
+  const data = useQuery({
+    queryKey: ['brain', site, 'report', report.id],
+    queryFn: () => brainApi.report(site, conversation, report.id),
+    enabled: open,
+    retry: false,
+  })
+  return (
+    <details
+      className="brain-report"
+      onToggle={(e) => setOpen(e.currentTarget.open)}
+    >
+      <summary>{report.name}</summary>
+      <small>
+        Texte extrait utilisé par Brain. Le fichier original n’est pas conservé.
+      </small>
+      {data.isPending && open && <p>Chargement…</p>}
+      {data.isError && <p role="alert">{errorText(data.error)}</p>}
+      {data.data && !data.isError && <pre>{data.data.text}</pre>}
+    </details>
+  )
+}
+
+export function BrainPage({
+  establishmentId,
+  onNavigate,
+}: {
+  establishmentId: string
+  onNavigate: (path: string) => void
+}) {
+  const [id, setId] = useState<string | null>(() => {
+    try {
+      return sessionStorage.getItem(`brain-current-${establishmentId}`)
+    } catch {
+      return null
+    }
+  })
+  function selectConversation(next: string | null) {
+    setId(next)
+    try {
+      if (next) sessionStorage.setItem(`brain-current-${establishmentId}`, next)
+      else sessionStorage.removeItem(`brain-current-${establishmentId}`)
+    } catch {
+      /* Storage may be disabled. */
+    }
+  }
+  const [admin, setAdmin] = useState(false)
+  const [historyOpen, setHistoryOpen] = useState(false)
+  const [question, setQuestion] = useState('')
+  const [uploadError, setUploadError] = useState('')
+  const pendingQuestion = useRef<{
+    targetId: string
+    text: string
+    requestId: string
+  } | null>(null)
+  const cache = useQueryClient()
+  const list = useInfiniteQuery({
+    queryKey: ['brain', establishmentId, 'list'],
+    initialPageParam: undefined as string | undefined,
+    queryFn: ({ pageParam }) => brainApi.list(establishmentId, pageParam),
+    getNextPageParam: (page) => page.next_cursor ?? undefined,
+    refetchInterval: 10000,
+    retry: false,
+  })
+  const detail = useQuery({
+    queryKey: ['brain', establishmentId, 'conversation', id],
+    queryFn: () => brainApi.detail(establishmentId, id!),
+    enabled: !!id && !list.isError,
+    refetchInterval: (q) =>
+      ['queued', 'running'].includes(q.state.data?.status ?? '') ? 2500 : 10000,
+    retry: false,
+  })
+  const create = useMutation({
+    mutationFn: (data: FormData) => brainApi.create(establishmentId, data),
+    onSuccess: (c) => {
+      selectConversation(c.id)
+      cache.setQueryData(['brain', establishmentId, 'conversation', c.id], c)
+      void cache.invalidateQueries({
+        queryKey: ['brain', establishmentId, 'list'],
+      })
+    },
+  })
+  const ask = useMutation({
+    mutationFn: ({ targetId, text }: { targetId: string; text: string }) => {
+      if (
+        !pendingQuestion.current ||
+        pendingQuestion.current.targetId !== targetId ||
+        pendingQuestion.current.text !== text
+      )
+        pendingQuestion.current = {
+          targetId,
+          text,
+          requestId: crypto.randomUUID(),
+        }
+      return brainApi.ask(
+        establishmentId,
+        targetId,
+        pendingQuestion.current.text,
+        pendingQuestion.current.requestId,
+      )
+    },
+    onSuccess: (c, sent) => {
+      if (question === sent.text) setQuestion('')
+      pendingQuestion.current = null
+      cache.setQueryData(['brain', establishmentId, 'conversation', c.id], c)
+      void cache.invalidateQueries({
+        queryKey: ['brain', establishmentId, 'list'],
+      })
+    },
+  })
+  const busy = ['queued', 'running'].includes(detail.data?.status ?? '')
+  function openConversation(next: string | null) {
+    if (ask.isPending || create.isPending) return
+    selectConversation(next)
+    setHistoryOpen(false)
+    setQuestion('')
+    setUploadError('')
+    pendingQuestion.current = null
+    ask.reset()
+    create.reset()
+  }
+  function submitReporting(form: HTMLFormElement) {
+    if (create.isPending) return
+    setUploadError('')
+    const data = new FormData(form)
+    const files = data
+      .getAll('files')
+      .filter((value): value is File => value instanceof File)
+    if (!files.length || files.length > 5) {
+      setUploadError('Choisissez entre 1 et 5 reportings.')
+      return
+    }
+    if (files.some((file) => file.size === 0 || file.size > 8 * 1024 * 1024)) {
+      setUploadError('Chaque fichier doit peser entre 1 octet et 8 Mo.')
+      return
+    }
+    if (files.some((file) => !/\.(xlsx|csv|pdf)$/i.test(file.name))) {
+      setUploadError('Formats acceptés : XLSX, CSV ou PDF texte.')
+      return
+    }
+    if (String(data.get('end')) < String(data.get('start'))) {
+      setUploadError(
+        'La fin de période doit être postérieure ou égale au début.',
+      )
+      return
+    }
+    create.mutate(data)
+  }
+  if (list.isError)
+    return (
+      <main className="brain brain-admin">
+        <h1>Spore Brain</h1>
+        <p role="alert">{errorText(list.error)}</p>
+        <button onClick={() => void list.refetch()}>Réessayer</button>
+      </main>
+    )
+  if (admin && list.data?.pages[0].can_admin)
+    return <BrainAdmin onClose={() => setAdmin(false)} />
+  return (
+    <div className="brain">
+      <aside className={`brain-rail ${historyOpen ? 'history-open' : ''}`}>
+        <div className="brain-brand">
+          <Brain size={26} />
+          <strong>Spore Brain</strong>
+        </div>
+        <p className="brain-shared">
+          <Users size={16} /> Partagé avec la direction
+        </p>
+        <button
+          className="brain-primary"
+          disabled={ask.isPending || create.isPending}
+          onClick={() => openConversation(null)}
+        >
+          <Plus size={17} /> Nouvelle analyse
+        </button>
+        <button
+          className="brain-mobile-history"
+          aria-expanded={historyOpen}
+          onClick={() => setHistoryOpen(!historyOpen)}
+        >
+          Historique partagé
+        </button>
+        <nav aria-label="Analyses partagées">
+          {list.data?.pages
+            .flatMap((p) => p.conversations)
+            .map((c) => (
+              <button
+                key={c.id}
+                disabled={ask.isPending || create.isPending}
+                className={id === c.id ? 'selected' : ''}
+                onClick={() => openConversation(c.id)}
+              >
+                <strong>{c.title}</strong>
+                <small>
+                  {formatDate(c.start)} → {formatDate(c.end)}
+                </small>
+                <small>Initiée par {c.author_name}</small>
+              </button>
+            ))}
+        </nav>
