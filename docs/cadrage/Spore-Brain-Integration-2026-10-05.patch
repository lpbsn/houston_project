+
+class ActionSuggestionSerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    title = serializers.CharField()
+    description = serializers.CharField()
+    tasks = serializers.ListField(child=serializers.CharField())
+    pilot_business_unit_id = serializers.UUIDField(allow_null=True)
+    suggested_due_days = serializers.IntegerField(allow_null=True)
+    kpi_objective = KpiObjectiveSerializer(allow_null=True)
+    converted_at = serializers.DateTimeField(allow_null=True)
+    execution = LinkedExecutionSerializer(allow_null=True)
+    objective_decision = ObjectiveDecisionSerializer(required=False, allow_null=True)
+
+
+class SuggestionResponseSerializer(serializers.Serializer):
+    data = ActionSuggestionSerializer()
+
+
+class ConvertSuggestionSerializer(serializers.Serializer):
+    title = serializers.CharField(max_length=200)
+    description = serializers.CharField(max_length=2000, allow_blank=True)
+    tasks = serializers.ListField(
