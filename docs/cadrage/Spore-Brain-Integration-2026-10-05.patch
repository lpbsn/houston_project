@@ -0,0 +1,120 @@
+"""Safe diagnostics: no prompt, customer data, provider body or credentials in logs."""
+
+import json
+import logging
+import traceback
+
+from openai import APIConnectionError, APIStatusError, APITimeoutError
+from pydantic import ValidationError as SchemaError
+from rest_framework.exceptions import PermissionDenied, ValidationError
+
+logger = logging.getLogger(__name__)
+
+
+class BrainResponseError(RuntimeError):
+    def __init__(self, code, *, issues=None):
+        self.code = code
+        self.issues = issues or []
+        super().__init__(code)
+
+
+MESSAGES = {
+    "batch_input_limit": (
+        "Le volume ou le contexte dépasse encore la capacité de lecture par lots. "
+        "Aucune analyse partielle n’a été enregistrée."
+    ),
+    "batch_work_limit": (
