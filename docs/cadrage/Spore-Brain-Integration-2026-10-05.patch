@@ -0,0 +1,21 @@
+from django.conf import settings
+from django.contrib.auth import get_user_model
+from django.contrib.auth.models import Permission
+from django.core.management.base import BaseCommand, CommandError
+
+
+class Command(BaseCommand):
+    help = "Grant only Brain configuration/review permission to a local test account."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--email", required=True)
+
+    def handle(self, *args, **options):
+        if not settings.DEBUG:
+            raise CommandError("Commande réservée au test local.")
+        user = get_user_model().objects.filter(email=options["email"]).first()
+        if not user:
+            raise CommandError("Compte introuvable.")
+        p = Permission.objects.get(content_type__app_label="brain", codename="manage_brain")
+        user.user_permissions.add(p)
+        self.stdout.write("Droit administrateur Brain accordé. Aucun rôle superuser ajouté.")
diff --git a/apps/api/houston/brain/memory.py b/apps/api/houston/brain/memory.py
new file mode 100644
index 0000000..7052c8c
--- /dev/null
+++ b/apps/api/houston/brain/memory.py
@@ -0,0 +1,144 @@
+"""Bounded, establishment-scoped evidence for continuity between analyses."""
+
+from zoneinfo import ZoneInfo
+
+from django.db.models import Count, OuterRef, Subquery
+from django.utils import timezone
+
+from houston.action_plans.models import ActionPlanExecution, ActionPlanExecutionTask
+
+from . import goal_selectors, report_history
+from .models import ActionSuggestion, Conversation, Message
+from .permissions import member
+from .selectors import action_people
+
+RECENT_ANALYSES = 50
+ACTIVE_ACTIONS = 200
+RECENT_FINISHED_ACTIONS = 50
+
+
+def capture(user, site, *, exclude_conversation=None, start=None, end=None):
+    actor = member(user, site)
+    # Brain is restricted to the site's active owners/directors, who can read all its executions.
+    latest_answer = Message.objects.filter(
+        conversation_id=OuterRef("pk"), role="assistant", status="done"
+    ).order_by("-created_at", "-id")
+    conversations = (
+        Conversation.objects.filter(establishment_id=site, last_analyzed_at__isnull=False)
+        .exclude(pk=exclude_conversation)
+        .order_by("-last_analyzed_at", "-id")
+    )
+    rows = list(
+        conversations.annotate(last_answer=Subquery(latest_answer.values("text")[:1])).values(
+            "id", "title", "start", "end", "summary", "last_answer", "last_analyzed_at"
+        )[: RECENT_ANALYSES + 1]
+    )
+    analyses = []
+    for row in rows[:RECENT_ANALYSES]:
+        analyses.append(
+            {
+                "id": str(row["id"]),
+                "title": row["title"],
+                "start": str(row["start"]),
+                "end": str(row["end"]),
+                "analyzed_at": row["last_analyzed_at"].isoformat(),
+                "summary": row["summary"] or (row["last_answer"] or "")[:2000],
+                "is_excerpt": not bool(row["summary"]),
+            }
+        )
+
+    executions = ActionPlanExecution.objects.filter(establishment_id=site).select_related(
+        "brain_suggestion"
+    )
+    active = list(
+        executions.exclude(status__in=["done", "canceled"]).order_by("end_at", "id")[
+            : ACTIVE_ACTIONS + 1
+        ]
+    )
+    finished = list(
+        executions.filter(status__in=["done", "canceled"]).order_by("-updated_at", "-id")[
+            : RECENT_FINISHED_ACTIONS + 1
+        ]
+    )
+    selected = active[:ACTIVE_ACTIONS] + finished[:RECENT_FINISHED_ACTIONS]
+    people = action_people(site, [e.id for e in selected])
+    tasks = {}
+    for task in (
+        ActionPlanExecutionTask.objects.filter(
+            action_plan_execution_id__in=[e.id for e in selected],
+            action_plan_execution__establishment_id=site,
+        )
+        .order_by()
+        .values("action_plan_execution_id", "status")
+        .annotate(total=Count("id"))
+    ):
+        tasks.setdefault(str(task["action_plan_execution_id"]), {})[task["status"]] = task["total"]
+    actions = [
+        {
+            "id": str(e.id),
+            "title": e.title,
+            "status": e.status,
+            "deadline": e.end_at.isoformat() if e.end_at else None,
+            "updated_at": e.updated_at.isoformat(),
+            "task_counts": tasks.get(str(e.id), {}),
+            "responsible_people": people.get(str(e.id), []),
+            "kpi_objective": getattr(getattr(e, "brain_suggestion", None), "kpi_objective", {}),
+            "objective_status": getattr(
+                getattr(e, "brain_suggestion", None), "objective_status", "not_proposed"
+            ),
+        }
+        for e in selected
+    ]
+    suggestions = list(
+        ActionSuggestion.objects.filter(message__conversation__establishment_id=site)
+        .order_by("-created_at", "-id")
+        .values("id", "title", "converted_at", "execution_id", "kpi_objective", "objective_status")[
+            :101
+        ]
+    )
+    today = (
+        timezone.now().astimezone(ZoneInfo(actor.establishment.timezone or "Europe/Paris")).date()
+    )
+    # App callers always supply the reporting period. Without it, no due review is inferred.
+    due_reviews = goal_selectors.due_goals(user, site, start, end, today) if start and end else []
+    historical_reports, partial_reports = (
+        report_history.capture(user, site, start, end, exclude_conversation)
+        if start and end
+        else ([], False)
+    )
+    return {
+        "captured_at": timezone.now().isoformat(),
+        "analyses": analyses,
+        "actions": actions,
+        "suggestions": [
+            {
+                "id": str(s["id"]),
+                "title": s["title"],
+                "converted": bool(s["converted_at"]),
+                "execution_id": str(s["execution_id"]) if s["execution_id"] else None,
+                "kpi_objective": s["kpi_objective"],
+                "objective_status": s["objective_status"],
+            }
+            for s in suggestions[:100]
+        ],
+        "due_kpi_reviews": due_reviews,
+        "goal_review_history": goal_selectors.review_history(user, site),
+        "report_history": historical_reports,
+        "coverage": {
+            "analyses_included": len(analyses),
+            "older_analyses_omitted": len(rows) > RECENT_ANALYSES,
+            "actions_included": len(actions),
+            "more_active_actions": len(active) > ACTIVE_ACTIONS,
+            "older_finished_actions_omitted": len(finished) > RECENT_FINISHED_ACTIONS,
+            "older_suggestions_omitted": len(suggestions) > 100,
+            "more_due_kpi_reviews": False,
+            "historical_report_count": len(historical_reports),
+            "more_historical_reports": partial_reports,
+        },
+        "note": (
+            "Synthèses d'analyses antérieures : hypothèses à réévaluer, pas nouvelles preuves. "
+            "Les états des actions sont relus dans Spore à chaque demande. Une action terminée "
+            "ne prouve pas un effet sur les résultats. Les réponses citent les analyses utilisées. "
+            "Si la couverture est partielle ou une synthèse est un extrait, le signaler."
+        ),
+    }
