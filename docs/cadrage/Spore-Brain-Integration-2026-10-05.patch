+from datetime import timedelta
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from django.utils import timezone
+from pydantic import ValidationError as SchemaError
+from rest_framework.exceptions import PermissionDenied, ValidationError
+
+from houston.brain import action_services, memory, selectors, services
+from houston.brain.models import Mechanism, Message, Report
+from houston.brain.provider import Analysis, KpiObjective, Proposal
+from houston.brain.tests.test_audit import pending
+from houston.brain.tests.test_presentation import analysis, objective
+from houston.brain.tests.test_shared import action_case
+from houston.observations.models import Observation
+from houston.testing.factories import build_membership, create_membership
+
+pytestmark = pytest.mark.django_db
+
+
+def test_more_than_five_topics_are_saved_and_missing_observations_are_explicit():
+    _, c, question = pending()
+    result = analysis("unknown")
+    original = result.insights[0]
+    result.insights = [
+        original.model_copy(
+            update={"kpi": f"Indicateur {i}", "action_indexes": [0] if i == 0 else []}
+        )
+        for i in range(8)
+    ]
+    result = Analysis.model_validate(result.model_dump(mode="json"))
+    with (
+        patch("houston.brain.provider.analyze", return_value=result),
+        patch.object(services, "consent"),
+    ):
+        services.run(question.id)
+    c.refresh_from_db()
+    assert c.status == "ready"
+    answer = selectors.public(c)["messages"][-1]
+    assert len(answer["insights"]) == 8
+    assert all(
+        "données terrain disponibles ne permettent pas" in item["terrain"]
+        for item in answer["insights"]
+    )
+    assert all(item["confidence"] == "à vérifier" for item in answer["insights"])
+
+
+def test_snapshot_contains_real_authors_local_dates_and_plan_people():
+    owner, c, suggestion, payload = action_case()
+    owner.user.first_name = "Cédric"
+    owner.user.last_name = "Martin"
+    owner.user.save()
+    plan = action_services.convert(owner.user, owner.establishment_id, suggestion.id, **payload)
+    observed = timezone.now()
+    observation = Observation.objects.create(
+        establishment=owner.establishment,
+        submitted_by_membership=owner,
+        client_submission_id=uuid4(),
+        submitted_at=observed,
+        raw_text="Les commandes attendent entre la cuisine et le comptoir.",
+    )
+    snapshot = selectors.snapshot(
+        owner, observed.date() - timedelta(days=1), observed.date() + timedelta(days=1)
+    )
+    row = next(item for item in snapshot["observations"] if item["id"] == str(observation.id))
+    assert row["person_name"] == "Cédric Martin"
+    assert row["observed_at_local"]
+    action = next(item for item in snapshot["actions"] if item["id"] == str(plan.execution_id))
+    assert action["responsible_people"][0]["name"] == "Cédric Martin"
+    assert snapshot["team"][0]["name"] == "Cédric Martin"
+
+
+def test_known_observation_preserves_its_explanation():
+    _, c, question = pending()
+    observation_id = str(uuid4())
+    c.snapshot = {
+        "observations": [{"id": observation_id, "raw_text": "Une file attend.", "title": "Attente"}]
+    }
+    c.save()
+    result = analysis(observation_id)
+    with (
+        patch("houston.brain.provider.analyze", return_value=result),
+        patch.object(services, "consent"),
+    ):
+        services.run(question.id)
+    answer = selectors.public(c)["messages"][-1]
+    assert answer["insights"][0]["terrain"] == result.insights[0].terrain
+    assert answer["insights"][0]["confidence"] == "hypothèse"
+
+
+def test_new_plans_require_a_date_but_legacy_objectives_remain_readable():
+    data = analysis("observation").model_dump(mode="json")
+    del data["actions"][0]["kpi_objective"]["review_date"]
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(data)
+    assert KpiObjective.model_validate(data["actions"][0]["kpi_objective"]).review_date is None
+    data["actions"][0]["kpi_objective"]["review_date"] = "2020-01-01"
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(data, context={"analysis_date": timezone.localdate()})
+
+
+def test_confirmed_kpi_date_survives_conversion_and_returns_when_due():
+    owner, _, suggestion, payload = action_case()
+    proposed = objective().model_dump(mode="json")
+    suggestion.kpi_objective = proposed
+    suggestion.save()
+    confirmed = {**proposed, "review_date": (timezone.localdate() + timedelta(days=28)).isoformat()}
+    converted = action_services.convert(
+        owner.user, owner.establishment_id, suggestion.id, **payload, kpi_objective=confirmed
+    )
+    assert confirmed["review_date"] in converted.execution.description
+    assert converted.kpi_objective["review_date"] == confirmed["review_date"]
+    before = memory.capture(
+        owner.user,
+        owner.establishment_id,
+        start=timezone.localdate(),
+        end=timezone.localdate() + timedelta(days=35),
+    )
+    assert before["due_kpi_reviews"] == []
+    assert before["actions"][0]["kpi_objective"]["review_date"] == confirmed["review_date"]
+    report_start = timezone.localdate()
+    with patch(
+        "houston.brain.memory.timezone.now", return_value=timezone.now() + timedelta(days=29)
+    ):
+        after = memory.capture(
+            owner.user,
+            owner.establishment_id,
+            start=report_start,
+            end=report_start + timedelta(days=35),
+        )
+    assert after["due_kpi_reviews"][0]["objective"] == confirmed
+    foreign = build_membership(role="owner")
+    assert memory.capture(foreign.user, foreign.establishment_id)["due_kpi_reviews"] == []
+
+
+def test_a_dated_proposal_cannot_lose_its_review_date_on_confirmation():
+    owner, _, suggestion, payload = action_case()
+    suggestion.kpi_objective = objective().model_dump(mode="json")
+    suggestion.save()
+    with pytest.raises(ValidationError):
+        action_services.convert(
+            owner.user,
+            owner.establishment_id,
+            suggestion.id,
+            **payload,
+            kpi_objective={**suggestion.kpi_objective, "review_date": None},
+        )
+    assert not suggestion.execution_id
+
+
+def test_mechanism_search_is_private_and_every_discard_has_a_reason():
+    owner, c, question = pending()
+    report = Report.objects.create(
+        conversation=c, name="bilan.xlsx", digest="x", text="Ventes : 100"
+    )
+    result = analysis("unknown")
+    result.learning_review = "Un lien entre passage en caisse et attente est à examiner."
+    result.proposals = [
+        Proposal(
+            mechanism="Attente et conversion",
+            conditions="Affluence",
+            limits="Hypothèse",
+            evidence=["report:" + str(report.id)],
+        ),
+        Proposal(
