+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from django.test import override_settings
+
+from houston.brain.provider import analyze
+
+
+@override_settings(OPENAI_API_KEY="test-placeholder", HOUSTON_BRAIN_MODEL="test-model")
+def test_provider_receives_context_as_client_data_alongside_other_sources():
+    conversation = MagicMock()
+    conversation.version.prompt = "Format interne"
+    conversation.version.knowledge = {"rules": ["Règle validée"]}
+    conversation.snapshot = {
+        "observations": [
+            {"id": "obs-1", "raw_text": "Attente au déjeuner", "person_name": "Cédric"}
+        ]
+    }
+    conversation.reports.all.return_value = [
+        SimpleNamespace(id="report-1", name="bilan.csv", text="CA:1000")
+    ]
+    conversation.messages.filter.return_value.order_by.return_value.values.return_value = [
+        {"role": "user", "text": "Analyse"}
+    ]
+    with patch("openai.OpenAI") as client:
+        client.return_value.__enter__.return_value = client.return_value
+        final = SimpleNamespace(
+            choices=[
+                SimpleNamespace(
+                    finish_reason="stop",
+                    message=SimpleNamespace(
+                        content='{"answer":"Analyse", "proposals":[]}',
+                        refusal=None,
+                    ),
+                )
+            ]
+        )
+        first = SimpleNamespace(
+            choices=[
+                SimpleNamespace(
+                    finish_reason="stop",
+                    message=SimpleNamespace(
+                        content='{"issues":[],"coverage_complete":true}', refusal=None
+                    ),
+                )
+            ]
+        )
+        client.return_value.chat.completions.create.side_effect = [first, final]
+        analyze(
+            conversation,
+            establishment_context="Flux sans recrutement",
+            memory={"analyses": [{"title": "Bilan précédent"}], "actions": []},
+        )
+    messages = client.return_value.chat.completions.create.call_args.kwargs["messages"]
+    assert messages[-1]["role"] == "user"
+    payload = json.loads(messages[-1]["content"])
+    assert payload["establishment_context"] == "Flux sans recrutement"
+    assert payload["shared_memory"]["analyses"][0]["title"] == "Bilan précédent"
+    assert payload["reports"][0]["name"] == "bilan.csv"
+    assert payload["terrain"] == conversation.snapshot
+    assert payload["conversation"][0]["text"] == "Analyse"
+    assert "Format interne" in messages[0]["content"]
+    reference = json.loads(messages[1]["content"])["reference_knowledge"]
+    assert reference["mechanisms"] == []
+    assert reference["coverage"]["status"] == "legacy_not_selected"
+    first_messages = client.return_value.chat.completions.create.call_args_list[0].kwargs[
+        "messages"
+    ]
+    assert "Règle validée" not in json.dumps(first_messages, ensure_ascii=False)
+    assert len(client.return_value.chat.completions.create.call_args_list) == 2
+
+    assert "CONTRAT DE RESTITUTION SPORE" in messages[0]["content"]
+    assert messages[0]["content"].index("Format interne") < messages[0]["content"].index(
+        "CONTRAT DE RESTITUTION SPORE"
+    )
+    assert "Aucun tableau" in messages[0]["content"]
+    assert "source_catalog" in payload
+
+    first_payload = json.loads(first_messages[-1]["content"])
+    assert first_payload == payload
+    assert payload["source_catalog"] == {
+        "obs-1": {"id": "obs-1", "kind": "observation", "target_id": "obs-1"},
+        "report:report-1": {"id": "report:report-1", "kind": "report", "target_id": "report-1"},
+    }
+    assert payload["terrain"]["observations"][0]["raw_text"] == "Attente au déjeuner"
+    assert payload["terrain"]["observations"][0]["person_name"] == "Cédric"
diff --git a/apps/api/houston/brain/tests/test_response_format.py b/apps/api/houston/brain/tests/test_response_format.py
