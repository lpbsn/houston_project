@@ -0,0 +1,169 @@
+import { useState } from 'react'
+import { useMutation, useQueryClient } from '@tanstack/react-query'
+import { brainApi, type ActionSuggestion, type DecideObjective } from './api'
+import { BrainDialog } from './brain-dialog'
+
+const fieldNames = {
+  name: 'KPI suivi',
+  baseline: 'Point de départ',
+  target: 'Cible visée',
+  horizon: 'Horizon de mesure',
+  measurement: 'Comment mesurer',
+}
+const limits = {
+  name: 120,
+  baseline: 240,
+  target: 240,
+  horizon: 120,
+  measurement: 350,
+}
+
+export function ObjectiveCard({
+  suggestion,
+  site,
+}: {
+  suggestion: ActionSuggestion
+  site: string
+}) {
+  const cache = useQueryClient()
+  const [editing, setEditing] = useState(false)
+  const [draft, setDraft] = useState(suggestion.kpi_objective)
+  const decision = useMutation({
+    mutationFn: (body: DecideObjective) =>
+      brainApi.decideObjective(site, suggestion.id, body),
+    onSuccess: () => {
+      setEditing(false)
+      void cache.invalidateQueries({ queryKey: ['brain', site] })
+    },
+  })
+  const current =
+    decision.data &&
+    (decision.data.objective_decision?.revision ?? 0) >=
+      (suggestion.objective_decision?.revision ?? 0)
+      ? decision.data
+      : suggestion
+  const goal = current.kpi_objective
+  if (!goal) return null
+  const status = current.objective_decision?.status ?? 'proposed'
+  const revision = current.objective_decision?.revision ?? 1
+  function submit(kind: 'validate' | 'reject', objective = goal) {
+    decision.mutate({
+      decision: kind,
+      expected_revision: revision,
+      ...(kind === 'validate' && objective ? { objective } : {}),
+    })
+  }
+  return (
+    <div className="brain-kpi-goal" aria-label={`Objectif : ${goal.name}`}>
+      <b>Objectif daté · {goal.name}</b>
+      <p>
+        {goal.baseline} → <strong>{goal.target}</strong>
+      </p>
+      {goal.review_date && (
+        <p>
+          <strong>
+            Bilan KPI le{' '}
+            {new Date(goal.review_date + 'T12:00:00').toLocaleDateString(
+              'fr-FR',
+            )}
+          </strong>
+        </p>
+      )}
+      <p>
+        {goal.horizon} · {goal.measurement}
+      </p>
+      <p role="status">
+        {status === 'validated'
+          ? 'Objectif validé · suivi enregistré'
+          : status === 'rejected'
+            ? 'Objectif refusé · aucun bilan programmé'
+            : 'Objectif proposé · à confirmer'}
+      </p>
+      <div className="brain-dates">
+        {status !== 'validated' && (
+          <button
+            disabled={decision.isPending}
+            onClick={() => submit('validate')}
+          >
+            Valider l’objectif
+          </button>
+        )}
+        <button
+          disabled={decision.isPending}
+          onClick={() => {
+            setDraft(goal)
+            setEditing(true)
+          }}
+        >
+          Modifier puis valider
+        </button>
+        {status !== 'rejected' && (
+          <button
+            disabled={decision.isPending}
+            onClick={() => submit('reject')}
+          >
+            Refuser l’objectif
+          </button>
+        )}
+      </div>
+      {decision.isError && <p role="alert">{decision.error.message}</p>}
+      <BrainDialog
+        open={editing}
+        onOpenChange={setEditing}
+        title="Modifier l’objectif daté"
+        busy={decision.isPending}
+      >
+        <form
+          className="brain-action-form"
+          onSubmit={(event) => {
+            event.preventDefault()
+            submit('validate', draft)
+          }}
+        >
+          <fieldset disabled={decision.isPending}>
+            {draft && (
+              <>
+                {(
+                  Object.keys(fieldNames) as Array<keyof typeof fieldNames>
+                ).map((key) => (
+                  <label key={key}>
+                    {fieldNames[key]}
+                    <input
+                      required
+                      maxLength={limits[key]}
+                      value={draft[key]}
+                      onChange={(event) =>
+                        setDraft({ ...draft, [key]: event.target.value })
+                      }
+                    />
+                  </label>
+                ))}
+                <label>
+                  Date du bilan KPI
+                  <input
+                    required
+                    type="date"
+                    value={draft.review_date ?? ''}
+                    onChange={(event) =>
+                      setDraft({ ...draft, review_date: event.target.value })
+                    }
+                  />
+                </label>
+              </>
+            )}
+            <p>
+              Le bilan ressortira lorsqu’une analyse couvrira cette date. La
+              validation de l’objectif ne crée pas de plan d’action.
+            </p>
+            <button className="brain-primary" disabled={!draft}>
+              Enregistrer et valider
+            </button>
+            <button type="button" onClick={() => setEditing(false)}>
+              Annuler
+            </button>
+          </fieldset>
+        </form>
+      </BrainDialog>
+    </div>
+  )
+}
