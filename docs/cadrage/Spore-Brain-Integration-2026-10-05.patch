+import { fetchWithAuthRetry } from '@/api/client'
+import { ensureCsrfToken } from '@/features/auth/csrf'
+import type { components } from '@/api/generated/types'
+export type EstablishmentContext = components['schemas']['ContextData']
+export type Conversation = components['schemas']['ConversationData']
+export type BrainSource = components['schemas']['Source']
+export type BrainMessage = components['schemas']['Message']
+export type Workspace = components['schemas']['WorkspaceData']
+export type ActionSuggestion = components['schemas']['ActionSuggestion']
+export type ConvertAction = components['schemas']['ConvertSuggestion']
+export type ActionOptions = components['schemas']['ActionOptions']
+export type ReportText = components['schemas']['ReportText']
+export type Proposal = components['schemas']['PendingMechanism']
+export type AdminState = components['schemas']['BrainAdminData']
+export type LearningReview = components['schemas']['LearningReview']
+export type DecideObjective = components['schemas']['DecideObjective']
+async function request<T>(path: string, body?: FormData | object): Promise<T> {
+  const headers: Record<string, string> = {}
+  if (body) {
+    headers['X-CSRFToken'] = await ensureCsrfToken()
+    if (!(body instanceof FormData))
+      headers['Content-Type'] = 'application/json'
+  }
+  const response = await fetchWithAuthRetry('/api/v1/' + path, {
+    method: body ? 'POST' : 'GET',
+    headers,
+    body:
+      body instanceof FormData ? body : body ? JSON.stringify(body) : undefined,
+  })
+  let payload: { data?: T; detail?: unknown; errors?: unknown }
+  try {
+    payload = await response.json()
+  } catch {
+    throw new Error(
+      'Spore est momentanément indisponible. Réessayez dans quelques instants.',
+    )
+  }
+  if (!response.ok) {
+    function messages(value: unknown): string[] {
+      if (typeof value === 'string') return [value]
+      if (Array.isArray(value)) return value.flatMap(messages)
+      if (value && typeof value === 'object')
+        return Object.values(value).flatMap(messages)
+      return []
+    }
+    const details = messages(payload.errors).slice(0, 5)
+    if (details.length) throw new Error(details.join('\n'))
+    if (
+      typeof payload.detail === 'string' &&
+      !['Request validation failed.', 'An unexpected error occurred.'].includes(
+        payload.detail,
+      )
+    )
+      throw new Error(payload.detail)
+    throw new Error(
+      response.status >= 500
+        ? 'Spore a rencontré une erreur. Réessayez dans quelques instants.'
+        : 'Vérifiez les champs renseignés puis réessayez.',
+    )
+  }
+  return payload.data as T
+}
+export const brainApi = {
+  context: (site: string) =>
+    request<EstablishmentContext>(`establishments/${site}/brain/context/`),
+  saveContext: (site: string, text: string) =>
+    request<EstablishmentContext>(`establishments/${site}/brain/context/`, {
+      text,
+    }),
+  list: (site: string, cursor?: string) =>
+    request<Workspace>(
+      `establishments/${site}/brain/${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''}`,
+    ),
+  actionOptions: (site: string) =>
+    request<ActionOptions>(`establishments/${site}/brain/action-options/`),
+  convert: (site: string, id: string, body: ConvertAction) =>
+    request<ActionSuggestion>(
+      `establishments/${site}/brain/suggestions/${id}/convert/`,
+      body,
+    ),
+  decideObjective: (site: string, id: string, body: DecideObjective) =>
+    request<ActionSuggestion>(
+      `establishments/${site}/brain/suggestions/${id}/objective/`,
+      body,
+    ),
+  report: (site: string, conversation: string, id: string) =>
+    request<ReportText>(
+      `establishments/${site}/brain/${conversation}/reports/${id}/`,
+    ),
+  detail: (site: string, id: string) =>
+    request<Conversation>(`establishments/${site}/brain/${id}/`),
+  create: (site: string, data: FormData) =>
+    request<Conversation>(`establishments/${site}/brain/`, data),
+  ask: (site: string, id: string, text: string, request_id: string) =>
+    request<Conversation>(`establishments/${site}/brain/${id}/`, {
+      text,
+      request_id,
+    }),
+  admin: () => request<AdminState>('brain/administration/'),
+  configure: (body: object) => request('brain/administration/', body),
+}
