+import { afterEach, expect, it, vi } from 'vitest'
+import { fetchWithAuthRetry } from '@/api/client'
+import { brainApi } from './api'
+
+vi.mock('@/api/client', () => ({ fetchWithAuthRetry: vi.fn() }))
+vi.mock('@/features/auth/csrf', () => ({
+  ensureCsrfToken: vi.fn().mockResolvedValue('csrf-test'),
+}))
+afterEach(() => vi.clearAllMocks())
+
+it('affiche le motif de validation fourni par le serveur, pas le message générique', async () => {
+  vi.mocked(fetchWithAuthRetry).mockResolvedValue(
+    new Response(
+      JSON.stringify({
+        code: 'validation_error',
+        detail: 'Request validation failed.',
+        errors: { files: ['Le PDF est protégé ou dépasse 60 pages.'] },
+      }),
+      { status: 400 },
+    ),
+  )
+  await expect(brainApi.detail('site', 'conversation')).rejects.toThrow(
+    'Le PDF est protégé ou dépasse 60 pages.',
+  )
+})
+
+it('explique une réponse serveur non JSON sans afficher du HTML ou une erreur de parseur', async () => {
+  vi.mocked(fetchWithAuthRetry).mockResolvedValue(
+    new Response('<html>Proxy error</html>', { status: 502 }),
+  )
+  await expect(brainApi.detail('site', 'conversation')).rejects.toThrow(
+    'Spore est momentanément indisponible',
+  )
+})
+
+it('conserve un refus d’accès compréhensible', async () => {
+  vi.mocked(fetchWithAuthRetry).mockResolvedValue(
+    new Response(
+      JSON.stringify({
+        detail:
