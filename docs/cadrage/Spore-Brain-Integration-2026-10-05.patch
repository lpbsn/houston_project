index 0000000..b51ab70
--- /dev/null
+++ b/apps/api/houston/brain/tests/test_batch_analysis.py
@@ -0,0 +1,160 @@
+import copy
+import json
+import unittest
+from unittest.mock import patch
+
+from houston.brain.batch_analysis import (
+    BatchError,
+    BatchNotes,
+    Note,
+    Quote,
+    encode,
+    parts,
+    prepare,
+    records,
+    verified_notes,
+)
+
+
+def reader(messages, schema):
+    payload = json.loads(messages[-1]["content"])
+    rows = payload["parts"]
+    return BatchNotes(
+        complete=True,
+        covered_parts=[r["part_id"] for r in rows],
+        notes=[
+            Note(
+                topic="Sujet " + r["source_id"],
+                statement="Lecture à vérifier",
+                quotes=[Quote(part_id=r["part_id"], excerpt=r["text"][:120])],
+            )
+            for r in rows
+            if r["text"].strip()
+        ],
+    )
+
+
+class BatchReadingTests(unittest.TestCase):
+    def data(self):
+        return {
+            "reports": [
+                {"id": "report:1", "name": "Bilan", "text": "Restaurant CA 80 budget 100\n"}
+            ],
+            "terrain": {
+                "observations": [
+                    {"id": "o1", "raw_text": "Attente longue", "person_name": "Cédric"}
+                ],
+                "comments": [{"id": "c1", "body": "Correction récente"}],
+            },
+            "shared_memory": {
+                "due_kpi_reviews": [{"id": "g1", "target": "90", "review_date": "2026-10-20"}]
+            },
+            "conversation": [{"role": "user", "text": "Analyser"}],
+            "source_catalog": {"o1": {"id": "o1", "kind": "observation", "target_id": "o1"}},
+        }
+
+    def test_large_corpus_is_fully_read_and_each_request_is_bounded(self):
+        data = self.data()
+        data["terrain"]["observations"] = [
+            {
+                "id": f"o{i}",
+                "raw_text": ("Observation avec contexte " * 150),
+                "person_name": "Cédric",
+            }
+            for i in range(220)
+        ]
+        original = copy.deepcopy(data)
+        calls = []
+
+        def complete(messages, schema):
+            calls.append(messages)
+            self.assertLess(sum(len(m["content"]) for m in messages), 300000)
+            return reader(messages, schema)
+
+        result, trace = prepare(data, complete, 300000)
+        self.assertGreater(len(encode(data)), 600000)
+        self.assertGreater(trace["reading_calls"], 2)
+        self.assertEqual(trace["records_read"], len(list(records(data))))
+        self.assertEqual(trace["parts_read"], len(parts(data)))
+        self.assertEqual(data, original)
+        self.assertLess(len(encode(result)), 220000)
+        self.assertEqual(
+            result["shared_memory"]["due_kpi_reviews"], data["shared_memory"]["due_kpi_reviews"]
+        )
+        self.assertEqual(result["reporting_topic_ids"], ["report_topic_0"])
+        for messages in calls[1:]:
+            self.assertTrue(json.loads(messages[-1]["content"])["report_reading_draft"])
+
+    def test_splitting_never_truncates_originals(self):
+        data = self.data()
+        data["reports"][0]["text"] = "é\n" * 20001
+        allparts = parts(data)
+        for number, (_, _, text, _) in enumerate(records(data)):
+            self.assertEqual("".join(r["text"] for r in allparts if r["record"] == number), text)
+
+    def test_unknown_missing_duplicate_or_invented_evidence_is_rejected(self):
+        packet = parts(self.data())[:1]
+        valid = reader([{"content": encode({"parts": packet})}], BatchNotes)
+        for mode in ("missing", "duplicate", "unknown", "quote"):
+            response = valid.model_copy(deep=True)
+            if mode == "missing":
+                response.covered_parts = []
+            if mode == "duplicate":
+                response.covered_parts *= 2
+            if mode == "unknown":
+                response.notes[0].quotes[0].part_id = "another-tenant"
+            if mode == "quote":
+                response.notes[0].quotes[0].excerpt = "CA inventé 999999"
+            with self.assertRaises(BatchError):
+                verified_notes(response, packet, {})
+
+    def test_incomplete_packet_is_split_and_all_parts_remain_covered(self):
+        data = self.data()
+        calls = []
+
+        def complete(messages, schema):
+            rows = json.loads(messages[-1]["content"])["parts"]
+            calls.append(len(rows))
+            if len(rows) > 1:
+                return BatchNotes(complete=False, covered_parts=[], notes=[])
+            return reader(messages, schema)
+
+        _, trace = prepare(data, complete, 300000)
+        self.assertEqual(trace["parts_read"], len(parts(data)))
+        self.assertTrue(any(n > 1 for n in calls))
+
+    def test_oversized_single_part_can_be_split_without_losing_text(self):
+        data = self.data()
+        data["reports"][0]["text"] = "Restaurant CA 80\n" * 200
+        seen = []
+
+        def complete(messages, schema):
+            rows = json.loads(messages[-1]["content"])["parts"]
+            if len(rows) == 1 and len(rows[0]["text"]) > 2000:
+                return BatchNotes(complete=False, covered_parts=[], notes=[])
+            seen.extend(r["text"] for r in rows if r["kind"] == "report")
+            return reader(messages, schema)
+
+        _, trace = prepare(data, complete, 300000)
+        self.assertEqual("".join(seen), data["reports"][0]["text"])
+        self.assertEqual(trace["parts_read"], len(parts(data)))
+
+    def test_empty_reporting_extraction_is_not_accepted_as_complete(self):
+        def empty(messages, schema):
+            rows = json.loads(messages[-1]["content"])["parts"]
+            return BatchNotes(complete=True, covered_parts=[r["part_id"] for r in rows], notes=[])
+
+        with self.assertRaisesRegex(BatchError, "batch_coverage_incomplete"):
+            prepare(self.data(), empty, 300000)
+
+    def test_work_limit_stops_instead_of_returning_partial_result(self):
+        with patch("houston.brain.batch_analysis.MAX_CALLS", 1):
+            with self.assertRaisesRegex(BatchError, "batch_work_limit"):
+                prepare(self.data(), reader, 300000)
+
+    def test_original_ids_and_routes_are_preserved_in_verified_excerpts(self):
+        result, _ = prepare(self.data(), reader, 300000)
+        quotes = [q for note in result["evidence_digest"] for q in note["original_excerpts"]]
+        observation = next(q for q in quotes if q["source_id"] == "o1")
+        self.assertEqual(observation["route"]["target_id"], "o1")
+        self.assertEqual(observation["metadata"]["person_name"], "Cédric")
