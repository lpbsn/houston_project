@@ -0,0 +1,51 @@
+"""Bounded retrieval of original reporting values, not previous AI paraphrases."""
+
+from .models import Report
+from .permissions import member
+
+
+def previous_year(day):
+    try:
+        return day.replace(year=day.year - 1)
+    except ValueError:
+        return day.replace(year=day.year - 1, day=28)
+
+
+def capture(user, site, start, end, exclude_conversation=None):
+    member(user, site)
+    base = (
+        Report.objects.filter(conversation__establishment_id=site, conversation__end__lt=start)
+        .exclude(
+            conversation_id=exclude_conversation,
+        )
+        .select_related("conversation")
+    )
+    recent = list(base.order_by("-conversation__end", "-created_at", "-id")[:4])
+    annual = list(
+        base.filter(
+            conversation__start__lte=previous_year(end), conversation__end__gte=previous_year(start)
+        ).order_by("-conversation__end", "-created_at")[:3]
+    )
+    rows, seen, budget = [], set(), 80000
+    partial = base.exclude(pk__in=[report.id for report in recent + annual]).exists()
+    for report in recent + annual:
+        identity = (report.digest, report.conversation.start, report.conversation.end)
+        if identity in seen:
+            continue
+        seen.add(identity)
+        if len(report.text) > budget:
+            partial = True
+            continue  # Never send half a table as if it were a complete reporting.
+        budget -= len(report.text)
+        rows.append(
+            {
+                "id": "report:" + str(report.id),
+                "conversation_id": str(report.conversation_id),
+                "name": report.name,
+                "text": report.text,
+                "start": str(report.conversation.start),
+                "end": str(report.conversation.end),
+                "is_original_reporting": True,
+            }
+        )
+    return rows, partial
