+from rest_framework import serializers
+
+
+class ContextSerializer(serializers.Serializer):
+    text = serializers.CharField(max_length=6000, allow_blank=True, trim_whitespace=False)
+
+
+class ContextDataSerializer(serializers.Serializer):
+    text = serializers.CharField()
+    updated_at = serializers.DateTimeField(allow_null=True)
+
+
+class ContextResponseSerializer(serializers.Serializer):
+    data = ContextDataSerializer()
+
+
+class CreateSerializer(serializers.Serializer):
+    title = serializers.CharField(max_length=160)
+    start = serializers.DateField()
+    end = serializers.DateField()
+    files = serializers.ListField(child=serializers.FileField(), min_length=1, max_length=5)
+
+
+class QuestionSerializer(serializers.Serializer):
+    text = serializers.CharField(max_length=4000)
+    request_id = serializers.UUIDField()
+
+
+class AdminCommandSerializer(serializers.Serializer):
+    operation = serializers.ChoiceField(choices=["version", "activate", "approve", "reject"])
+    id = serializers.UUIDField(required=False)
+    label = serializers.CharField(max_length=120, required=False)
+    knowledge = serializers.JSONField(required=False)
+    prompt = serializers.CharField(max_length=16000, required=False)
+    edited = serializers.JSONField(required=False)
+
+    def validate(self, attrs):
+        required = {
+            "version": ("label", "knowledge", "prompt"),
+            "activate": ("id",),
+            "approve": ("id", "edited"),
+            "reject": ("id",),
+        }[attrs["operation"]]
+        missing = {key: "Ce champ est requis." for key in required if key not in attrs}
+        if missing:
+            raise serializers.ValidationError(missing)
+        return attrs
+
+
+class BrainResponseSerializer(serializers.Serializer):
+    data = serializers.JSONField()
+
+
+class BrainVersionSummarySerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    label = serializers.CharField()
+    knowledge = serializers.JSONField()
+    prompt = serializers.CharField()
+    created_at = serializers.DateTimeField()
+
+
+class MechanismProposalSerializer(serializers.Serializer):
+    mechanism = serializers.CharField()
+    conditions = serializers.CharField()
+    limits = serializers.CharField()
+    evidence = serializers.ListField(child=serializers.CharField())
+
+
+class PendingMechanismSerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    proposal = MechanismProposalSerializer()
+    conversation__title = serializers.CharField()
+    conversation__establishment__name = serializers.CharField()
+
+
+class DiscardedMechanismSerializer(serializers.Serializer):
+    mechanism = serializers.CharField()
+    reason = serializers.CharField()
+
+
+class LearningResultSerializer(serializers.Serializer):
+    reason = serializers.CharField()
+    generated = serializers.IntegerField()
+    created = serializers.IntegerField()
+    discarded = DiscardedMechanismSerializer(many=True)
+
+
+class LearningReviewSerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    title = serializers.CharField()
+    establishment = serializers.CharField()
+    created_at = serializers.DateTimeField()
+    result = LearningResultSerializer()
+
+
+class BrainAdminDataSerializer(serializers.Serializer):
+    active = serializers.UUIDField(allow_null=True)
+    versions = BrainVersionSummarySerializer(many=True)
+    proposals = PendingMechanismSerializer(many=True)
+    learning_reviews = LearningReviewSerializer(many=True)
+
+
+class BrainAdminResponseSerializer(serializers.Serializer):
+    data = BrainAdminDataSerializer()
+
+
+class HistoryQuerySerializer(serializers.Serializer):
+    cursor = serializers.UUIDField(required=False)
+
+
+class ConversationSummarySerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    title = serializers.CharField()
+    status = serializers.CharField()
+    start = serializers.DateField()
+    end = serializers.DateField()
+    author_name = serializers.CharField()
+
+
+class WorkspaceDataSerializer(serializers.Serializer):
+    conversations = ConversationSummarySerializer(many=True)
+    next_cursor = serializers.UUIDField(allow_null=True)
+    can_admin = serializers.BooleanField()
+
+
+class WorkspaceResponseSerializer(serializers.Serializer):
+    data = WorkspaceDataSerializer()
+
+
+class LinkedExecutionSerializer(serializers.Serializer):
+    id = serializers.UUIDField()
+    title = serializers.CharField()
+    status = serializers.CharField()
+    deadline = serializers.DateTimeField(allow_null=True)
+
+
+class KpiObjectiveSerializer(serializers.Serializer):
+    name = serializers.CharField(max_length=120)
+    baseline = serializers.CharField(max_length=240)
+    target = serializers.CharField(max_length=240)
