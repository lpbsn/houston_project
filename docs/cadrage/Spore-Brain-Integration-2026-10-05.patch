+from datetime import timedelta
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from django.utils import timezone
+from pydantic import ValidationError as SchemaError
+
+from houston.brain import action_services, references, selectors, services
+from houston.brain.provider import ActionDraft, Analysis, Insight, KpiObjective
+from houston.brain.tests.test_shared import action_case
+
+pytestmark = pytest.mark.django_db
+
+
+def objective():
+    return KpiObjective(
+        name="Attente au restaurant",
+        baseline="22 minutes",
+        target="Revenir sous 15 minutes",
+        horizon="Sous 3 semaines",
+        measurement="Temps entre commande et service, chaque soir",
+        review_date=timezone.localdate() + timedelta(days=21),
+    )
+
+
+def analysis(source):
+    return Analysis(
+        answer="- **Priorité** : réduire l’attente.",
+        proposals=[],
+        insights=[
+            Insight(
+                kpi="Attente",
+                finding="22 minutes, contre 12 initialement.",
+                terrain="La file en cuisine peut éclairer cette hausse.",
+                confidence="hypothèse",
+                sources=[source],
+                action_indexes=[0],
+            )
+        ],
+        actions=[
+            ActionDraft(
+                title="Fluidifier le service",
+                description="Tester une organisation.",
+                tasks=["Mesurer l’attente", "Tester une nouvelle répartition"],
+                kpi_objective=objective(),
+            )
+        ],
+    )
+
+
+def test_schema_requires_kpi_and_rejects_unlinked_or_duplicate_plans():
+    result = analysis(str(uuid4())).model_dump(mode="json")
+    del result["actions"][0]["kpi_objective"]
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(result)
+    result = analysis(str(uuid4())).model_dump(mode="json")
+    result["insights"][0]["action_indexes"] = [4]
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(result)
+    result["insights"][0]["action_indexes"] = []
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(result)
+    result["insights"][0]["action_indexes"] = [0, 0]
+    with pytest.raises(SchemaError):
+        Analysis.model_validate(result)
+
+
+def test_kpi_is_preserved_in_real_plan_and_double_click_cannot_duplicate():
+    owner, _, suggestion, payload = action_case()
+    suggestion.kpi_objective = objective().model_dump(mode="json")
+    suggestion.save()
+    target = {**suggestion.kpi_objective, "target": "Revenir sous 18 minutes"}
+    first = action_services.convert(
+        owner.user, owner.establishment_id, suggestion.id, **payload, kpi_objective=target
+    )
+    assert "Revenir sous 18 minutes" in first.execution.description
+    assert "Temps entre commande" in first.execution.description
+    assert first.kpi_objective == target
+    again = action_services.convert(owner.user, owner.establishment_id, suggestion.id, **payload)
+    assert first.execution_id == again.execution_id
+
+
+def test_generated_response_rejects_fabricated_references_and_exposes_real_source_title():
+    owner, c, suggestion, payload = action_case()
+    plan = action_services.convert(owner.user, owner.establishment_id, suggestion.id, **payload)
+    c.snapshot = {
+        "actions": [
+            {
+                "id": str(plan.execution_id),
+                "title": plan.execution.title,
+                "description": "Mesure des files le soir",
+            }
+        ]
+    }
+    c.save()
+    with patch.object(services, "consent"):
+        services.ask(owner.user, owner.establishment_id, c.id, "Analyse", uuid4())
+    question = c.messages.get(role="user")
+    result = analysis(str(plan.execution_id))
+    unknown = str(uuid4())
+    result.insights[0].sources.append(unknown)
+    with (
+        patch("houston.brain.provider.analyze", return_value=result),
+        patch.object(services, "consent"),
+    ):
+        services.run(question.id)
+    response = selectors.public(c)["messages"][-1]
+    assert response["insights"][0]["sources"] == [str(plan.execution_id)]
+    assert response["insights"][0]["missing_sources"] is True
+    assert response["sources"][0]["title"] == plan.execution.title
+    assert (
+        response["sources"][0]["path"]
+        == f"/e/{owner.establishment_id}/execution/{plan.execution_id}"
+    )
+    assert response["action_suggestions"][0]["kpi_objective"]["name"] == "Attente au restaurant"
+
+
+def test_source_links_never_point_to_another_establishment():
+    owner, _, _, _ = action_case()
+    foreign, _, suggestion, payload = action_case()
+    converted = action_services.convert(
+        foreign.user, foreign.establishment_id, suggestion.id, **payload
+    )
+    key = str(converted.execution_id)
+    entries = references.catalog({"actions": [{"id": key, "title": "Untrusted title"}]}, {})
+    result = references.public_sources(owner.establishment_id, entries)[key]
+    assert result["path"] is None and result["available"] is False
+    assert result["detail"] == ""  # No foreign content is loaded from the database.
