+
+function ProposalCard({
+  p,
+  onSave,
+  busy,
+}: {
+  p: Proposal
+  onSave: (data: object) => void
+  busy: boolean
+}) {
+  const [text, setText] = useState(
+    JSON.stringify({ ...p.proposal, evidence: [] }, null, 2),
+  )
+  const [error, setError] = useState('')
+  const [checked, setChecked] = useState(false)
+  return (
+    <article className="brain-upload">
+      <h3>
+        {p.conversation__establishment__name} · {p.conversation__title}
+      </h3>
+      <p>{p.proposal.mechanism}</p>
+      <p>Preuves : {p.proposal.evidence.join(', ')}</p>
+      <label>
+        Mécanisme réutilisable, corrigé et anonymisé
+        <textarea
+          rows={9}
+          value={text}
+          onChange={(e) => setText(e.target.value)}
+        />
+      </label>
+      <label>
+        <input
+          type="checkbox"
+          checked={checked}
+          onChange={(e) => setChecked(e.target.checked)}
+        />{' '}
+        J’ai retiré les données identifiantes et validé la portée de ce
+        mécanisme.
+      </label>
+      <div className="brain-dates">
+        <button
+          disabled={!checked || busy}
+          className="brain-primary"
+          onClick={() => {
+            try {
+              onSave({
+                operation: 'approve',
+                id: p.id,
+                edited: JSON.parse(text),
+              })
+            } catch {
+              setError('JSON invalide')
+            }
+          }}
+        >
+          Valider et intégrer
+        </button>
+        <button
+          disabled={busy}
+          onClick={() => onSave({ operation: 'reject', id: p.id })}
+        >
+          Refuser
+        </button>
+      </div>
+      {error && <p role="alert">{error}</p>}
+    </article>
+  )
+}
+function BrainAdmin({ onClose }: { onClose: () => void }) {
+  const cache = useQueryClient()
+  const state = useQuery({ queryKey: ['brain-admin'], queryFn: brainApi.admin })
+  const [knowledge, setKnowledge] = useState('{}')
+  const [prompt, setPrompt] = useState('')
+  const [label, setLabel] = useState('')
+  const [error, setError] = useState('')
+  const save = useMutation({
+    mutationFn: brainApi.configure,
+    onSuccess: () => {
+      void cache.invalidateQueries({ queryKey: ['brain-admin'] })
+    },
+  })
+  return (
+    <main className="brain brain-admin">
+      <button onClick={onClose}>
+        <ArrowLeft size={16} /> Retour au chat
+      </button>
+      <span className="brain-eyebrow">ADMINISTRATION PRIVÉE</span>
+      <h1>La mémoire métier de Spore.</h1>
+      <p>
+        Les versions actives s’appliquent aux nouvelles conversations. Les
+        conversations existantes conservent leur référentiel.
+      </p>
+      {state.isError && <p role="alert">{errorText(state.error)}</p>}
+      <section className="brain-upload">
+        <h2>Créer une version</h2>
+        <label>
+          Nom
+          <input
+            value={label}
+            onChange={(e) => setLabel(e.target.value)}
+            maxLength={120}
+          />
+        </label>
+        <label>
+          Importer le JSON métier
+          <input
+            type="file"
+            accept=".json"
+            onChange={async (e) => {
+              const f = e.target.files?.[0]
+              if (f) {
+                if (f.size > 128000) {
+                  setError('JSON trop volumineux')
+                  return
+                }
+                setKnowledge(await f.text())
+              }
+            }}
+          />
+        </label>
+        <label>
+          JSON
+          <textarea
+            rows={8}
+            value={knowledge}
+            onChange={(e) => setKnowledge(e.target.value)}
+          />
+        </label>
+        <label>
+          Prompt d’analyse et périmètre des questions
+          <textarea
+            rows={8}
+            value={prompt}
+            onChange={(e) => setPrompt(e.target.value)}
+            maxLength={16000}
+          />
+        </label>
+        <button
+          disabled={save.isPending || !label || prompt.length < 20}
+          className="brain-primary"
+          onClick={() => {
+            try {
+              setError('')
+              save.mutate({
+                operation: 'version',
+                label,
+                knowledge: JSON.parse(knowledge),
+                prompt,
+              })
+            } catch {
+              setError('JSON invalide')
+            }
+          }}
+        >
+          Enregistrer une version
+        </button>
+      </section>
+      <h2>Versions et activation</h2>
+      {state.data?.versions.map((v) => (
+        <div className="brain-version" key={v.id}>
+          <strong>
+            {v.label}
+            {v.id === state.data?.active ? ' · Active' : ''}
+          </strong>
+          <button
+            onClick={() => {
+              setKnowledge(JSON.stringify(v.knowledge, null, 2))
+              setPrompt(v.prompt)
+              setLabel(v.label + ' — révision')
+            }}
+          >
+            Reprendre
+          </button>
+          <button
+            disabled={save.isPending || v.id === state.data?.active}
+            onClick={() => save.mutate({ operation: 'activate', id: v.id })}
+          >
+            Activer
+          </button>
+        </div>
+      ))}
+      <LearningReviews reviews={state.data?.learning_reviews ?? []} />
+      <h2>Mécanismes à examiner</h2>
+      <p>
+        Aucun ajout automatique. Une validation crée et active une nouvelle
+        version du JSON.
+      </p>
+      {state.data?.proposals.map((p) => (
+        <ProposalCard
+          key={p.id}
+          p={p}
+          busy={save.isPending}
+          onSave={(d) => save.mutate(d)}
+        />
+      ))}
+      {!state.data?.proposals.length && <p>Aucun mécanisme en attente.</p>}
+      {(error || save.isError) && (
+        <p role="alert">{error || errorText(save.error)}</p>
+      )}
+    </main>
+  )
+}
