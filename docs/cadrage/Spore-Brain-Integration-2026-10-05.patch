+++ b/apps/api/houston/brain/references.py
@@ -0,0 +1,183 @@
+"""Only captured evidence can become a reference; never accept an AI-generated URL."""
+
+import re
+from uuid import UUID
+
+UUID_PATTERN = re.compile(
+    r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b"
+)
+
+
+def catalog(snapshot, memory, reports=()):
+    result = {}
+
+    def add(row, kind, title, detail, target=None):
+        key = str(row.get("id", ""))
+        if not key:
+            return
+        result[key] = {
+            "id": key,
+            "kind": kind,
+            "target_id": str(target or key),
+            "title": " ".join((title or "Source terrain").split())[:180],
+            "detail": str(detail or "")[:2000],
+            "date": str(row.get("submitted_at") or row.get("created_at") or row.get("start") or ""),
+            "person_name": row.get("person_name", ""),
+            "observed_at_local": row.get("observed_at_local", ""),
+            "responsible_people": row.get("responsible_people", []),
+            "deadline": row.get("deadline") or row.get("end_at"),
+            "status": row.get("status", ""),
+            "processing_status": row.get("processing__status"),
+            "processing_outcome": row.get("processing__outcome"),
+            "linked_subjects": row.get("linked_subjects", []),
+        }
+
+    for row in snapshot.get("observations", []):
+        add(
+            row,
+            "observation",
+            row.get("title") or row.get("raw_text", "Observation")[:100],
+            row.get("raw_text"),
+        )
+    for row in snapshot.get("signals", []):
+        add(row, "signal", row.get("title"), row.get("structured_summary"))
+    for row in snapshot.get("actions", []):
+        add(row, "action", row.get("title"), row.get("description"))
+    for row in memory.get("actions", []):
+        previous = result.get(str(row.get("id")), {})
+        add(row, "action", row.get("title"), previous.get("detail", ""))
+    for row in memory.get("analyses", []):
+        add(row, "analysis", row.get("title"), row.get("summary"))
+    for row in [*memory.get("report_history", []), *reports]:
+        add(
+            row,
+            "report",
+            row.get("name"),
+            row.get("text", "")[:1000],
+            row["id"].removeprefix("report:"),
+        )
+    for kind in ("comments", "tasks", "reviews", "events"):
+        for row in snapshot.get(kind, []):
+            parent = result.get(str(row.get("signal_id") or row.get("action_plan_execution_id")))
+            if parent:
+                add(
+                    row,
+                    parent["kind"],
+                    parent["title"],
+                    row.get("body") or row.get("task") or row.get("comment") or parent["detail"],
+                    parent["target_id"],
+                )
+    return result
+
+
+def provider_catalog(snapshot, memory, reports=()):
+    """Routing index only; complete evidence stays in the provider's original data.
+
+    Keep catalog() intact for server validation, tooltips and tenant-scoped links.
+    Derive routing from it so child comments/tasks keep the same parent targets.
+    """
+    return {
+        key: {field: row[field] for field in ("id", "kind", "target_id")}
+        for key, row in catalog(snapshot, memory, reports).items()
+    }
+
+
+def referenced_ids(text):
+    return set(UUID_PATTERN.findall(text))
+
+
+def public_sources(site, entries):
+    from houston.action_plans.models import ActionPlanExecution
+    from houston.observations.models import Observation
+    from houston.signals.models import Signal, SignalSourceObservation
+
+    from .models import Conversation, Report
+
+    ids = {}
+    for row in entries.values():
+        try:
+            key = str(UUID(row["target_id"]))
+        except (ValueError, TypeError):
+            continue
+        ids.setdefault(row["kind"], set()).add(key)
+    signals = set(
+        map(
+            str,
+            Signal.objects.filter(establishment_id=site, id__in=ids.get("signal", [])).values_list(
+                "id", flat=True
+            ),
+        )
+    )
+    actions = set(
+        map(
+            str,
+            ActionPlanExecution.objects.filter(
+                establishment_id=site, id__in=ids.get("action", [])
+            ).values_list("id", flat=True),
+        )
+    )
+    analyses = set(
+        map(
+            str,
+            Conversation.objects.filter(
+                establishment_id=site, id__in=ids.get("analysis", [])
+            ).values_list("id", flat=True),
+        )
+    )
+    observations = set(
+        map(
+            str,
+            Observation.objects.filter(
+                establishment_id=site, id__in=ids.get("observation", [])
+            ).values_list("id", flat=True),
+        )
+    )
+    reports = {
+        str(row.id): str(row.conversation_id)
+        for row in Report.objects.filter(
+            conversation__establishment_id=site, id__in=ids.get("report", [])
+        )
+    }
+    links = {}
+    for obs_id, signal_id in (
+        SignalSourceObservation.objects.filter(
+            observation_id__in=observations,
+            observation__establishment_id=site,
+            signal__establishment_id=site,
+        )
+        .order_by("created_at", "id")
+        .values_list("observation_id", "signal_id")
+    ):
+        links.setdefault(str(obs_id), str(signal_id))
+    result = {}
+    for key, row in entries.items():
+        target, kind = row["target_id"], row["kind"]
+        path, conversation_id = None, None
+        exists = target in {
+            "signal": signals,
+            "action": actions,
+            "analysis": analyses,
+            "observation": observations,
+            "report": reports,
+        }.get(kind, set())
+        if kind == "signal" and exists:
+            path = f"/e/{site}/signals/{target}"
+        elif kind == "action" and exists:
+            path = f"/e/{site}/execution/{target}"
+        elif kind == "observation" and target in links:
+            path = f"/e/{site}/signals/{links[target]}"
+        elif kind == "analysis" and exists:
+            conversation_id = target
+        elif kind == "report" and exists:
+            conversation_id = reports[target]
+        result[key] = {
+            "id": key,
+            "kind": kind,
+            "title": row["title"],
+            "detail": row["detail"],
+            "date": row["date"],
+            "path": path,
+            "conversation_id": conversation_id,
+            "available": exists,
+        }
+    return result
