+import json
+from datetime import datetime, time, timedelta
+from zoneinfo import ZoneInfo
+
+from django.db.models import Q
+from django.utils import timezone
+from rest_framework.exceptions import NotFound, ValidationError
+
+from houston.accounts.display import membership_display_name
+
+from .models import ActionSuggestion, Conversation, EstablishmentContext
+from .permissions import member
+
+
+def learning_reviews(user):
+    from .models import Message
+    from .permissions import administrator
+
+    administrator(user)
+    messages = (
+        Message.objects.filter(role="assistant", presentation__has_key="learning")
+        .select_related("conversation__establishment")
+        .order_by("-created_at", "-id")[:30]
+    )
+    return [
+        {
+            "id": msg.id,
+            "title": msg.conversation.title,
+            "establishment": msg.conversation.establishment.name,
+            "created_at": msg.created_at,
+            "result": msg.presentation["learning"],
+        }
+        for msg in messages
+    ]
+
+
+def establishment_context(user, site):
+    m = member(user, site)
+    context = EstablishmentContext.objects.filter(establishment_id=m.establishment_id).first()
+    return {
+        "text": context.text if context else "",
+        "updated_at": context.updated_at if context else None,
+    }
+
+
+def conversation(user, site, pk):
+    m = member(user, site)
+    c = (
+        Conversation.objects.filter(pk=pk, establishment_id=m.establishment_id)
+        .select_related("version")
+        .first()
+    )
+    if c is None:
+        raise NotFound("Conversation introuvable.")
+    return c
+
+
+def conversations(user, site, cursor=None):
+    member(user, site)
+    rows = Conversation.objects.filter(establishment_id=site).order_by("-created_at", "-id")
+    if cursor:
+        anchor = Conversation.objects.filter(pk=cursor, establishment_id=site).first()
+        if not anchor:
+            raise ValidationError("Page d’historique introuvable.")
+        rows = rows.filter(
+            Q(created_at__lt=anchor.created_at) | Q(created_at=anchor.created_at, id__lt=anchor.id)
+        )
+    page = list(rows.select_related("membership__user")[:41])
+    return {
+        "conversations": [
+            {
+                "id": str(c.id),
+                "title": c.title,
+                "status": c.status,
+                "start": str(c.start),
+                "end": str(c.end),
+                "author_name": membership_display_name(c.membership) or "Membre",
+            }
+            for c in page[:40]
+        ],
+        "next_cursor": str(page[39].id) if len(page) > 40 else None,
+        "can_admin": user.has_perm("brain.manage_brain"),
+    }
+
+
+def action_options(user, site):
+    from houston.establishments.membership_scope import (
+        membership_covers_business_unit_including_admins,
+        membership_scope_prefetch,
+    )
+    from houston.establishments.models import BusinessUnit, EstablishmentMembership
+    from houston.establishments.permissions import is_valid_membership
+
+    m = member(user, site)
+    units = list(
+        BusinessUnit.objects.filter(establishment_id=site, active=True).order_by(
+            "specific_name", "id"
+        )[:101]
+    )
+    members = list(
+        EstablishmentMembership.objects.filter(establishment_id=site, status="active")
+        .select_related("user", "establishment__organization")
+        .prefetch_related(membership_scope_prefetch())
+        .order_by("id")[:501]
+    )
+    if len(units) > 100 or len(members) > 500:
+        raise ValidationError(
+            "Cet établissement dépasse la taille prise en charge par ce formulaire."
+        )
+    return {
+        "timezone": m.establishment.timezone,
+        "business_units": [{"id": str(b.id), "name": b.specific_name} for b in units],
+        "members": [
+            {
+                "id": str(p.id),
+                "name": membership_display_name(p) or "Membre",
+                "business_unit_ids": [
+                    str(b.id)
+                    for b in units
+                    if membership_covers_business_unit_including_admins(p, b)
+                ],
+            }
+            for p in members
+            if is_valid_membership(p)
+        ],
+    }
+
+
+def public_suggestion(s):
+    execution = s.execution
+    return {
+        "id": str(s.id),
+        "title": s.title,
+        "description": s.description,
+        "tasks": s.tasks,
+        "kpi_objective": s.kpi_objective or None,
+        "objective_decision": {
+            "status": s.objective_status,
+            "revision": s.objective_revision,
+            "decided_at": s.objective_decided_at,
+        }
+        if s.kpi_objective
+        else None,
+        "pilot_business_unit_id": str(s.pilot_business_unit_id)
+        if s.pilot_business_unit_id
+        else None,
+        "suggested_due_days": s.suggested_due_days,
+        "converted_at": s.converted_at,
+        "execution": {
+            "id": str(execution.id),
+            "title": execution.title,
+            "status": execution.status,
+            "deadline": execution.end_at,
+        }
+        if execution
+        else None,
+    }
+
+
+def report(user, site, conversation_id, report_id):
+    c = conversation(user, site, conversation_id)
+    r = c.reports.filter(pk=report_id).first()
+    if not r:
+        raise NotFound("Reporting introuvable.")
+    return {"id": str(r.id), "name": r.name, "text": r.text}
+
+
+def narrative_name(membership):
+    """Send names needed to understand the operation, without email fallbacks."""
+    if not membership or membership.user.status == "anonymized":
+        return "Un ancien membre de l’équipe"
+    return membership.user.get_full_name().strip() or "Un membre de l’équipe"
+
+
+def action_people(site, execution_ids):
+    from houston.action_plans.models import ActionPlanAssignee
+
+    people = list(
+        ActionPlanAssignee.objects.filter(
+            action_plan_execution__establishment_id=site,
+            action_plan_execution_id__in=execution_ids,
+            membership__establishment_id=site,
+        ).select_related("membership__user", "execution_team__business_unit")[:2001]
+    )
+    if len(people) > 2000:
+        raise ValidationError("Trop d’affectations de plans : réduisez la période analysée.")
+    result = {}
+    for person in people:
+        result.setdefault(str(person.action_plan_execution_id), []).append(
+            {
+                "name": narrative_name(person.membership),
+                "membership_id": str(person.membership_id),
+                "business_unit": person.execution_team.business_unit.specific_name,
+                "deadline": person.end_at.isoformat() if person.end_at else None,
+            }
+        )
+    return result
+
+
+def snapshot(m, start, end):
+    from houston.action_plans.models import (
+        ActionPlanExecutionLifecycleEvent,
+        ActionPlanExecutionReview,
+        ActionPlanExecutionTask,
+    )
+    from houston.action_plans.selectors import action_plan_execution_feed_queryset
+    from houston.comments.models import Comment
+    from houston.establishments.models import BusinessUnit
+    from houston.observations.models import Observation
+    from houston.signals.selectors import signal_feed_queryset
+
+    zone_name = m.establishment.timezone or "Europe/Paris"
+    zone = ZoneInfo(zone_name)
+    lower = datetime.combine(start, time.min, zone)
+    upper = datetime.combine(end + timedelta(days=1), time.min, zone)
+
+    # All eligible rows in the bounded period; never silently truncate an analysis.
+    def rows(q, fields):
+        data = list(q.order_by("created_at", "id").values(*fields)[:2001])
+        if len(data) > 2000:
+            raise ValidationError("Trop de données terrain : choisissez une période plus courte.")
+        return json.loads(json.dumps(data, default=str))
+
+    signals = (
+        signal_feed_queryset(membership=m, view_mode="general")
+        .filter(created_at__lt=upper)
+        .filter(Q(created_at__gte=lower) | Q(updated_at__gte=lower))
+    )
+    actions = (
+        action_plan_execution_feed_queryset(membership=m, view_mode="general")
+        .filter(created_at__lt=upper)
+        .filter(Q(end_at__gte=lower) | Q(updated_at__gte=lower))
+    )
+    observations = Observation.objects.filter(
+        establishment=m.establishment, submitted_at__gte=lower, submitted_at__lt=upper
+    )
+    comments = Comment.objects.filter(
+        establishment=m.establishment, created_at__gte=lower, created_at__lt=upper
+    ).filter(Q(signal__in=signals) | Q(action_plan_execution__in=actions))
+    result = {
+        "captured_at": timezone.now().isoformat(),
+        "period": {"start": str(start), "end": str(end), "timezone": zone_name},
+        "note": (
+            "Les statuts sont ceux au moment de la capture, pas une reconstruction historique. "
+            "Aucun chat privé ni photo brute n’est inclus."
+        ),
+        "establishment": m.establishment.name,
+        "observations": rows(
+            observations,
+            [
+                "id",
+                "submitted_at",
+                "raw_text",
+                "submitted_by_membership_id",
+                "processing__status",
+                "processing__outcome",
+                "processing__processed_at",
+                "action_plan_execution_id",
+                "action_plan_execution_task_id",
+            ],
+        ),
+        "signals": rows(
+            signals, ["id", "title", "structured_summary", "status", "created_at", "updated_at"]
+        ),
+        "actions": rows(
+            actions,
+            [
+                "id",
+                "title",
+                "description",
+                "status",
+                "start_at",
+                "end_at",
+                "created_at",
+                "updated_at",
+            ],
+        ),
+        "comments": rows(
+            comments,
+            [
+                "id",
+                "signal_id",
+                "action_plan_execution_id",
+                "body",
+                "created_at",
+                "author_membership_id",
+            ],
+        ),
+        "tasks": rows(
+            ActionPlanExecutionTask.objects.filter(action_plan_execution__in=actions),
+            [
+                "id",
+                "action_plan_execution_id",
+                "task",
+                "description",
+                "status",
+                "deadline_at",
+                "assigned_membership_id",
+            ],
+        ),
+        "reviews": rows(
+            ActionPlanExecutionReview.objects.filter(
+                action_plan_execution__in=actions, reviewed_at__gte=lower, reviewed_at__lt=upper
+            ),
+            ["id", "action_plan_execution_id", "stars", "comment", "reviewed_at"],
+        ),
+        "events": rows(
+            ActionPlanExecutionLifecycleEvent.objects.filter(
+                action_plan_execution__in=actions, created_at__gte=lower, created_at__lt=upper
+            ),
+            ["id", "action_plan_execution_id", "event_type", "created_at"],
+        ),
+        "business_units": rows(
+            BusinessUnit.objects.filter(establishment=m.establishment),
+            ["id", "specific_name", "instance_description"],
+        ),
+    }
+    from houston.signals.models import SignalSourceObservation
+
+    titles = {}
+    linked_signals = {}
+    for observation_id, title, signal_id, status in (
+        SignalSourceObservation.objects.filter(
+            observation__in=observations, signal__establishment=m.establishment
+        )
+        .order_by("created_at", "id")
+        .values_list("observation_id", "signal__title", "signal_id", "signal__status")
+    ):
+        titles.setdefault(str(observation_id), title)
+        linked_signals.setdefault(str(observation_id), []).append(
+            {"id": str(signal_id), "title": title, "status": status}
+        )
+    for row in result["observations"]:
+        row["linked_subjects"] = linked_signals.get(row["id"], [])
+        row["title"] = titles.get(row["id"], " ".join(row["raw_text"].split())[:100])
+        row["observed_at_local"] = (
+            datetime.fromisoformat(row["submitted_at"]).astimezone(zone).isoformat()
+        )
+    from houston.establishments.models import EstablishmentMembership
+
+    author_fields = {
+        "observations": "submitted_by_membership_id",
+        "comments": "author_membership_id",
+        "tasks": "assigned_membership_id",
+    }
+    member_ids = {
+        row.get(field) for kind, field in author_fields.items() for row in result[kind]
+    } - {None}
+    names = {
+        str(person.id): narrative_name(person)
+        for person in EstablishmentMembership.objects.filter(
+            establishment=m.establishment, id__in=member_ids
+        ).select_related("user")
+    }
+    for kind, field in author_fields.items():
+        for row in result[kind]:
+            row["person_name"] = names.get(row.get(field), "Personne non renseignée")
+    assignees = action_people(m.establishment_id, [row["id"] for row in result["actions"]])
+    for row in result["actions"]:
+        row["responsible_people"] = assignees.get(row["id"], [])
+    team = action_options(m.user, m.establishment_id)
+    result["team"] = team["members"]
+    roles = dict(
+        EstablishmentMembership.objects.filter(
+            establishment=m.establishment, id__in=[person["id"] for person in result["team"]]
+        ).values_list("id", "role")
+    )
+    roles = {str(key): value for key, value in roles.items()}
+    for person in result["team"]:
+        person["role"] = roles.get(person["id"], "staff")
+        if "@" in person["name"]:
+            person["name"] = "Membre sans nom renseigné"
+    result["team_note"] = (
+        "Personnes et périmètres actuels, pour proposer des étapes à confirmer ; "
+        "aucune nouvelle affectation n’est déjà décidée."
+    )
+    description = getattr(m.establishment, "activity_description", None)
+    result["description"] = description.description if description else ""
+    if len(json.dumps(result, ensure_ascii=False)) > 200000:
+        raise ValidationError("Le contexte terrain est trop volumineux. Réduisez la période.")
+    return result
+
+
+def public(c):
+    from .goal_selectors import public_review
+    from .models import GoalReview
+    from .references import catalog, public_sources, referenced_ids
+
+    reviews = {}
+    for review in GoalReview.objects.filter(message__conversation=c).order_by("created_at", "id"):
+        reviews.setdefault(review.message_id, []).append(public_review(review))
+
+    suggestions = {}
+    for s in (
+        ActionSuggestion.objects.filter(message__conversation=c)
+        .select_related("execution")
+        .order_by("position", "created_at", "id")
+    ):
+        suggestions.setdefault(s.message_id, []).append(public_suggestion(s))
+    all_messages = list(c.messages.select_related("author__user"))
+    current_reports = [
+        {"id": "report:" + str(r.id), "name": r.name, "text": r.text} for r in c.reports.all()
+    ]
+    entries = {}
+    needed = {}
+    for msg in all_messages:
+        ids = referenced_ids(msg.text) if msg.role == "assistant" else set()
+        for insight in msg.presentation.get("insights", []):
+            ids.update(insight.get("sources", []))
+            ids.update(
+                referenced_ids(insight.get("finding", "") + " " + insight.get("terrain", ""))
+            )
+        for review in reviews.get(msg.id, []):
+            ids.update(review["sources"])
+        source_catalog = catalog(c.snapshot, msg.memory_snapshot, current_reports)
+        needed[msg.id] = ids & source_catalog.keys()
+        entries.update({key: source_catalog[key] for key in needed[msg.id]})
+    sources = public_sources(c.establishment_id, entries)
+    messages = []
+    for msg in all_messages:
+        memory = msg.memory_snapshot
+        messages.append(
+            {
+                "id": str(msg.id),
+                "role": msg.role,
+                "text": msg.text,
+                "insights": msg.presentation.get("insights", []),
+                "sources": [sources[key] for key in sorted(needed[msg.id])],
+                "status": msg.status,
+                "created_at": msg.created_at,
+                "author_name": membership_display_name(msg.author) if msg.author else "Spore Brain",
+                "context": msg.context_snapshot,
+                "memory": {
+                    "captured_at": memory.get("captured_at"),
+                    "coverage": memory.get("coverage", {}),
+                    "analyses": [
+                        {k: a[k] for k in ("id", "title", "start", "end")}
+                        for a in memory.get("analyses", [])
+                    ],
+                },
+                "action_suggestions": suggestions.get(msg.id, []),
+                "goal_reviews": reviews.get(msg.id, []),
+            }
+        )
+    return {
+        "id": str(c.id),
+        "title": c.title,
+        "start": str(c.start),
+        "end": str(c.end),
+        "status": c.status,
+        "error": c.error,
+        "reports": list(c.reports.values("id", "name", "digest")),
+        "coverage": {
+            k: len(c.snapshot.get(k, []))
+            for k in ("observations", "signals", "actions", "comments")
+        },
+        "captured_at": c.snapshot.get("captured_at"),
+        "messages": messages,
+    }
diff --git a/apps/api/houston/brain/services.py b/apps/api/houston/brain/services.py
new file mode 100644
index 0000000..1ab882b
--- /dev/null
+++ b/apps/api/houston/brain/services.py
@@ -0,0 +1,399 @@
+import json
+from datetime import timedelta
+
+from django.db import transaction
+from django.db.models import Q
+from django.utils import timezone
+from rest_framework.exceptions import ValidationError
+
+from houston.accounts.legal_services import require_current_ai_consent, require_current_terms
+
+from . import memory, permissions, selectors
+from .errors import failure_message
+from .extraction import extract
+from .models import (
+    ActionSuggestion,
+    BrainSettings,
+    BrainVersion,
+    Conversation,
+    EstablishmentContext,
+    Mechanism,
+    Message,
+    Report,
+)
+from .runtime_limits import QUEUE_WAIT_SECONDS
+
+
+@transaction.atomic
+def set_establishment_context(user, site, text):
+    m = permissions.member(user, site)
+    if not isinstance(text, str) or len(text) > 6000:
+        raise ValidationError("Le contexte doit contenir au maximum 6 000 caractères.")
+    EstablishmentContext.objects.update_or_create(
+        establishment_id=m.establishment_id,
+        defaults={"text": text.strip(), "updated_by": user},
+    )
+    return selectors.establishment_context(user, site)
+
+
+def valid_config(knowledge, prompt):
+    if not isinstance(knowledge, dict) or len(json.dumps(knowledge)) > 128000:
+        raise ValidationError("JSON métier : objet requis, 128 000 caractères maximum.")
+    from .knowledge import validate
+
+    try:
+        validate(knowledge)
+    except ValueError as exc:
+        raise ValidationError(str(exc)) from exc
+    if not isinstance(prompt, str) or not 20 <= len(prompt) <= 16000:
+        raise ValidationError("Le prompt doit contenir entre 20 et 16 000 caractères.")
+
+
+@transaction.atomic
+def version(user, label, knowledge, prompt):
+    permissions.administrator(user)
+    valid_config(knowledge, prompt)
+    return BrainVersion.objects.create(
+        label=label[:120], knowledge=knowledge, prompt=prompt, created_by=user
+    )
+
+
+@transaction.atomic
+def activate(user, pk):
+    permissions.administrator(user)
+    v = BrainVersion.objects.get(pk=pk)
+    s, _ = BrainSettings.objects.get_or_create(pk=1)
+    s = BrainSettings.objects.select_for_update().get(pk=s.pk)
+    s.active = v
+    s.save()
+
+
+def consent(m):
+    require_current_terms(user=m.user)
+    require_current_ai_consent(user=m.user)
+
+
+def enqueue(message_id):
+    from .tasks import analyze_message
+
+    try:
+        analyze_message.delay(str(message_id))
+    except Exception as error:
+        fail(message_id, error=error, stage="queue")
+
+
+def create(user, site, title, start, end, files):
+    m = permissions.member(user, site)
+    consent(m)
+    if end < start or (end - start).days > 366:
+        raise ValidationError("Choisissez une période comprise entre 1 et 367 jours.")
+    if not 1 <= len(files) <= 5:
+        raise ValidationError("Importez entre 1 et 5 reportings.")
+    s = BrainSettings.objects.select_related("active").filter(pk=1).first()
+    if not s or not s.active:
+        raise ValidationError("Spore Brain n’est pas encore configuré par votre administrateur.")
+    docs = [extract(f) for f in files]
+    if sum(len(d["text"]) for d in docs) > 100000:
+        raise ValidationError("Les reportings sont trop volumineux. Importez un extrait pertinent.")
+    context = selectors.snapshot(m, start, end)
+    with transaction.atomic():
+        c = Conversation.objects.create(
+            establishment=m.establishment,
+            membership=m,
+            version=s.active,
+            title=title[:160],
+            start=start,
+            end=end,
+            snapshot=context,
+            status="queued",
+        )
+        for d in docs:
+            Report.objects.create(conversation=c, **d)
+        msg = Message.objects.create(
+            conversation=c,
+            role="user",
+            text=(
+                "Analyse ces reportings en les croisant avec les données terrain "
+                "de la période confirmée."
+            ),
+            status="queued",
+            context_snapshot=selectors.establishment_context(user, site)["text"],
+            author=m,
+            memory_snapshot=memory.capture(
+                user, site, exclude_conversation=c.id, start=c.start, end=c.end
+            ),
+        )
+        transaction.on_commit(lambda: enqueue(msg.id))
+    return c
+
+
+@transaction.atomic
+def ask(user, site, pk, text, request_id):
+    old = selectors.conversation(user, site, pk)
+    m = permissions.member(user, site)
+    consent(m)
+    c = Conversation.objects.select_for_update().get(pk=old.pk)
+    if c.messages.filter(request_id=request_id).exists():
+        return c
+    if c.status in ("queued", "running"):
+        raise ValidationError("Une analyse est déjà en cours.")
+    if (
+        c.messages.count() >= 40
+        or sum(len(t) for t in c.messages.values_list("text", flat=True)) > 120000
+    ):
+        raise ValidationError("Cette conversation a atteint sa limite. Créez une nouvelle analyse.")
+    if not text.strip() or len(text) > 4000:
+        raise ValidationError("Question requise, 4 000 caractères maximum.")
+    msg = Message.objects.create(
+        conversation=c,
+        role="user",
+        text=text.strip(),
+        request_id=request_id,
+        status="queued",
+        context_snapshot=selectors.establishment_context(user, site)["text"],
+        author=m,
+        memory_snapshot=memory.capture(
+            user, site, exclude_conversation=c.id, start=c.start, end=c.end
+        ),
+    )
+    c.status = "queued"
+    c.error = ""
+    c.save()
+    transaction.on_commit(lambda: enqueue(msg.id))
+    return c
+
+
+@transaction.atomic
+def expire_stale(c):
+    locked = Conversation.objects.select_for_update().get(pk=c.pk)
+    now = timezone.now()
+    stale = locked.messages.filter(
+        Q(status="running", updated_at__lt=now - timedelta(minutes=5))
+        | Q(status="queued", updated_at__lt=now - timedelta(seconds=QUEUE_WAIT_SECONDS))
+    )
+    if locked.status in ("queued", "running") and stale.exists():
+        stale.update(status="failed")
+        locked.status = "failed"
+        locked.error = "Le traitement a expiré. Vous pouvez demander une nouvelle analyse."
+        locked.save()
+    return locked
+
+
+def run(message_id):
+    from .provider import analyze
+
+    stage = "access"
+    try:
+        conversation_id = (
+            Message.objects.filter(pk=message_id).values_list("conversation_id", flat=True).first()
+        )
+        if conversation_id is None:
+            return
+        with transaction.atomic():
+            c = (
+                Conversation.objects.select_for_update(of=("self",))
+                .select_related("version", "membership__user")
+                .get(pk=conversation_id)
+            )
+            msg = (
+                Message.objects.select_for_update(of=("self",))
+                .select_related("author__user")
+                .get(pk=message_id)
+            )
+            if msg.status != "queued":
+                return
+            if not msg.author or msg.author.establishment_id != c.establishment_id:
+                raise ValidationError("Auteur de la demande introuvable.")
+            m = permissions.member(msg.author.user, c.establishment_id)
+            consent(m)
+            msg.status = "running"
+            msg.save()
+            c.status = "running"
+            c.save()
+        stage = "analysis"
+
+        def progress():
+            # Renew the existing stale-work lease between bounded provider calls.
+            # A cancelled/expired job must stop without further provider calls or writes.
+            from .errors import BrainResponseError
+
+            if not Message.objects.filter(pk=msg.pk, status="running").update(
+                updated_at=timezone.now()
+            ):
+                raise BrainResponseError("access_changed")
+
+        result = analyze(
+            c,
+            establishment_context=msg.context_snapshot,
+            memory=msg.memory_snapshot,
+            progress=progress,
+        )
+        from .references import catalog
+
+        source_catalog = catalog(
+            c.snapshot,
+            msg.memory_snapshot,
+            [
+                {"id": "report:" + str(r.id), "name": r.name, "text": r.text}
+                for r in c.reports.all()
+            ],
+        )
+        from .evidence_services import prepare_insight
+        from .goal_services import save_reviews
+
+        insights = [prepare_insight(item, source_catalog, c.snapshot) for item in result.insights]
+        # Reject invented evidence from the private learning queue.
+        evidence = {r.name for r in c.reports.all()}
+        evidence.update("report:" + str(r.id) for r in c.reports.all())
+        evidence.update(row["id"] for row in msg.memory_snapshot.get("report_history", []))
+        for key in (
+            "observations",
+            "signals",
+            "actions",
+            "comments",
+            "tasks",
+            "reviews",
+            "events",
+            "business_units",
+        ):
+            evidence.update(str(x["id"]) for x in c.snapshot.get(key, []))
+        stage = "save"
+        with transaction.atomic():
+            c = Conversation.objects.select_for_update().get(pk=c.pk)
+            locked = Message.objects.select_for_update().get(pk=msg.pk)
+            if locked.status != "running":
+                return
+            current_actor = permissions.member(msg.author.user, c.establishment_id)
+            consent(current_actor)
+            answer = Message.objects.create(
+                conversation=c,
+                role="assistant",
+                text=result.answer,
+                presentation={
+                    "version": 1,
+                    "insights": insights,
+                    "actions": [a.model_dump(mode="json") for a in result.actions],
+                },
+                context_snapshot=msg.context_snapshot,
+                memory_snapshot=msg.memory_snapshot,
+            )
+            from houston.establishments.models import BusinessUnit
+
+            unit_ids = set(
+                BusinessUnit.objects.filter(
+                    establishment_id=c.establishment_id, active=True
+                ).values_list("id", flat=True)
+            )
+            for position, draft in enumerate(result.actions):
+                ActionSuggestion.objects.create(
+                    message=answer,
+                    title=draft.title,
+                    description=draft.description,
+                    tasks=draft.tasks,
+                    kpi_objective=draft.kpi_objective.model_dump(mode="json"),
+                    position=position,
+                    pilot_business_unit_id=(
+                        draft.pilot_business_unit_id
+                        if draft.pilot_business_unit_id in unit_ids
+                        else None
+                    ),
+                    suggested_due_days=draft.suggested_due_days,
+                )
+            learning = {
+                "knowledge_retrieval": result._retrieval_trace,
+                "reason": result.learning_review
+                or "La recherche n’a pas été détaillée par le modèle.",
+                "generated": len(result.proposals),
+                "created": 0,
+                "discarded": [],
+            }
+            save_reviews(
+                answer,
+                msg.memory_snapshot.get("due_kpi_reviews", []),
+                result.goal_reviews,
+                source_catalog,
+            )
+            for proposal in result.proposals:
+                if proposal.evidence and all(x in evidence for x in proposal.evidence):
+                    Mechanism.objects.create(
+                        conversation=c, message=answer, proposal=proposal.model_dump()
+                    )
+                    learning["created"] += 1
+                else:
+                    learning["discarded"].append(
+                        {
+                            "mechanism": proposal.mechanism,
+                            "reason": (
+                                "Preuves absentes ou références non reconnues "
+                                "dans les données de cette analyse."
+                            ),
+                        }
+                    )
+            answer.presentation["learning"] = learning
+            answer.save(update_fields=["presentation", "updated_at"])
+            msg.status = "done"
+            msg.save()
+            c.status = "ready"
+            c.error = ""
+            c.summary = result.memory_summary
+            c.last_analyzed_at = timezone.now()
+            c.save()
+    except Exception as error:
+        fail(message_id, error=error, stage=stage)
+
+
+@transaction.atomic
+def fail(message_id, *, error=None, stage="processing"):
+    msg = Message.objects.filter(pk=message_id).first()
+    if not msg:
+        return
+    c = Conversation.objects.select_for_update().get(pk=msg.conversation_id)
+    msg = Message.objects.select_for_update().get(pk=msg.pk)
+    if msg.status not in ("queued", "running"):
+        return
+    msg.status = "failed"
+    msg.save()
+    c.status = "failed"
+    c.error = failure_message(error, message_id=message_id, stage=stage)
+    c.save()
+
+
+@transaction.atomic
+def review(user, pk, decision, edited=None):
+    permissions.administrator(user)
+    p = Mechanism.objects.select_for_update().get(pk=pk)
+    if p.status != "pending":
+        raise ValidationError("Ce mécanisme a déjà été examiné.")
+    if decision == "approve":
+        from .provider import Proposal
+
+        # Human edits produce only reusable mechanics, not a copy of client evidence.
+        item = Proposal.model_validate(edited)
+        if item.evidence:
+            raise ValidationError(
+                "Retirez les preuves client du mécanisme partagé. Elles restent dans la "
+                "proposition privée."
+            )
+        s = BrainSettings.objects.select_for_update(of=("self",)).select_related("active").get(pk=1)
+        if not s.active:
+            raise ValidationError("Activez d’abord un référentiel.")
+        data = json.loads(json.dumps(s.active.knowledge))
+        if not isinstance(data.get("learned_mechanisms", []), list):
+            raise ValidationError("learned_mechanisms doit être une liste.")
+        data.setdefault("learned_mechanisms", []).append(item.model_dump(exclude={"evidence"}))
+        valid_config(data, s.active.prompt)
+        v = BrainVersion.objects.create(
+            label="Validation " + str(p.id)[:8],
+            knowledge=data,
+            prompt=s.active.prompt,
+            created_by=user,
+        )
+        s.active = v
+        s.save()
+        p.approved_version = v
+    elif decision != "reject":
+        raise ValidationError("Décision invalide.")
+    p.status = "approved" if decision == "approve" else "rejected"
+    p.reviewed_by = user
+    p.reviewed_at = timezone.now()
+    p.save()
