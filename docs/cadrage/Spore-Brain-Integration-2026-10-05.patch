+import io
+import unittest
+
+from django.core.files.uploadedfile import SimpleUploadedFile
+from rest_framework.exceptions import ValidationError
+
+from houston.brain.extraction import extract
+
+
+class ExtractionTests(unittest.TestCase):
+    def test_empty_workbook_and_bad_encoding_explain_the_problem(self):
+        from openpyxl import Workbook
+
+        buffer = io.BytesIO()
+        Workbook().save(buffer)
+        with self.assertRaisesRegex(ValidationError, "Aucune valeur lisible"):
+            extract(SimpleUploadedFile("vide.xlsx", buffer.getvalue()))
+        with self.assertRaisesRegex(ValidationError, "UTF-8"):
+            extract(SimpleUploadedFile("ancien.csv", b"CA\n\xff"))
+
+    def test_large_csv_is_rejected_before_parsing_rows(self):
+        from unittest.mock import patch
+
+        with patch("houston.brain.extraction.csv.reader") as reader:
+            with self.assertRaisesRegex(ValidationError, "trop de texte"):
+                extract(SimpleUploadedFile("large.csv", b"x" * 80001))
+        reader.assert_not_called()
+
+    def test_csv_preserves_numbers(self):
+        result = extract(SimpleUploadedFile("test.csv", b"jour;CA\n01/09;1234,50"))
+        self.assertIn("1234,50", result["text"])
+
+    def test_empty_and_unsupported_are_rejected(self):
+        for name, content in [("x.csv", b""), ("x.exe", b"hello"), ("x.pdf", b"not pdf")]:
+            with self.assertRaises(ValidationError):
+                extract(SimpleUploadedFile(name, content))
+
+    def test_xlsx_extracts_sheet_and_values(self):
+        from openpyxl import Workbook
+
+        book = Workbook()
+        book.active.append(["CA", 123.5])
+        b = io.BytesIO()
+        book.save(b)
+        self.assertIn("123.5", extract(SimpleUploadedFile("test.xlsx", b.getvalue()))["text"])
+
+    def test_blank_scanned_pdf_does_not_silently_pass(self):
+        from pypdf import PdfWriter
+
+        writer = PdfWriter()
+        writer.add_blank_page(width=100, height=100)
+        b = io.BytesIO()
+        writer.write(b)
+        with self.assertRaises(ValidationError):
+            extract(SimpleUploadedFile("scan.pdf", b.getvalue()))
