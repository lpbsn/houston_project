+++ b/apps/web/src/features/brain/action-suggestion.test.tsx
@@ -0,0 +1,176 @@
+// @vitest-environment jsdom
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { brainApi, type ActionSuggestion } from './api'
+import { ActionSuggestionCard } from './action-suggestion'
+
+vi.mock('./api', () => ({
+  brainApi: { actionOptions: vi.fn(), convert: vi.fn() },
+}))
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+})
+const suggestion: ActionSuggestion = {
+  id: 's1',
+  title: 'Mieux convertir',
+  description: 'Comprendre la conversion',
+  tasks: ['Mesurer le flux'],
+  pilot_business_unit_id: 'bu1',
+  suggested_due_days: 7,
+  kpi_objective: null,
+  execution: null,
+  converted_at: null,
+}
+const options = {
+  timezone: 'Europe/Paris',
+  business_units: [
+    { id: 'bu1', name: 'Restaurant' },
+    { id: 'bu2', name: 'Loisirs' },
+  ],
+  members: [
+    { id: 'm1', name: 'Julien', business_unit_ids: ['bu1'] },
+    { id: 'm2', name: 'Adèle', business_unit_ids: ['bu2'] },
+  ],
+}
+function mount(value = suggestion) {
+  const navigate = vi.fn()
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false } },
+  })
+  const view = render(
+    <QueryClientProvider client={client}>
+      <ActionSuggestionCard
+        suggestion={value}
+        site="site-a"
+        onNavigate={navigate}
+      />
+    </QueryClientProvider>,
+  )
+  return { navigate, view, client }
+}
+async function fill() {
+  fireEvent.click(screen.getByRole('button', { name: 'Créer dans Spore' }))
+  await screen.findByRole('option', { name: 'Julien' })
+  fireEvent.change(screen.getByLabelText('Responsable'), {
+    target: { value: 'm1' },
+  })
+  fireEvent.change(screen.getByLabelText('Échéance'), {
+    target: { value: '2026-10-20' },
+  })
+}
+
+describe('Propositions Brain vers Exécution', () => {
+  it('ne crée rien avant confirmation et utilise le formulaire modifié', async () => {
+    vi.mocked(brainApi.actionOptions).mockResolvedValue(options)
+    vi.mocked(brainApi.convert).mockResolvedValue({
+      ...suggestion,
+      converted_at: '2026-10-01T12:00:00Z',
+      execution: {
+        id: 'e1',
+        title: 'Titre modifié',
+        status: 'in_progress',
+        deadline: null,
+      },
+    })
+    const { navigate } = mount()
+    expect(brainApi.convert).not.toHaveBeenCalled()
+    await fill()
+    expect(screen.queryByRole('option', { name: 'Adèle' })).toBeNull()
+    expect(brainApi.convert).not.toHaveBeenCalled()
+    fireEvent.change(screen.getByLabelText('Titre'), {
+      target: { value: 'Titre modifié' },
+    })
+    fireEvent.click(
+      screen.getByRole('button', { name: 'Confirmer la création' }),
+    )
+    fireEvent.click(
+      await screen.findByRole('button', { name: /Ouvrir le plan dans Spore/ }),
+    )
+    expect(brainApi.convert).toHaveBeenCalledWith(
+      'site-a',
+      's1',
+      expect.objectContaining({
+        title: 'Titre modifié',
+        responsible_membership_id: 'm1',
+        deadline: '2026-10-20',
+        tasks: ['Mesurer le flux'],
+      }),
+    )
+    expect(navigate).toHaveBeenCalledWith('/e/site-a/execution/e1')
+  })
+  it('permet de corriger après échec sans afficher de faux succès', async () => {
+    vi.mocked(brainApi.actionOptions).mockResolvedValue(options)
+    vi.mocked(brainApi.convert).mockRejectedValue(
+      new Error('Vérifiez le responsable'),
+    )
+    mount()
+    await fill()
+    fireEvent.click(
+      screen.getByRole('button', { name: 'Confirmer la création' }),
+    )
+    await screen.findByRole('alert')
+    expect(screen.queryByRole('button', { name: /Ouvrir le plan/ })).toBeNull()
+    expect(
+      (screen.getByLabelText('Responsable') as HTMLSelectElement).value,
+    ).toBe('m1')
+  })
+  it('un plan déjà créé reste lié à son état courant et ne propose pas de recréation', () => {
+    mount({
+      ...suggestion,
+      converted_at: '2026-10-01T12:00:00Z',
+      execution: {
+        id: 'e1',
+        title: suggestion.title,
+        status: 'pending_validation',
+        deadline: null,
+      },
+    })
+    expect(screen.getByText('En attente de validation')).toBeTruthy()
+    expect(
+      screen.queryByRole('button', { name: 'Créer dans Spore' }),
+    ).toBeNull()
+    expect(brainApi.actionOptions).not.toHaveBeenCalled()
+  })
+})
+
+it('affiche la date de bilan KPI et conserve la date confirmée dans le plan', async () => {
+  const objective = {
+    name: 'Attente',
+    baseline: '22 minutes',
+    target: '15 minutes',
+    horizon: 'Deux semaines de mesure',
+    measurement: 'Médiane par service',
+    review_date: '2026-10-25',
+  }
+  const dated = { ...suggestion, kpi_objective: objective }
+  vi.mocked(brainApi.actionOptions).mockResolvedValue(options)
+  vi.mocked(brainApi.convert).mockResolvedValue({
+    ...dated,
+    converted_at: '2026-10-01T12:00:00Z',
+    execution: {
+      id: 'e1',
+      title: dated.title,
+      status: 'in_progress',
+      deadline: null,
+    },
+  })
+  mount(dated)
+  expect(screen.getByText('Bilan KPI le 25/10/2026')).toBeTruthy()
+  await fill()
+  fireEvent.click(screen.getByText('Modifier l’objectif KPI'))
+  fireEvent.change(screen.getByLabelText('Date du bilan KPI'), {
+    target: { value: '2026-10-28' },
+  })
+  fireEvent.click(screen.getByRole('button', { name: 'Confirmer la création' }))
+  await screen.findByRole('button', { name: /Ouvrir le plan dans Spore/ })
+  expect(brainApi.convert).toHaveBeenCalledWith(
+    'site-a',
+    's1',
+    expect.objectContaining({
+      deadline: '2026-10-20',
+      kpi_objective: { ...objective, review_date: '2026-10-28' },
+    }),
+  )
+})
diff --git a/apps/web/src/features/brain/action-suggestion.tsx b/apps/web/src/features/brain/action-suggestion.tsx
new file mode 100644
index 0000000..4a91246
--- /dev/null
+++ b/apps/web/src/features/brain/action-suggestion.tsx
@@ -0,0 +1,361 @@
+import { useState } from 'react'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { ArrowUpRight, Check, Plus, Trash2 } from 'lucide-react'
+import { brainApi, type ActionSuggestion } from './api'
+import { BrainDialog } from './brain-dialog'
+import { ObjectiveCard } from './objective-card'
+
+const labels: Record<string, string> = {
+  scheduled: 'Planifié',
+  in_progress: 'En cours',
+  pending_validation: 'En attente de validation',
+  done: 'Terminé',
+  canceled: 'Annulé',
+}
+
+export function ActionSuggestionCard({
+  suggestion,
+  site,
+  onNavigate,
+}: {
+  suggestion: ActionSuggestion
+  site: string
+  onNavigate: (path: string) => void
+}) {
+  const [editing, setEditing] = useState(false)
+  const cache = useQueryClient()
+  const options = useQuery({
+    queryKey: ['brain-action-options', site],
+    queryFn: () => brainApi.actionOptions(site),
+    enabled: editing,
+    retry: false,
+  })
+  const [title, setTitle] = useState(suggestion.title)
+  const [description, setDescription] = useState(suggestion.description)
+  const [tasks, setTasks] = useState(suggestion.tasks)
+  const [unit, setUnit] = useState(suggestion.pilot_business_unit_id ?? '')
+  const [responsible, setResponsible] = useState('')
+  const [deadline, setDeadline] = useState('')
+  const [validation, setValidation] = useState(true)
+  const [objective, setObjective] = useState(suggestion.kpi_objective ?? null)
+  const conversion = useMutation({
+    mutationFn: () =>
+      brainApi.convert(site, suggestion.id, {
+        title,
+        description,
+        tasks,
+        pilot_business_unit_id: unit,
+        responsible_membership_id: responsible,
+        deadline,
+        requires_validation: validation,
+        ...(suggestion.objective_decision?.status === 'rejected'
+          ? {}
+          : suggestion.objective_decision?.status === 'validated'
+            ? { kpi_objective: suggestion.kpi_objective! }
+            : objective
+              ? { kpi_objective: objective }
+              : {}),
+      }),
+    onSuccess: () => {
+      setEditing(false)
+      void cache.invalidateQueries({ queryKey: ['brain', site] })
+      void cache.invalidateQueries({ queryKey: ['action-plans'] })
+    },
+  })
+  const current = suggestion.converted_at
+    ? suggestion
+    : (conversion.data ?? suggestion)
+  const eligible =
+    options.data?.members.filter((m) => m.business_unit_ids.includes(unit)) ??
+    []
+
+  return (
+    <section
+      className="brain-action-card"
+      aria-label={`Proposition : ${current.title}`}
+    >
+      <div className="brain-action-label">
+        {current.execution ? <Check size={16} /> : <Plus size={16} />}
+        {current.execution ? 'PLAN CRÉÉ DANS SPORE' : 'PROPOSITION D’ACTION'}
+      </div>
+      <h3>
+        <button
+          className="brain-plan-title"
+          disabled={!!current.converted_at && !current.execution}
+          onClick={() =>
+            current.execution
+              ? onNavigate(`/e/${site}/execution/${current.execution.id}`)
+              : setEditing(true)
+          }
+        >
+          {current.title}
+          <ArrowUpRight size={18} />
+        </button>
+      </h3>
+      <div className="brain-plan-steps">
+        <b>{current.tasks.length > 1 ? 'Étapes' : 'À faire'}</b>
+        <ol>
+          {current.tasks.map((task, i) => (
+            <li key={i}>{task}</li>
+          ))}
+        </ol>
+      </div>
+      <ObjectiveCard suggestion={current} site={site} />
+      {current.execution ? (
+        <>
+          <p className="brain-action-status">
+            {labels[current.execution.status] ?? current.execution.status}
+            {current.execution.deadline
+              ? ` · Échéance : ${new Date(current.execution.deadline).toLocaleDateString('fr-FR')}`
+              : ''}
+          </p>
+          <button
+            onClick={() =>
+              onNavigate(`/e/${site}/execution/${current.execution!.id}`)
+            }
+          >
+            Ouvrir le plan dans Spore <ArrowUpRight size={16} />
+          </button>
+        </>
+      ) : current.converted_at ? (
+        <p>Le plan lié a été supprimé.</p>
+      ) : (
+        <button className="brain-primary" onClick={() => setEditing(true)}>
+          Créer dans Spore <ArrowUpRight size={16} />
+        </button>
+      )}
+      <BrainDialog
+        open={editing}
+        onOpenChange={setEditing}
+        title="Créer ce plan dans Spore"
+        busy={conversion.isPending}
+      >
+        <form
+          className="brain-action-form"
+          onSubmit={(e) => {
+            e.preventDefault()
+            conversion.mutate()
+          }}
+        >
+          <p>Choisissez le responsable et l’échéance, puis confirmez.</p>
+          {objective &&
+            (suggestion.objective_decision?.status ?? 'proposed') ===
+              'proposed' && (
+              <p>
+                La confirmation validera aussi l’objectif KPI et sa date de
+                bilan.
+              </p>
+            )}
+          {options.isPending && (
+            <p role="status">Chargement des pôles et de l’équipe…</p>
+          )}
+          {options.isError && <p role="alert">{options.error.message}</p>}
+          <fieldset disabled={conversion.isPending}>
+            <label>
+              Titre
+              <input
+                required
+                maxLength={200}
+                value={title}
+                onChange={(e) => setTitle(e.target.value)}
+              />
+            </label>
+            <label>
+              Objectif et description
+              <textarea
+                rows={3}
+                maxLength={600}
+                value={description}
+                onChange={(e) => setDescription(e.target.value)}
+              />
+            </label>
+            <div className="brain-dates">
+              <label>
+                Pôle concerné
+                <select
+                  required
+                  value={unit}
+                  onChange={(e) => {
+                    setUnit(e.target.value)
+                    setResponsible('')
+                  }}
+                >
+                  <option value="">Choisir un pôle</option>
+                  {options.data?.business_units.map((b) => (
+                    <option key={b.id} value={b.id}>
+                      {b.name}
+                    </option>
+                  ))}
+                </select>
+              </label>
+              <label>
+                Responsable
+                <select
+                  required
+                  value={responsible}
+                  onChange={(e) => setResponsible(e.target.value)}
+                >
+                  <option value="">Choisir une personne</option>
+                  {eligible.map((m) => (
+                    <option key={m.id} value={m.id}>
+                      {m.name}
+                    </option>
+                  ))}
+                </select>
+              </label>
+            </div>
+            {unit && options.data && !eligible.length && (
+              <p>
+                Aucun responsable disponible pour ce pôle. Vérifiez les
+                affectations de l’équipe.
+              </p>
+            )}
+            <label>
+              Échéance
+              <input
+                type="date"
+                required
+                value={deadline}
+                onChange={(e) => setDeadline(e.target.value)}
+              />
+            </label>
+            <small>
+              Fin de journée dans le fuseau de l’établissement :{' '}
+              {options.data?.timezone || '…'}.
+              {current.suggested_due_days
+                ? ` Brain suggère un délai de ${current.suggested_due_days} jours, à confirmer.`
+                : ''}
+            </small>
+            {objective &&
+              suggestion.objective_decision?.status !== 'validated' &&
+              suggestion.objective_decision?.status !== 'rejected' && (
+                <details className="brain-objective-edit">
+                  <summary>Modifier l’objectif KPI</summary>
+                  {(
+                    [
+                      'name',
+                      'baseline',
+                      'target',
+                      'horizon',
+                      'measurement',
+                    ] as const
+                  ).map((key) => (
+                    <label key={key}>
+                      {
+                        {
+                          name: 'KPI suivi',
+                          baseline: 'Point de départ',
+                          target: 'Cible visée',
+                          horizon: 'Horizon de mesure',
+                          measurement: 'Comment mesurer',
+                        }[key]
+                      }
+                      <input
+                        required
+                        value={objective[key]}
+                        maxLength={
+                          {
+                            name: 120,
+                            baseline: 240,
+                            target: 240,
+                            horizon: 120,
+                            measurement: 350,
+                          }[key]
+                        }
+                        onChange={(e) =>
+                          setObjective({ ...objective, [key]: e.target.value })
+                        }
+                      />
+                    </label>
+                  ))}
+                  <label>
+                    Date du bilan KPI
+                    <input
+                      type="date"
+                      value={objective.review_date ?? ''}
+                      required={!!suggestion.kpi_objective?.review_date}
+                      onChange={(e) =>
+                        setObjective({
+                          ...objective,
+                          review_date: e.target.value || null,
+                        })
+                      }
+                    />
+                  </label>
+                  <small>
+                    Date de mesure de l’impact, distincte de l’échéance de
+                    réalisation.
+                  </small>
+                </details>
+              )}
+            <div className="brain-action-tasks">
+              {tasks.map((task, i) => (
+                <div className="brain-task-edit" key={i}>
+                  <label>
+                    Étape {i + 1}
+                    <textarea
+                      required
+                      maxLength={500}
+                      rows={2}
+                      value={task}
+                      onChange={(e) =>
+                        setTasks(
+                          tasks.map((t, k) => (k === i ? e.target.value : t)),
+                        )
+                      }
+                    />
+                  </label>
+                  <button
+                    type="button"
+                    aria-label={`Supprimer l’étape ${i + 1}`}
+                    disabled={tasks.length === 1}
+                    onClick={() => setTasks(tasks.filter((_, k) => k !== i))}
+                  >
+                    <Trash2 size={16} />
+                  </button>
+                </div>
+              ))}
+            </div>
+            {tasks.length < 10 && (
+              <button type="button" onClick={() => setTasks([...tasks, ''])}>
+                <Plus size={16} /> Ajouter une étape
+              </button>
+            )}
+            <label className="brain-checkbox">
+              <input
+                type="checkbox"
+                checked={validation}
+                onChange={(e) => setValidation(e.target.checked)}
+              />{' '}
+              Validation du plan par un responsable après réalisation
+            </label>
+            <div className="brain-dates">
+              <button
+                className="brain-primary"
+                disabled={
+                  !options.data ||
+                  options.isError ||
+                  !unit ||
+                  !eligible.some((m) => m.id === responsible) ||
+                  tasks.some((t) => !t.trim())
+                }
+              >
+                {conversion.isPending ? 'Création…' : 'Confirmer la création'}
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  setEditing(false)
+                  conversion.reset()
+                }}
+              >
+                Annuler
+              </button>
+            </div>
+          </fieldset>
+          {conversion.isError && <p role="alert">{conversion.error.message}</p>}
+        </form>
+      </BrainDialog>
+    </section>
+  )
+}
