+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from django.test import override_settings
+
+from houston.brain.errors import BrainResponseError
+from houston.brain.provider import analyze
+from houston.brain.tests.test_context_budget import conversation
+
+
+def response(data):
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                finish_reason="stop",
+                message=SimpleNamespace(content=json.dumps(data), refusal=None),
+            )
+        ]
+    )
+
+
+@override_settings(OPENAI_API_KEY="test-placeholder")
+def test_incomplete_review_never_reaches_final_analysis():
+    c = conversation([])
+    client = MagicMock()
+    client.__enter__.return_value = client
+    client.chat.completions.create.return_value = response(
+        {"issues": [], "coverage_complete": False}
+    )
+    with patch("openai.OpenAI", return_value=client), pytest.raises(BrainResponseError) as error:
+        analyze(c)
+    assert error.value.code == "report_review_incomplete"
+    assert client.chat.completions.create.call_count == 1
+
+
+@override_settings(OPENAI_API_KEY="test-placeholder")
+def test_structured_knowledge_is_only_sent_after_client_review_and_as_data():
+    from houston.brain.tests.test_knowledge import issue, reference
+
+    c = conversation([])
+    c.version.knowledge = reference()
+    client = MagicMock()
+    client.__enter__.return_value = client
+    client.chat.completions.create.side_effect = [
+        response({"issues": [issue()], "coverage_complete": True}),
+        response({"answer": "Réponse", "proposals": []}),
+    ]
+    with patch("openai.OpenAI", return_value=client):
+        result = analyze(c)
+    calls = client.chat.completions.create.call_args_list
+    first = calls[0].kwargs["messages"]
+    final = calls[1].kwargs["messages"]
+    assert "Vérifier les horaires" not in json.dumps(first, ensure_ascii=False)
+    assert final[1]["role"] == "user"
+    selected = json.loads(final[1]["content"])["reference_knowledge"]["mechanisms"]
+    assert selected[0]["id"] == "M1"
+    assert "INTERDIT" not in json.dumps(final)
+    assert result._retrieval_trace["selected"][0]["id"] == "M1"
+    assert "_retrieval_trace" not in result.model_dump()
+
+
+def test_installed_settings_without_input_budget_can_complete_analysis():
+    # The actual Mac baseline predates the optional input-size setting.
+    c = conversation([])
+    client = MagicMock()
+    client.__enter__.return_value = client
+    client.chat.completions.create.side_effect = [
+        response({"issues": [], "coverage_complete": True}),
+        response({"answer": "Analyse", "proposals": []}),
+    ]
+    old_settings = SimpleNamespace(
+        OPENAI_API_KEY="test-placeholder", HOUSTON_BRAIN_MODEL="test-model"
+    )
+    with (
+        patch("houston.brain.provider.settings", old_settings),
+        patch("openai.OpenAI", return_value=client),
+    ):
+        result = analyze(c)
+    assert result.answer == "Analyse"
+    assert client.chat.completions.create.call_count == 2
