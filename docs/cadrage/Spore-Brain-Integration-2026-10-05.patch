@@ -0,0 +1,90 @@
+"""Read dated objectives for the actual reporting period, scoped to one site."""
+
+from django.db.models import Exists, OuterRef
+
+from .models import ActionSuggestion, GoalReview
+from .permissions import member
+
+
+def due_goals(user, site, start, end, today):
+    from rest_framework.exceptions import ValidationError
+
+    member(user, site)
+    concluded = GoalReview.objects.filter(
+        suggestion_id=OuterRef("pk"),
+        objective_revision=OuterRef("objective_revision"),
+        outcome__in=["achieved", "not_achieved"],
+        message__conversation__establishment_id=site,
+    )
+    goals = list(
+        ActionSuggestion.objects.filter(
+            message__conversation__establishment_id=site,
+            objective_status="validated",
+            kpi_objective__review_date__gte=start.isoformat(),
+            kpi_objective__review_date__lte=min(end, today).isoformat(),
+        )
+        .exclude(kpi_objective__review_date=None)
+        .annotate(concluded=Exists(concluded))
+        .filter(
+            concluded=False,
+        )
+        .select_related("execution")
+        .order_by("kpi_objective__review_date", "id")[:21]
+    )
+    if len(goals) > 20:
+        raise ValidationError(
+            "Plus de 20 objectifs à évaluer sur cette période. Réduisez la période du reporting."
+        )
+    return [
+        {
+            "goal_id": str(goal.id),
+            "revision": goal.objective_revision,
+            "action_id": str(goal.execution_id) if goal.execution_id else None,
+            "title": goal.title,
+            "action_status": goal.execution.status if goal.execution_id else "not_created",
+            "objective": goal.kpi_objective,
+            "instruction": (
+                "Comparer la cible aux mesures du reporting de cette période. "
+                "Un plan terminé ne prouve pas un résultat."
+            ),
+        }
+        for goal in goals
+    ]
+
+
+def review_history(user, site):
+    member(user, site)
+    rows = (
+        GoalReview.objects.filter(
+            suggestion__message__conversation__establishment_id=site,
+            message__conversation__establishment_id=site,
+        )
+        .select_related("suggestion", "message__conversation")
+        .order_by("-created_at", "-id")[:50]
+    )
+    return [
+        {
+            "goal_id": str(row.suggestion_id),
+            "revision": row.objective_revision,
+            "objective": row.objective_snapshot,
+            "outcome": row.outcome,
+            "measurement": row.measurement,
+            "explanation": row.explanation,
+            "start": str(row.message.conversation.start),
+            "end": str(row.message.conversation.end),
+        }
+        for row in rows
+    ]
+
+
+def public_review(row):
+    return {
+        "id": str(row.id),
+        "goal_id": str(row.suggestion_id),
+        "objective": row.objective_snapshot,
+        "outcome": row.outcome,
+        "measurement": row.measurement,
+        "explanation": row.explanation,
+        "sources": row.sources,
+        "created_at": row.created_at,
+    }
diff --git a/apps/api/houston/brain/goal_services.py b/apps/api/houston/brain/goal_services.py
new file mode 100644
index 0000000..44ec1e2
--- /dev/null
+++ b/apps/api/houston/brain/goal_services.py
@@ -0,0 +1,165 @@
+"""Human objective decisions and durable, source-backed review results."""
+
+import re
+from zoneinfo import ZoneInfo
+
+from django.db import transaction
+from django.utils import timezone
+from pydantic import ValidationError as SchemaError
+from rest_framework.exceptions import NotFound, ValidationError
+
+from .models import ActionSuggestion, GoalReview
+from .permissions import member
+
+
+def parse_objective(objective, actor):
+    from .provider import KpiObjective
+
+    try:
+        parsed = KpiObjective.model_validate(objective)
+    except SchemaError as exc:
+        raise ValidationError("Complétez le KPI, sa cible, sa mesure et sa date de bilan.") from exc
+    today = (
+        timezone.now().astimezone(ZoneInfo(actor.establishment.timezone or "Europe/Paris")).date()
+    )
+    if not parsed.review_date or parsed.review_date < today:
+        raise ValidationError("Choisissez une date de bilan KPI à venir.")
+    return parsed.model_dump(mode="json")
+
+
+def apply_decision(suggestion, actor, status, objective):
+    # Called with the suggestion row already locked, inside a transaction.
+    if suggestion.objective_status == status and suggestion.kpi_objective == objective:
+        return suggestion
+    suggestion.kpi_objective = objective
+    suggestion.objective_status = status
+    suggestion.objective_revision += 1
+    suggestion.objective_decided_at = timezone.now()
+    suggestion.objective_decided_by = actor
+    suggestion.save(
+        update_fields=[
+            "kpi_objective",
+            "objective_status",
+            "objective_revision",
+            "objective_decided_at",
+            "objective_decided_by",
+            "updated_at",
+        ]
+    )
+    return suggestion
+
+
+@transaction.atomic
+def decide(user, site, suggestion_id, *, decision, expected_revision, objective=None):
+    actor = member(user, site)
+    suggestion = (
+        ActionSuggestion.objects.select_for_update()
+        .filter(
+            pk=suggestion_id,
+            message__conversation__establishment_id=site,
+        )
+        .first()
+    )
+    if not suggestion:
+        raise NotFound("Objectif introuvable.")
+    if decision not in ("validate", "reject") or not suggestion.kpi_objective:
+        raise ValidationError("Décision ou objectif invalide.")
+    if (
+        decision == "validate"
+        and suggestion.objective_status == "validated"
+        and (objective is None or objective == suggestion.kpi_objective)
+    ):
+        return suggestion
+    status = "validated" if decision == "validate" else "rejected"
+    value = (
+        parse_objective(objective or suggestion.kpi_objective, actor)
+        if decision == "validate"
+        else suggestion.kpi_objective
+    )
+    if suggestion.objective_status == status and suggestion.kpi_objective == value:
+        return suggestion
+    if suggestion.objective_revision != expected_revision:
+        raise ValidationError(
+            "Cet objectif a été modifié par un autre responsable. Actualisez avant de décider."
+        )
+    return apply_decision(suggestion, actor, status, value)
+
+
+def normalized(text):
+    return re.sub(r"\s+", " ", text).strip().casefold()
+
+
+def save_reviews(answer, expected, drafts, source_catalog):
+    # Inside services.run's atomic save. Only goals selected by the server can be evaluated.
+    reports = {str(r.id): r for r in answer.conversation.reports.all()}
+    supplied = {str(d.goal_id): d for d in drafts}
+    for item in expected:
+        goal = (
+            ActionSuggestion.objects.select_for_update()
+            .filter(
+                pk=item["goal_id"],
+                message__conversation__establishment_id=answer.conversation.establishment_id,
+            )
+            .first()
+        )
+        if not goal:
+            continue
+        draft = supplied.get(item["goal_id"])
+        outcome, measurement, report, excerpt, sources = "unmeasurable", "", None, "", []
+        explanation = (
+            "L’analyse ne fournit pas de mesure permettant d’évaluer cet objectif. "
+            "Le bilan reste à compléter."
+        )
+        unchanged = (
+            goal.objective_status == "validated" and goal.objective_revision == item["revision"]
+        )
+        if not unchanged:
+            explanation = (
+                "L’objectif a changé pendant l’analyse. Ce bilan ne valide pas sa nouvelle version."
+            )
+        elif draft:
+            explanation = draft.explanation
+            sources = [
+                ref
+                for ref in draft.sources
+                if ref in source_catalog
+                and source_catalog[ref]["kind"] in {"observation", "signal", "action"}
+            ]
+            candidate = reports.get(str(draft.report_id))
+            quote, value = normalized(draft.report_excerpt), normalized(draft.measurement)
+            if (
+                candidate
+                and quote
+                and quote in normalized(candidate.text)
+                and value
+                and value in quote
+            ):
+                outcome, measurement, report, excerpt = (
+                    draft.outcome,
+                    draft.measurement,
+                    candidate,
+                    draft.report_excerpt,
+                )
+                if outcome != "unmeasurable" and not sources:
+                    explanation = (
+                        "Le bilan repose sur la mesure du reporting comparée à la cible. "
+                        "Les données terrain disponibles ne permettent pas d’expliquer "
+                        "ce résultat ; ses causes restent à vérifier."
+                    )
+            elif draft.outcome != "unmeasurable":
+                explanation = (
+                    "La mesure annoncée n’a pas pu être retrouvée dans le reporting. "
+                    "L’atteinte de l’objectif reste à vérifier."
+                )
+        GoalReview.objects.create(
+            suggestion=goal,
+            message=answer,
+            objective_revision=item["revision"],
+            objective_snapshot=item["objective"],
+            outcome=outcome,
+            measurement=measurement,
+            explanation=explanation,
+            report=report,
+            report_excerpt=excerpt,
+            sources=sources,
+        )
diff --git a/apps/api/houston/brain/knowledge.py b/apps/api/houston/brain/knowledge.py
new file mode 100644
index 0000000..956b6df
--- /dev/null
+++ b/apps/api/houston/brain/knowledge.py
@@ -0,0 +1,170 @@
+"""Bounded reference retrieval. Reference cases never become tenant evidence."""
+
+import hashlib
+import json
+import re
+import unicodedata
+
+SCHEMA = "spore.knowledge.2"
+MAX_SELECTED = 6
+MAX_SELECTED_CHARS = 18000
+STOP_WORDS = set(
+    (
+        "avec dans pour une des les par sur du de la le et en au aux un est sont "
+        "qui que ce ces plus moins meme"
+    ).split()
+)
+
+
+def tokens(value):
+    text = unicodedata.normalize("NFKD", value.casefold())
+    text = "".join(c for c in text if not unicodedata.combining(c))
+    return {
+        word for word in re.findall(r"[a-z0-9]+", text) if len(word) > 2 and word not in STOP_WORDS
+    }
+
+
+def validate(knowledge):
+    if not isinstance(knowledge, dict):
+        raise ValueError("Le référentiel doit être un objet JSON.")
+    # Persisted legacy versions remain readable, but cannot be silently treated as v2.
+    if knowledge.get("schema_version") != SCHEMA:
+        return
+    entries = knowledge.get("mechanisms")
+    if not isinstance(entries, list) or len(entries) > 200:
+        raise ValueError("mechanisms doit contenir au plus 200 fiches.")
+    identifiers = set()
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError("Chaque mécanisme doit être un objet.")
+        for key in ("id", "title", "principle", "status"):
+            if not isinstance(entry.get(key), str) or not entry[key].strip():
+                raise ValueError("Champ requis dans un mécanisme : " + key)
+        if entry["id"] in identifiers:
+            raise ValueError("Identifiant de mécanisme dupliqué.")
+        identifiers.add(entry["id"])
+        retrieval = entry.get("retrieval")
+        if not isinstance(retrieval, dict):
+            raise ValueError("Chaque mécanisme doit définir retrieval.")
+        for key in ("kpis", "situations", "sectors"):
+            rows = retrieval.get(key)
+            if (
+                not isinstance(rows, list)
+                or not rows
+                or len(rows) > 30
+                or any(
+                    not isinstance(row, str) or not row.strip() or len(row) > 120 for row in rows
+                )
+            ):
+                raise ValueError("Index de recherche invalide : " + key)
+        if entry["status"] not in {
+            "candidate",
+            "expert_validated",
+            "empirically_supported",
+            "retired",
+        }:
+            raise ValueError("Statut de validation du mécanisme inconnu.")
+        if len(json.dumps(entry, ensure_ascii=False)) > 5000:
+            raise ValueError("Une fiche mécanisme dépasse 5 000 caractères.")
+    learned = knowledge.get("learned_mechanisms", [])
+    if not isinstance(learned, list) or len(learned) > 200:
+        raise ValueError("learned_mechanisms doit contenir au plus 200 fiches.")
+
+
+def select(knowledge, issues):
+    """Rank only from client-derived issues; no private answer keys in retrieval queries."""
+    validate(knowledge)
+    digest = hashlib.sha256(json.dumps(knowledge, sort_keys=True).encode()).hexdigest()
+    trace = {
+        "schema": knowledge.get("schema_version"),
+        "digest": digest,
+        "selected": [],
+        "candidate_count": 0,
+        "omitted_count": 0,
+        "case_examples_sent": 0,
+    }
+    if knowledge.get("schema_version") != SCHEMA:
+        trace["status"] = "legacy_not_selected"
+        return {"mechanisms": [], "coverage": trace}, trace
+    entries = [e for e in knowledge["mechanisms"] if e["status"] != "retired"]
+    # Existing human-approved proposals retain their established storage contract.
+    for index, item in enumerate(knowledge.get("learned_mechanisms", [])):
+        if not isinstance(item, dict) or not all(
+            isinstance(item.get(k), str) for k in ("mechanism", "conditions", "limits")
+        ):
+            continue
+        entries.append(
+            {
+                "id": f"learned-{index}",
+                "title": item["mechanism"][:120],
+                "principle": item["mechanism"],
+                "conditions": item["conditions"],
+                "limits": item["limits"],
+                "status": "expert_validated",
+                "retrieval": {
+                    "kpis": [item["mechanism"]],
+                    "situations": [item["conditions"]],
+                    "sectors": [],
+                },
+            }
+        )
+    matches = []
+    for entry in entries:
+        index = entry["retrieval"]
+        kt = tokens(" ".join(index["kpis"]))
+        st = tokens(" ".join(index["situations"]))
+        scores = []
+        for position, issue in enumerate(issues):
+            query = tokens(" ".join([issue["kpi"], issue["change"], *issue["search_terms"]]))
+            k, s = len(query & kt), len(query & st)
+            # Require both KPI and situation relevance, not one shared generic word.
+            if k and s and len(query & (kt | st)) >= 2:
+                sector = len(tokens(issue["activity"]) & tokens(" ".join(index["sectors"])))
+                scores.append((position, 3 * k + 2 * s + sector))
+        if scores:
+            matches.append((max(score for _, score in scores), entry, scores))
+    matches.sort(key=lambda row: (-row[0], row[1]["id"]))
+    trace["candidate_count"] = len(matches)
+    selected, used, covered = [], 0, set()
+    # Prefer coverage of distinct issues before filling remaining slots by score.
+    pending = list(matches)
+    while pending and len(selected) < MAX_SELECTED:
+        choice = next(
+            (i for i, row in enumerate(pending) if any(p not in covered for p, _ in row[2])), 0
+        )
+        score, entry, positions = pending.pop(choice)
+        # Explicit allow-list excludes embedded case data, customer evidence and answer keys.
+        public = {
+            k: entry[k]
+            for k in (
+                "id",
+                "title",
+                "principle",
+                "status",
+                "evidence_type",
+                "applicability",
+                "alternative_explanations",
+                "decision_pattern",
+                "measurement_pattern",
+                "do_not_infer",
+                "conditions",
+                "limits",
+            )
+            if k in entry
+        }
+        size = len(json.dumps(public, ensure_ascii=False))
+        if used + size > MAX_SELECTED_CHARS:
+            continue
+        selected.append(public)
+        used += size
+        covered.update(p for p, _ in positions)
+        trace["selected"].append(
+            {"id": entry["id"], "score": score, "issue_indexes": [p for p, _ in positions]}
+        )
+    trace.update(
+        status="selected",
+        omitted_count=len(matches) - len(selected),
+        selected_chars=used,
+        uncovered_issue_indexes=[i for i in range(len(issues)) if i not in covered],
+    )
+    return {"mechanisms": selected, "coverage": trace}, trace
