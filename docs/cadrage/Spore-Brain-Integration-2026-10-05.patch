+from datetime import date
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from rest_framework.exceptions import PermissionDenied, ValidationError
+
+from houston.brain import permissions, selectors, services
+from houston.brain.models import BrainSettings, Conversation, Mechanism, Message
+from houston.testing.factories import create_establishment, create_membership
+
+pytestmark = pytest.mark.django_db
+
+
+def setup_case():
+    site = create_establishment(name="Brain test")
+    owner = create_membership(establishment=site, role="owner")
+    owner.user.is_superuser = True
+    owner.user.save()
+    v = services.version(
+        owner.user, "Initial", {"rules": []}, "Analyser les faits et distinguer les hypothèses."
+    )
+    services.activate(owner.user, v.id)
+    c = Conversation.objects.create(
+        establishment=site,
+        membership=owner,
+        version=v,
+        title="Test",
+        start=date(2026, 9, 1),
+        end=date(2026, 9, 30),
+    )
+    return owner, v, c
+
+
+def test_version_activation_does_not_mutate_existing_conversation():
+    owner, v, c = setup_case()
+    newer = services.version(
+        owner.user, "Nouvelle", {"rules": ["new"]}, "Autre format suffisamment détaillé."
+    )
+    services.activate(owner.user, newer.id)
+    c.refresh_from_db()
+    assert c.version_id == v.id
+    assert BrainSettings.objects.get(pk=1).active_id == newer.id
+
+
+def test_client_owner_cannot_manage_global_brain():
+    owner, _, _ = setup_case()
+    owner.user.is_superuser = False
+    with pytest.raises(PermissionDenied):
+        permissions.administrator(owner.user)
+
+
+def test_conversations_are_shared_with_site_director_but_not_other_sites():
+    owner, _, c = setup_case()
+    other = create_membership(establishment=owner.establishment, role="director")
+    assert selectors.conversation(other.user, owner.establishment_id, c.id).id == c.id
+    site = create_establishment(name="Other")
+    with pytest.raises(PermissionDenied):
+        selectors.conversation(owner.user, site.id, c.id)
+
+
+def test_staff_cannot_access_brain():
+    owner, _, _ = setup_case()
+    staff = create_membership(establishment=owner.establishment, role="staff")
+    with pytest.raises(PermissionDenied):
+        permissions.member(staff.user, owner.establishment_id)
+
+
+def test_proposal_never_changes_json_without_review():
+    owner, v, c = setup_case()
+    msg = Message.objects.create(conversation=c, role="assistant", text="Une analyse")
+    p = Mechanism.objects.create(conversation=c, message=msg, proposal={"mechanism": "Hypothèse"})
+    assert BrainSettings.objects.get(pk=1).active_id == v.id
+    edited = {
+        "mechanism": "Les pauses peuvent influer sur la conversion",
+        "conditions": "À vérifier selon le public",
+        "limits": "Un seul cas",
+        "evidence": [],
+    }
+    services.review(owner.user, p.id, "approve", edited)
+    active = BrainSettings.objects.get(pk=1).active
+    assert active.id != v.id
+    assert active.knowledge["learned_mechanisms"][0]["mechanism"] == edited["mechanism"]
+    v.refresh_from_db()
+    assert v.knowledge == {"rules": []}
+    with pytest.raises(ValidationError):
+        services.review(owner.user, p.id, "approve", edited)
