index 0000000..24d2d9b
--- /dev/null
+++ b/apps/api/houston/brain/conversation_context.py
@@ -0,0 +1,36 @@
+"""Bound conversation context without duplicating every previous rendered analysis."""
+
+from django.db.models import Q
+
+MAX_RECENT_MESSAGES = 12
+MAX_HISTORY_CHARS = 20000
+
+
+def capture(conversation):
+    rows = list(
+        conversation.messages.filter(
+            Q(status="done") | Q(role="user", status__in=["queued", "running"])
+        )
+        .order_by("-created_at", "-id")
+        .values("role", "text")[: MAX_RECENT_MESSAGES + 1]
+    )
+    remaining = MAX_HISTORY_CHARS
+    selected = []
+    partial = len(rows) > MAX_RECENT_MESSAGES
+    for row in rows[:MAX_RECENT_MESSAGES]:
+        if remaining <= 0:
+            partial = True
+            break
+        text = row["text"]
+        partial = partial or len(text) > remaining
+        selected.append({"role": row["role"], "text": text[:remaining]})
+        remaining -= len(selected[-1]["text"])
+    return list(reversed(selected)), {
+        "partial": partial,
+        "messages_included": len(selected),
+        "note": (
+            "Échanges récents uniquement ; les anciennes présentations ne sont pas dupliquées. "
+            "Le terrain, les objectifs et les plans transmis séparément restent les sources. "
+            "Si une question dépend d’un échange absent, demander une précision."
+        ),
+    }
