+from datetime import date
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from django.core.files.uploadedfile import SimpleUploadedFile
+from rest_framework.exceptions import PermissionDenied, ValidationError
+from rest_framework.test import APIRequestFactory, force_authenticate
+
+from houston.brain import selectors, services
+from houston.brain.api.views import Context
+from houston.brain.models import EstablishmentContext
+from houston.brain.provider import Analysis
+from houston.brain.tests.test_services import setup_case
+from houston.testing.factories import build_membership, create_establishment, create_membership
+
+pytestmark = pytest.mark.django_db
+
+
+@pytest.mark.parametrize("role", ["owner", "director"])
+def test_context_edit_is_shared_with_site_leadership_without_global_admin(role):
+    site = create_establishment(name="Contexte local")
+    editor = create_membership(establishment=site, role=role)
+    reader = create_membership(establishment=site, role="director")
+    assert not editor.user.has_perm("brain.manage_brain")
+    services.set_establishment_context(editor.user, site.id, "Augmenter le flux en semaine")
+    assert selectors.establishment_context(reader.user, site.id)["text"] == (
+        "Augmenter le flux en semaine"
+    )
+    assert EstablishmentContext.objects.get(establishment=site).updated_by_id == editor.user_id
+
+
+@pytest.mark.parametrize("role", ["staff", "manager"])
+def test_context_read_write_denied_to_other_roles(role):
+    member = build_membership(role=role)
+    with pytest.raises(PermissionDenied):
+        selectors.establishment_context(member.user, member.establishment_id)
+    with pytest.raises(PermissionDenied):
+        services.set_establishment_context(member.user, member.establishment_id, "Profit")
+
+
+def test_context_api_rejects_foreign_sites_and_inactive_memberships():
+    owner = build_membership(role="owner")
+    foreign = create_establishment(name="Autre site")
+    factory = APIRequestFactory()
+    for site in [foreign.id, owner.establishment_id]:
+        if site == owner.establishment_id:
+            owner.status = "invited"
+            owner.save()
+        for method in ["get", "post"]:
+            request = getattr(factory, method)("/", {"text": "Flux"}, format="json")
+            force_authenticate(request, user=owner.user)
+            response = Context.as_view()(request, establishment_id=site)
+            assert response.status_code == 403
+    assert not EstablishmentContext.objects.exists()
+
+
+def test_context_is_optional_bounded_and_can_be_cleared():
+    owner = build_membership(role="owner")
+    site = owner.establishment_id
+    assert selectors.establishment_context(owner.user, site) == {"text": "", "updated_at": None}
+    services.set_establishment_context(owner.user, site, "Rentabilité")
+    with pytest.raises(ValidationError):
+        services.set_establishment_context(owner.user, site, "x" * 6001)
+    assert selectors.establishment_context(owner.user, site)["text"] == "Rentabilité"
+    services.set_establishment_context(owner.user, site, "")
+    assert selectors.establishment_context(owner.user, site)["text"] == ""
+
+
+def test_each_request_captures_context_and_worker_does_not_use_later_edits():
+    owner, version, conversation = setup_case()
+    site = owner.establishment_id
+    services.set_establishment_context(owner.user, site, "Flux")
+    with patch.object(services, "consent"):
+        services.ask(owner.user, site, conversation.id, "Que faire ?", uuid4())
+    first = conversation.messages.get(role="user")
+    services.set_establishment_context(owner.user, site, "Profit")
+    result = Analysis(answer="Réponse orientée flux", proposals=[])
+    with patch("houston.brain.provider.analyze", return_value=result) as analyze:
+        with patch.object(services, "consent"):
+            services.run(first.id)
+        assert analyze.call_args.kwargs["establishment_context"] == "Flux"
+    assert conversation.messages.get(role="assistant").context_snapshot == "Flux"
+    with patch.object(services, "consent"):
+        services.ask(owner.user, site, conversation.id, "Et maintenant ?", uuid4())
+    assert conversation.messages.filter(role="user").last().context_snapshot == "Profit"
+    first.refresh_from_db()
+    assert first.context_snapshot == "Flux"
+    version.refresh_from_db()
+    assert version.knowledge == {"rules": []}
+
+
+def test_new_reporting_captures_context_without_changing_global_prompt():
+    owner, version, _ = setup_case()
+    services.set_establishment_context(owner.user, owner.establishment_id, "Maîtriser les coûts")
+    with patch.object(selectors, "snapshot", return_value={}):
+        with patch.object(services, "consent"):
+            conversation = services.create(
+                owner.user,
+                owner.establishment_id,
+                "Bilan",
+                date(2026, 9, 1),
+                date(2026, 9, 30),
+                [SimpleUploadedFile("bilan.csv", b"CA\n1000\n")],
+            )
+    assert conversation.messages.get().context_snapshot == "Maîtriser les coûts"
+    assert conversation.version_id == version.id
