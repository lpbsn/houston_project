+def test_admin_rejects_suspended_account_and_incomplete_commands():
+    owner, _, _ = setup_case()
+    owner.user.status = "suspended"
+    from rest_framework.exceptions import PermissionDenied
+
+    with pytest.raises(PermissionDenied):
+        permissions.administrator(owner.user)
+    serializer = AdminCommandSerializer(data={"operation": "approve"})
+    assert not serializer.is_valid()
+    assert set(serializer.errors) == {"id", "edited"}
+
+
+@pytest.mark.django_db(transaction=True)
+def test_simultaneous_mechanism_review_integrates_it_once():
+    owner, _, conversation = setup_case()
+    msg = Message.objects.create(conversation=conversation, role="assistant", text="Analyse")
+    mechanism = Mechanism.objects.create(conversation=conversation, message=msg, proposal={})
+    edited = {
+        "mechanism": "Mesurer les files",
+        "conditions": "Une file",
+        "limits": "À vérifier",
+        "evidence": [],
+    }
+    barrier = Barrier(2)
+
+    def review():
+        close_old_connections()
+        try:
+            barrier.wait(timeout=10)
+            try:
+                services.review(owner.user, mechanism.id, "approve", edited)
+                return "approved"
+            except ValidationError:
+                return "already_reviewed"
+        finally:
+            connections.close_all()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        futures = [pool.submit(review) for _ in range(2)]
+        results = [future.result(timeout=30) for future in futures]
+    assert sorted(results) == ["already_reviewed", "approved"]
+    assert len(BrainSettings.objects.get(pk=1).active.knowledge["learned_mechanisms"]) == 1
