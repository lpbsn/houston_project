@@ -0,0 +1,69 @@
+"""Prepare grounded explanations and unsent verification drafts for display."""
+
+TERRAIN_KINDS = {"observation", "signal", "action"}
+
+
+def prepare_insight(item, catalog, snapshot):
+    entry = item.model_dump(mode="json")
+    entry["missing_sources"] = any(ref not in catalog for ref in entry["sources"])
+    entry["sources"] = [ref for ref in entry["sources"] if ref in catalog]
+    has_terrain = any(catalog[ref]["kind"] in TERRAIN_KINDS for ref in entry["sources"])
+    has_document = any(catalog[ref]["kind"] == "report" for ref in entry["sources"])
+    if not has_terrain and has_document:
+        # Do not erase useful document-grounded explanations merely because the
+        # client reported the operational facts in an upload instead of an app observation.
+        entry["terrain"] = "Éléments rapportés dans le document importé : " + entry["terrain"]
+        if entry["confidence"] == "observé":
+            entry["confidence"] = "hypothèse"
+    if not has_terrain and not has_document:
+        entry["terrain"] = (
+            "Les données terrain disponibles ne permettent pas d’expliquer cette évolution. "
+            "Il faudrait la vérifier auprès du responsable du pôle."
+        )
+        entry["confidence"] = "à vérifier"
+    verification = entry.get("verification")
+    if verification or (not has_terrain and not has_document):
+        verification = verification or {}
+        unit = next(
+            (
+                row
+                for row in snapshot.get("business_units", [])
+                if row["id"] == verification.get("business_unit_id")
+            ),
+            None,
+        )
+        person = next(
+            (
+                row
+                for row in snapshot.get("team", [])
+                if row["id"] == verification.get("responsible_membership_id")
+                and row.get("role") == "manager"
+                and unit
+                and unit["id"] in row["business_unit_ids"]
+            ),
+            None,
+        )
+        if not person:
+            candidates = [
+                row
+                for row in snapshot.get("team", [])
+                if row.get("role") == "manager" and unit and unit["id"] in row["business_unit_ids"]
+            ]
+            person = candidates[0] if len(candidates) == 1 else None
+        message = verification.get("message", "")
+        if not message or not person:
+            message = (
+                "Bonjour, le reporting fait ressortir ce constat : "
+                + entry["finding"]
+                + " Pouvez-vous vérifier les faits sur les créneaux concernés, "
+                "les changements réalisés et l’avancement des actions ? Merci de partager "
+                "les éléments datés qui pourraient expliquer cette évolution."
+            )
+        entry["verification"] = {
+            "business_unit_id": unit["id"] if unit else None,
+            "business_unit_name": unit["specific_name"] if unit else "Pôle à préciser",
+            "responsible_membership_id": person["id"] if person else None,
+            "responsible_name": person["name"] if person else "Responsable à désigner",
+            "message": message,
+        }
+    return entry
diff --git a/apps/api/houston/brain/extraction.py b/apps/api/houston/brain/extraction.py
new file mode 100644
index 0000000..b26efef
--- /dev/null
+++ b/apps/api/houston/brain/extraction.py
@@ -0,0 +1,130 @@
+"""Bounded local extraction. No macros, formulas or external links are executed."""
+
+import csv
+import hashlib
+import io
+import zipfile
+from pathlib import Path
+
+from rest_framework.exceptions import ValidationError
+
+MAX_BYTES = 8 * 1024 * 1024
+MAX_CHARS = 80000
+
+
+class ReportReadError(ValueError):
+    """Only controlled, client-facing messages; never a parser's raw exception."""
+
+
+def extract(upload):
+    if not 0 < upload.size <= MAX_BYTES:
+        raise ValidationError("Chaque fichier doit peser entre 1 octet et 8 Mo.")
+    raw = upload.read(MAX_BYTES + 1)
+    if len(raw) > MAX_BYTES:
+        raise ValidationError("Fichier trop volumineux.")
+    suffix = Path(upload.name).suffix.lower()
+    try:
+        if suffix == ".csv":
+            try:
+                text = raw.decode("utf-8-sig")
+            except UnicodeDecodeError as exc:
+                raise ReportReadError("Enregistrez le CSV en UTF-8 avant de l’importer.") from exc
+            if len(text) > MAX_CHARS:
+                raise ReportReadError(
+                    "Le CSV contient trop de texte. Importez un extrait pertinent."
+                )
+            # Bound lines; retain original numeric formatting.
+            for number, _ in enumerate(csv.reader(io.StringIO(text)), 1):
+                if number > 10000:
+                    raise ReportReadError("Le CSV dépasse 10 000 lignes.")
+        elif suffix == ".xlsx":
+            from openpyxl import load_workbook
+
+            with zipfile.ZipFile(io.BytesIO(raw)) as z:
+                if sum(i.file_size for i in z.infolist()) > 32 * 1024 * 1024:
+                    raise ReportReadError("Le classeur est trop volumineux une fois décompressé.")
+            book = load_workbook(io.BytesIO(raw), read_only=True, data_only=True, keep_links=False)
+            chunks = []
+            count = 0
+            chars = 0
+            has_values = False
+            try:
+                if len(book.sheetnames) > 20:
+                    raise ReportReadError("Le classeur dépasse 20 feuilles. Importez un extrait.")
+                for sheet in book:
+                    if sheet.max_column and sheet.max_column > 150:
+                        raise ReportReadError(
+                            "Une feuille dépasse 150 colonnes. Importez un extrait."
+                        )
+                    heading = "FEUILLE : " + sheet.title
+                    chunks.append(heading)
+                    chars += len(heading) + 1
+                    for number, row in enumerate(sheet.iter_rows(values_only=True), 1):
+                        count += 1
+                        if count > 10000 or len(row) > 150:
+                            raise ReportReadError(
+                                "Le classeur dépasse 10 000 lignes ou 150 colonnes."
+                            )
+                        has_values = has_values or any(
+                            v is not None and str(v).strip() for v in row
+                        )
+                        line = (
+                            str(number)
+                            + " | "
+                            + " | ".join("" if v is None else str(v) for v in row)
+                        )
+                        chunks.append(line)
+                        chars += len(line) + 1
+                        if chars > MAX_CHARS:
+                            raise ReportReadError(
+                                "Le classeur contient trop de texte. Importez un extrait."
+                            )
+            finally:
+                book.close()
+            if not has_values:
+                raise ReportReadError(
+                    "Aucune valeur lisible dans le classeur. "
+                    "Enregistrez-le après recalcul dans Excel."
+                )
+            text = (
+                "\n".join(chunks)
+                + "\nNote : valeurs Excel mises en cache ; les formules ne sont pas recalculées. "
+                "Vérifier les cellules vides."
+            )
+        elif suffix == ".pdf":
+            from pypdf import PdfReader
+
+            reader = PdfReader(io.BytesIO(raw))
+            if reader.is_encrypted or len(reader.pages) > 60:
+                raise ReportReadError("Le PDF est protégé ou dépasse 60 pages.")
+            chunks = []
+            chars = 0
+            for i, page in enumerate(reader.pages, 1):
+                value = page.extract_text() or ""
+                if not value.strip():
+                    raise ReportReadError(
+                        f"La page {i} ne contient pas de texte lisible. "
+                        "Utilisez un PDF texte ; les pages scannées nécessitent un OCR."
+                    )
+                chunk = f"PAGE {i}\n{value}"
+                chunks.append(chunk)
+                chars += len(chunk) + 1
+                if chars > MAX_CHARS:
+                    raise ReportReadError("Le PDF contient trop de texte. Importez un extrait.")
+            text = "\n".join(chunks)
+        else:
+            raise ReportReadError("Formats pris en charge : CSV UTF-8, XLSX et PDF texte.")
+        if not text.strip() or len(text) > MAX_CHARS:
+            raise ReportReadError("Le document est vide ou contient trop de texte.")
+    except ReportReadError as exc:
+        raise ValidationError(str(exc)) from exc
+    except Exception as exc:
+        raise ValidationError(
+            "Lecture impossible : utilisez un CSV UTF-8, un XLSX ou un PDF texte de "
+            "taille raisonnable. Les PDF scannés nécessitent un OCR."
+        ) from exc
+    return {
+        "name": Path(upload.name).name[:200],
+        "digest": hashlib.sha256(raw).hexdigest(),
+        "text": text,
+    }
