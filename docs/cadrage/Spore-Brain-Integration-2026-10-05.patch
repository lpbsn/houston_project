index 0000000..e91e939
--- /dev/null
+++ b/apps/api/houston/brain/tests/test_response_format.py
@@ -0,0 +1,153 @@
+import json
+from copy import deepcopy
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from django.test import override_settings
+
+from houston.brain import provider, selectors, services
+from houston.brain.models import Message
+from houston.brain.tests.test_presentation import analysis
+from houston.brain.tests.test_services import setup_case
+
+
+def response(data, *, finish="stop", refusal=None):
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                finish_reason=finish,
+                message=SimpleNamespace(
+                    content=json.dumps(data, ensure_ascii=False), refusal=refusal
+                ),
+            )
+        ]
+    )
+
+
+def valid_payload():
+    return analysis("source").model_dump(mode="json")
+
+
+def client_for(*responses):
+    client = MagicMock()
+    client.__enter__.return_value = client
+    client.chat.completions.create.side_effect = responses
+    return client
+
+
+def test_wire_schema_requires_confidence_without_a_default_or_freeform_fallback():
+    client = client_for(response(valid_payload()))
+    provider.validated_completion(client, [{"role": "user", "content": "Analyse"}])
+    wire = client.chat.completions.create.call_args.kwargs["response_format"]
+    assert wire["type"] == "json_schema"
+    assert wire["json_schema"]["strict"] is True
+    schema = wire["json_schema"]["schema"]
+    insight = schema["$defs"]["Insight"]
+    assert "confidence" in insight["required"]
+    assert insight["properties"]["confidence"]["enum"] == ["observé", "hypothèse", "à vérifier"]
+    for node in [schema, *schema["$defs"].values()]:
+        assert set(node["required"]) == set(node["properties"])
+        assert node["additionalProperties"] is False
+    assert '"default"' not in json.dumps(schema)
+    assert client.chat.completions.create.call_count == 1
+
+
+def test_missing_confidence_is_corrected_by_provider_not_invented_locally():
+    invalid = valid_payload()
+    del invalid["insights"][0]["confidence"]
+    corrected = valid_payload()
+    corrected["insights"][0]["confidence"] = "à vérifier"
+    client = client_for(response(invalid), response(corrected))
+    result = provider.validated_completion(client, [])
+    assert result.insights[0].confidence == "à vérifier"
+    assert client.chat.completions.create.call_count == 2
+    correction = client.chat.completions.create.call_args.kwargs["messages"][-1]["content"]
+    assert "confidence" in correction and "missing" in correction
+    assert invalid["insights"][0]["terrain"] not in correction
+
+
+@pytest.mark.parametrize("kind", ["missing", "enum", "length", "link"])
+def test_two_invalid_results_stop_without_relaxing_validation(kind):
+    data = valid_payload()
+    if kind == "missing":
+        del data["insights"][0]["confidence"]
+    elif kind == "enum":
+        data["insights"][0]["confidence"] = "certain"
+    elif kind == "length":
+        data["answer"] = "x" * 1401
+    else:
+        data["insights"][0]["action_indexes"] = [4]
+    client = client_for(response(data), response(data))
+    with pytest.raises(provider.BrainResponseError) as error:
+        provider.validated_completion(client, [])
+    assert error.value.code == "invalid_response_format"
+    assert client.chat.completions.create.call_count == 2
+
+
+@pytest.mark.parametrize(
+    "finish,refusal,code",
+    [
+        ("length", None, "incomplete_response"),
+        ("content_filter", None, "response_refused"),
+        ("stop", "Not available", "response_refused"),
+    ],
+)
+def test_interrupted_or_refused_responses_are_not_parsed_or_retried(finish, refusal, code):
+    client = client_for(response(valid_payload(), finish=finish, refusal=refusal))
+    with pytest.raises(provider.BrainResponseError) as error:
+        provider.validated_completion(client, [])
+    assert error.value.code == code
+    assert client.chat.completions.create.call_count == 1
+
+
+def test_correction_budget_does_not_overrun_celery_soft_limit():
+    invalid = valid_payload()
+    del invalid["insights"][0]["confidence"]
+    client = client_for(response(invalid))
+    with patch.object(provider.time, "monotonic", side_effect=[0, 0, 111]):
+        with pytest.raises(provider.BrainResponseError) as error:
+            provider.validated_completion(client, [], budget_seconds=120)
+    assert error.value.code == "response_timeout"
+    assert client.chat.completions.create.call_count == 1
+
+
+@pytest.mark.django_db
+@override_settings(OPENAI_API_KEY="not-a-real-key")
+@pytest.mark.parametrize("recovers", [True, False])
+def test_full_service_saves_only_valid_results_and_explains_format_failure(recovers, caplog):
+    owner, _, conversation = setup_case()
+    question = Message.objects.create(
+        conversation=conversation,
+        role="user",
+        author=owner,
+        text="Analyse",
+        status="queued",
+    )
+    invalid = valid_payload()
+    del invalid["insights"][0]["confidence"]
+    invalid["answer"] = "PRIVATE-CUSTOMER-CONTENT"
+    final = valid_payload() if recovers else deepcopy(invalid)
+    client = client_for(
+        response({"issues": [], "coverage_complete": True}), response(invalid), response(final)
+    )
+    with patch("openai.OpenAI", return_value=client), patch.object(services, "consent"):
+        services.run(question.id)
+    conversation.refresh_from_db()
+    question.refresh_from_db()
+    assert client.chat.completions.create.call_count == 3
+    if recovers:
+        assert conversation.status == "ready"
+        assert question.status == "done"
+        answer = selectors.public(conversation)["messages"][-1]
+        assert answer["insights"][0]["confidence"] == "à vérifier"
+        assert len(answer["action_suggestions"]) == 1
+        assert answer["action_suggestions"][0]["execution"] is None
+    else:
+        assert conversation.status == "failed"
+        assert question.status == "failed"
+        assert "deux tentatives" in conversation.error
+        assert not conversation.messages.filter(role="assistant").exists()
+        assert "invalid_response_format" in caplog.text
+    assert "PRIVATE-CUSTOMER-CONTENT" not in caplog.text
+    assert "not-a-real-key" not in caplog.text
