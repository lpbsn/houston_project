+++ b/apps/api/houston/brain/action_services.py
@@ -0,0 +1,145 @@
+from datetime import datetime, time
+from zoneinfo import ZoneInfo
+
+from django.db import transaction
+from django.utils import timezone
+from rest_framework.exceptions import NotFound, PermissionDenied, ValidationError
+
+from houston.action_plans.exceptions import ActionPlanPermissionError, ActionPlanServiceError
+from houston.action_plans.services import create_action_plan_with_execution
+from houston.establishments.models import EstablishmentMembership
+from houston.establishments.permissions import is_valid_membership
+
+from .models import ActionSuggestion
+from .permissions import member
+
+
+@transaction.atomic
+def convert(
+    user,
+    site,
+    suggestion_id,
+    *,
+    title,
+    description,
+    tasks,
+    pilot_business_unit_id,
+    responsible_membership_id,
+    deadline,
+    requires_validation=True,
+    kpi_objective=None,
+):
+    actor = member(user, site)
+    suggestion = (
+        ActionSuggestion.objects.select_for_update(of=("self",))
+        .filter(pk=suggestion_id, message__conversation__establishment_id=site)
+        .first()
+    )
+    if not suggestion:
+        raise NotFound("Proposition introuvable.")
+    if suggestion.execution_id:
+        return suggestion
+    if suggestion.converted_at:
+        raise ValidationError("Le plan lié a été supprimé. Cette proposition a déjà été utilisée.")
+    responsible = (
+        EstablishmentMembership.objects.select_related("user", "establishment__organization")
+        .filter(pk=responsible_membership_id, establishment_id=site)
+        .first()
+    )
+    if not is_valid_membership(responsible):
+        raise ValidationError("Choisissez un responsable actif de cet établissement.")
+    zone = ZoneInfo(actor.establishment.timezone or "Europe/Paris")
+    if deadline < timezone.now().astimezone(zone).date():
+        raise ValidationError("L’échéance ne peut pas être dans le passé.")
+    if not 1 <= len(tasks) <= 10 or any(not t.strip() or len(t) > 500 for t in tasks):
+        raise ValidationError("Prévoyez entre 1 et 10 étapes, de 500 caractères maximum.")
+    objective = kpi_objective if kpi_objective is not None else suggestion.kpi_objective
+    if suggestion.objective_status == "rejected":
+        if kpi_objective is not None:
+            raise ValidationError("Cet objectif a été refusé. Actualisez avant de créer le plan.")
+        objective = None
+    if objective:
+        from pydantic import ValidationError as SchemaError
+
+        from .provider import KpiObjective
+
+        try:
+            parsed = KpiObjective.model_validate(objective)
+            if suggestion.kpi_objective.get("review_date") and not parsed.review_date:
+                raise ValidationError("Conservez une date de bilan pour cet objectif KPI.")
+            if (
+                suggestion.objective_status != "validated"
+                and parsed.review_date
+                and parsed.review_date < timezone.now().astimezone(zone).date()
+            ):
+                raise ValidationError("Choisissez une date de bilan KPI à venir.")
+            objective = parsed.model_dump(mode="json")
+        except SchemaError as exc:
+            raise ValidationError(
+                "Complétez l’objectif KPI, sa base, sa cible et sa mesure."
+            ) from exc
+        if suggestion.objective_status == "validated" and objective != suggestion.kpi_objective:
+            raise ValidationError(
+                "L’objectif a été validé séparément. Modifiez-le dans le bloc Objectif daté "
+                "avant de créer le plan."
+            )
+    if objective:
+        description = description.rstrip() + (
+            "\n\nObjectif d’impact KPI confirmé à la création du plan : "
+            + objective["name"]
+            + "\nBase : "
+            + objective["baseline"]
+            + "\nCible visée : "
+            + objective["target"]
+            + "\nHorizon : "
+            + objective["horizon"]
+            + "\nMesure : "
+            + objective["measurement"]
+            + (
+                "\nDate du bilan KPI : " + objective["review_date"]
+                if objective.get("review_date")
+                else ""
+            )
+        )
+    if len(description) > 2000:
+        raise ValidationError("Description et objectif KPI : 2 000 caractères au total maximum.")
+    end_at = datetime.combine(deadline, time(23, 59), zone)
+    try:
+        _, execution = create_action_plan_with_execution(
+            establishment_id=site,
+            created_by=actor,
+            pilot_business_unit_id=pilot_business_unit_id,
+            title=title,
+            description=description,
+            requires_validation=requires_validation,
+            tasks=[
+                {
+                    "task": task,
+                    "position": i,
+                    "business_unit_id": pilot_business_unit_id,
+                    "assigned_membership_id": responsible.id,
+                }
+                for i, task in enumerate(tasks, 1)
+            ],
+            assignees=[
+                {"membership_id": responsible.id, "business_unit_id": pilot_business_unit_id}
+            ],
+            use_shared_chronology=True,
+            start_at=timezone.now(),
+            end_at=end_at,
+        )
+    except ActionPlanPermissionError as exc:
+        raise PermissionDenied("Vous ne pouvez pas créer ce plan pour le pôle choisi.") from exc
+    except ActionPlanServiceError as exc:
+        raise ValidationError(
+            "Vérifiez le pôle, le responsable, les étapes et l’échéance du plan."
+        ) from exc
+    if objective:
+        from .goal_services import apply_decision
+
+        apply_decision(suggestion, actor, "validated", objective)
+    suggestion.execution = execution
+    suggestion.converted_by = actor
+    suggestion.converted_at = timezone.now()
+    suggestion.save(update_fields=["execution", "converted_by", "converted_at", "updated_at"])
+    return suggestion
