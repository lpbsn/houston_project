+        snapshot = selectors.snapshot(owner, date(2026, 9, 1), date(2026, 9, 30))
+    assert snapshot["period"]["timezone"] == "America/New_York"
+    assert str(query.call_args.kwargs["submitted_at__gte"].tzinfo) == "America/New_York"
