# Houston prod-test V1 environment contract
# Copy values into Railway service variables (api-web, celery-worker, celery-beat).
# Do NOT commit real secrets. See docs/deploy/railway_architecture.md for per-service mapping.
#
# Local dev uses .env.example — this file is prod-test only.

# --- Django security (manual + secrets) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<generate>
DJANGO_ALLOWED_HOSTS=<railway-domain>
HOUSTON_CLIENT_ORIGINS=https://<railway-domain>,capacitor://localhost,https://localhost
HOUSTON_ENABLE_API_DOCS=0
# Local prod-test only (docker-compose.prod-test.yml): allow HTTP localhost CSRF and local-only hosts.
# Do NOT set these on Railway or any public prod-test deployment.
# HOUSTON_ALLOW_INSECURE_LOCAL_CSRF_ORIGINS=1
# HOUSTON_ALLOW_LOCAL_ALLOWED_HOSTS=1

# --- PostgreSQL (Railway-generated → map to these names) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# --- Redis (Railway-generated → map to these names; private network only) ---
# Typical split on one Redis instance: /0 Channels, /1 Celery broker, /2 Celery results, /3 cache/throttle
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
HOUSTON_CACHE_REDIS_URL=

# --- OpenAI (secret; backend-only; never VITE_*) ---
OPENAI_API_KEY=

# --- AI providers (prod-test: openai only; fake is forbidden) ---
HOUSTON_AI_OBSERVATION_PROVIDER=openai
HOUSTON_AI_TRANSCRIPTION_PROVIDER=openai

# --- Private media (backend-only; same S3 settings on api-web + celery-worker) ---
# Prod-test uses S3. HOUSTON_PRIVATE_MEDIA_ROOT is not media truth when backend=s3
# (still used for local filesystem and deploy-check when backend=filesystem).
HOUSTON_PRIVATE_MEDIA_BACKEND=s3
HOUSTON_PRIVATE_MEDIA_ROOT=/app/apps/api/private_media
HOUSTON_S3_ENDPOINT_URL=<s3-endpoint>
HOUSTON_S3_BUCKET=<bucket>
HOUSTON_S3_ACCESS_KEY_ID=<access-key-id>
HOUSTON_S3_SECRET_ACCESS_KEY=<secret-access-key>
HOUSTON_S3_REGION=<region>
HOUSTON_S3_ADDRESSING_STYLE=path
# Chat attachments — reference Railway bucket chat-attachement (not HOUSTON_S3_*).
HOUSTON_CHAT_S3_ENDPOINT_URL=${{chat-attachement.ENDPOINT}}
HOUSTON_CHAT_S3_BUCKET=${{chat-attachement.BUCKET}}
HOUSTON_CHAT_S3_ACCESS_KEY_ID=${{chat-attachement.ACCESS_KEY_ID}}
HOUSTON_CHAT_S3_SECRET_ACCESS_KEY=${{chat-attachement.SECRET_ACCESS_KEY}}
HOUSTON_CHAT_S3_REGION=${{chat-attachement.REGION}}
HOUSTON_CHAT_S3_ADDRESSING_STYLE=virtual
HOUSTON_CHAT_MESSAGE_RETENTION_DAYS=30
# Action-plan comment attachments — dedicated Railway bucket (not HOUSTON_S3_* / chat).
HOUSTON_ACTION_PLAN_S3_ENDPOINT_URL=${{action-plan-attachments.ENDPOINT}}
HOUSTON_ACTION_PLAN_S3_BUCKET=${{action-plan-attachments.BUCKET}}
HOUSTON_ACTION_PLAN_S3_ACCESS_KEY_ID=${{action-plan-attachments.ACCESS_KEY_ID}}
HOUSTON_ACTION_PLAN_S3_SECRET_ACCESS_KEY=${{action-plan-attachments.SECRET_ACCESS_KEY}}
HOUSTON_ACTION_PLAN_S3_REGION=${{action-plan-attachments.REGION}}
HOUSTON_ACTION_PLAN_S3_ADDRESSING_STYLE=virtual
HOUSTON_ACTION_PLAN_COMMENT_RETENTION_DAYS=30

# --- Auth token / WebSocket ticket salts (secrets; generate unique values per environment) ---
HOUSTON_AUTH_TOKEN_PEPPER=<generate>
HOUSTON_AUTH_TOKEN_SALT=<generate>
HOUSTON_CHAT_WS_TICKET_SALT=<generate>
HOUSTON_REALTIME_WS_TICKET_SALT=<generate>

# --- Native FCM push (server-only JSON; never VITE_*) ---
HOUSTON_PUSH_ENABLED=0
HOUSTON_FCM_SERVICE_ACCOUNT_JSON=
HOUSTON_ANDROID_MIN_SUPPORTED_VERSION_CODE=0

# --- Frontend (prod-test same-origin note) ---
# Same-origin prod-test leaves VITE_API_BASE_URL empty (getApiBaseUrl() → ''); no API secret belongs in VITE_*.
# Do not add VITE_* variables for API URLs or secrets in prod-test.
