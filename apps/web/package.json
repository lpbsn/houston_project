{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "VITE_APP_RUNTIME=native vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && VITE_APP_RUNTIME=web vite build && node scripts/validate-web-build.mjs",
    "build:bundle": "VITE_APP_RUNTIME=web vite build && node scripts/validate-web-build.mjs",
    "build:native": "tsc -b && VITE_APP_RUNTIME=native vite build && node scripts/validate-native-build.mjs",
    "build:native:bundle": "VITE_APP_RUNTIME=native vite build && node scripts/validate-native-build.mjs",
    "build:landing": "vite build --config vite.landing.config.ts && node scripts/validate-landing-build.mjs",
    "api:generate": "openapi-typescript ../api/schema.yml -o src/api/generated/types.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build:native && npx cap sync && node scripts/ios-spm-symlinks.mjs",
    "cap:sync:bundle": "npm run build:native:bundle && npx cap sync && node scripts/ios-spm-symlinks.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "volta": {
    "node": "24.15.0",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.14.6": true
  }
}
