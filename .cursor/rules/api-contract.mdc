---
description: Preserve Spore external contract semantics when changing API-facing code or published contracts.
globs:
  - "apps/api/**/api/**/*.py"
  - "apps/api/schema.yml"
  - "apps/web/src/api/**"
  - "contracts/**"
alwaysApply: false
